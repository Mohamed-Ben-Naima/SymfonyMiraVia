<style>
/* Sidebar styling */
.sidebar {
    width: 280px; 
    background-color: #ffffff; /* White background */
    position: fixed;
    color: #013A71; /* Text color */
}

.sidebar .nav-link {
    color: #013A71; /* Text color for links */
    padding: 10px;
    font-size: 16px;
    transition: all 0.3s ease;
    display: block; /* Ensure the link takes the full width of the sidebar */
    width: 100%; /* Full width */
    text-decoration: none; /* Remove underline */
}

.sidebar .nav-link.active {
    background-color: #81A8C5; /* Slightly darker background for active link */
    color: #ffffff; /* Retain text color for active link */
    font-weight: bold;
}

.sidebar .nav-link:hover {
    background-color: #81A8C5; /* Hover effect background */
    color: #ffffff; /* Change text color on hover */
    transform: translateX(0); /* Remove or limit the animation */
    width: 100%; /* Ensure hover covers the full width */
}

.sidebar .nav-pills .collapse .nav-link {
    padding-left: 30px;
    font-size: 14px;
}

.sidebar .nav-pills .collapse .nav-link:hover {
    background-color: #81A8C5; /* Hover effect for submenu links */
    color: #ffffff; /* Change text color on hover */
    width: 100%; /* Ensure hover covers the full width */
}

/* Icons styling */
.sidebar .nav-link i {
    font-size: 18px;
}

/* Submenu collapse animation */
.collapse {
    transition: height 0.3s ease;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Sélectionnez tous les liens de la barre latérale
    const navLinks = document.querySelectorAll('.sidebar .nav-link');

    navLinks.forEach(link => {
        link.addEventListener('click', () => {
            // Supprimez la classe active de tous les liens
            navLinks.forEach(nav => nav.classList.remove('active'));

            // Ajoutez la classe active au lien cliqué
            link.classList.add('active');
        });
    });

    // Marquer le lien actif en fonction de l'URL actuelle
    const currentUrl = window.location.href;
    navLinks.forEach(link => {
        if (link.href === currentUrl) {
            link.classList.add('active');
        }
    });
});

// Update navbar title with translated text
function updateNavbarTitle(event) {
    const link = event.currentTarget;
    const translateKey = link.getAttribute('data-translate-key');
    const language = localStorage.getItem('language') || 'fr';
    const navbarTitle = document.querySelector('#navbar-title'); // Adjust selector based on your navbar
    if (navbarTitle && translateKey && translations[language][translateKey]) {
        navbarTitle.textContent = translations[language][translateKey];
    }
}
</script>