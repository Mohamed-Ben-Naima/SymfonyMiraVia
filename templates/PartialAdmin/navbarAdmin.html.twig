<link rel="stylesheet" href="{{ asset('styles/partials/navbar.css') }}">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<style>
.navbar {
    background-color: #ffffff;
    transition: background-color 0.3s ease;
}

body.dark-mode .navbar {
    background-color: #2d3748;
}

.logo-img {
    padding-top: 10px;
    padding-left: 20px;
    width: 150px;
    height: 50px;
    cursor: pointer;
}

.navbar-text h4 {
    color: #013A71;
    margin-left: 100px;
    transition: color 0.3s ease;
}

body.dark-mode .navbar-text h4 {
    color: #e2e8f0;
}

.notification-icon {
    position: relative;
    color: #013A71;
    font-size: 24px;
    margin-left: 20px;
    cursor: pointer;
    transition: color 0.3s ease, transform 0.2s ease;
}

body.dark-mode .notification-icon {
    color: #e2e8f0;
}

.notification-icon:hover {
    color: #0056b3;
    transform: scale(1.1);
}

body.dark-mode .notification-icon:hover {
    color: #4a90e2;
}

.notification-icon .badge {
    position: absolute;
    top: -5px;
    right: -5px;
    background-color: red;
    color: white;
    font-size: 12px;
    border-radius: 50%;
    padding: 2px 6px;
    transition: background-color 0.3s ease;
}

body.dark-mode .notification-icon .badge {
    background-color: #e53e3e;
}

.notification-box {
    position: fixed;
    top: 70px;
    right: 20px;
    width: 350px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(204, 204, 204, 0.3);
    border-radius: 10px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    padding: 15px;
    display: none;
    animation: slide-down 0.3s ease-in-out;
    z-index: 9999;
    transition: background-color 0.3s ease, border-color 0.3s ease;
}

body.dark-mode .notification-box {
    background: rgba(45, 55, 72, 0.95);
    border-color: rgba(113, 128, 150, 0.3);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.4);
}

.notification-box .notification-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.notification-box .notification-title {
    font-weight: 600;
    font-size: 16px;
    color: #013A71;
    transition: color 0.3s ease;
}

body.dark-mode .notification-box .notification-title {
    color: #e2e8f0;
}

.notification-box .close-button {
    background: none;
    border: none;
    color: #013A71;
    font-size: 16px;
    cursor: pointer;
    transition: color 0.3s ease, transform 0.2s ease;
}

body.dark-mode .notification-box .close-button {
    color: #e2e8f0;
}

.notification-box .close-button:hover {
    color: #0056b3;
    transform: scale(1.2);
}

body.dark-mode .notification-box .close-button:hover {
    color: #4a90e2;
}

.notification-list {
    max-height: 400px;
    overflow-y: auto;
}

.notification-box .notification-item {
    padding: 12px;
    border-bottom: 1px solid rgba(241, 241, 241, 0.5);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    border-radius: 8px;
    transition: background-color 0.3s ease, transform 0.2s ease;
}

body.dark-mode .notification-box .notification-item {
    border-bottom: 1px solid rgba(74, 85, 104, 0.5);
}

.notification-box .notification-item:last-child {
    border-bottom: none;
}

.notification-box .notification-item:hover {
    background-color: rgba(249, 249, 249, 0.7);
    transform: translateY(-2px);
}

body.dark-mode .notification-box .notification-item:hover {
    background-color: rgba(74, 85, 104, 0.7);
}

.notification-box .notification-item i {
    color: #013A71;
    font-size: 20px;
    margin-right: 10px;
    transition: color 0.3s ease, transform 0.2s ease;
}

body.dark-mode .notification-box .notification-item i {
    color: #4a90e2;
}

.notification-box .notification-item i:hover {
    transform: scale(1.2);
}

.notification-details {
    font-size: 12px;
    color: #666;
    margin-top: 4px;
    transition: color 0.3s ease;
}

body.dark-mode .notification-details {
    color: #a0aec0;
}

.notification-details strong {
    color: #333;
    transition: color 0.3s ease;
}

body.dark-mode .notification-details strong {
    color: #e2e8f0;
}

.notification-time {
    font-size: 12px;
    color: #28a745;
    margin-top: 4px;
    transition: color 0.3s ease;
}

body.dark-mode .notification-time {
    color: #68d391;
}

.profile-container {
    display: flex;
    align-items: center;
    margin-left: 20px;
    margin-right: 20px;
}

.profile-sphere {
    width: 40px;
    height: 40px;
    background-color: #ccc;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #013A71;
    margin-right: 10px;
    transition: background-color 0.3s ease, color 0.3s ease;
}

body.dark-mode .profile-sphere {
    background-color: #4a5568;
    color: #e2e8f0;
}

.profile-sphere:hover {
    background-color: #aaa;
}

body.dark-mode .profile-sphere:hover {
    background-color: #718096;
}

.user-name {
    font-size: 18px;
    color: #013A71;
    transition: color 0.3s ease;
}

body.dark-mode .user-name {
    color: #e2e8f0;
}

.toggle-dark-mode {
    background-color: #013A71;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 14px;
    margin-left: 20px;
    transition: background-color 0.3s ease;
}

body.dark-mode .toggle-dark-mode {
    background-color: #4a90e2;
}

.toggle-dark-mode:hover {
    background-color: #0056b3;
}

body.dark-mode .toggle-dark-mode:hover {
    background-color: #357abd;
}

@keyframes slide-down {
    from {
        transform: translateY(-20px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@media (max-width: 992px) {
    .navbar-text h4 {
        margin-left: 0;
        text-align: center;
    }

    .notification-icon,
    .profile-container,
    .toggle-dark-mode {
        margin-left: 10px;
    }
}
</style>

<nav class="navbar navbar-expand-lg navbar-light custom-navbar">
    <div class="container-fluid">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center custom-logo" onclick="toggleSidebar()">
            <img src="{{ asset('images/logo.png') }}" alt="Logo" class="me-2 logo-img">
        </a>
        <div class="navbar-text ms-auto me-auto">
            <h4 class="mb-0">{{ pageTitle|default('Titre par défaut') }}</h4>
        </div>

        <!-- Burger Menu for Mobile -->
        <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Collapsible Content -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="ms-auto d-flex align-items-center">
                <!-- Notification Icon -->
                <div class="notification-icon" onclick="toggleNotificationBox()">
                    <i class="bi bi-bell"></i>
                    {% if notifications|length > 0 %}
                        <span class="badge">{{ notifications|length }}</span>
                    {% endif %}
                </div>

                <!-- Notification Box -->
                <div class="notification-box" id="notificationBox">
                    <div class="notification-header">
                        <div class="notification-title" data-translate="notifications">Notifications</div>
                        <button class="close-button" onclick="closeNotificationBox()">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                    <div class="notification-list">
                        {% for notif in notifications %}
                            <div class="notification-item">
                                <div>
                                    <i class="bi {{ notif.icon }}"></i>
                                    {{ notif.message }}
                                </div>
                                <div class="notification-details">
                                    <span data-translate="sent_by">Envoyé par</span> <strong>{{ notif.sender }}</strong>
                                </div>
                                <div class="notification-time">{{ notif.time }}</div>
                            </div>
                        {% else %}
                            <div class="notification-item text-muted">Aucune notification</div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Profile Section -->
                <div class="profile-container">
                    <a href="{{ path('app_admin_profil') }}" class="profile-sphere">
                        <i class="bi bi-person"></i>
                    </a>
                    <a href="{{ path('app_admin_profil') }}" class="user-name">{{ user.nom }} {{ user.prenom }}</a>
                </div>

            </div>
        </div>
    </div>
</nav>

<!-- Audio for Notifications -->
<audio id="notificationSound" src="{{ asset('sounds/notification.mp3') }}" preload="auto"></audio>

<script>
let lastNotificationCount = {{ notifications|length }};

function toggleDarkMode() {
    document.body.classList.toggle('dark-mode');
    localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
    console.log('Dark mode toggled');
}

function toggleNotificationBox() {
    const notificationBox = document.getElementById('notificationBox');
    if (notificationBox.style.display === 'none' || !notificationBox.style.display) {
        notificationBox.style.display = 'block';
        // Play sound if there are new notifications
        const currentCount = {{ notifications|length }};
        if (currentCount > lastNotificationCount) {
            playNotificationSound();
            lastNotificationCount = currentCount;
        }
        console.log('Notification box opened');
    } else {
        notificationBox.style.display = 'none';
        console.log('Notification box closed');
    }
}

function closeNotificationBox() {
    const notificationBox = document.getElementById('notificationBox');
    notificationBox.style.display = 'none';
    console.log('Notification box closed via close button');
}

function toggleSidebar() {
    const sidebar = document.getElementById('sidebarMenu');
    if (sidebar) {
        sidebar.classList.toggle('show');
        console.log('Sidebar toggled');
    }
}

function playNotificationSound() {
    const sound = document.getElementById('notificationSound');
    if (sound) {
        console.log('Attempting to play notification sound');
        sound.play().catch(error => console.error('Error playing sound:', error));
    } else {
        console.error('Notification sound element not found');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    // Apply dark mode if previously selected
    if (localStorage.getItem('darkMode') === 'true') {
        document.body.classList.add('dark-mode');
        console.log('Dark mode applied from localStorage');
    }

    // Expose functions globally
    window.toggleNotificationBox = toggleNotificationBox;
    window.closeNotificationBox = closeNotificationBox;
    window.toggleDarkMode = toggleDarkMode;
    window.toggleSidebar = toggleSidebar;

    // Hide notification box when clicking outside
    document.addEventListener('click', function(event) {
        const notificationBox = document.getElementById('notificationBox');
        const notificationIcon = document.querySelector('.notification-icon');
        const closeButton = document.querySelector('.notification-box .close-button');
        if (!notificationBox.contains(event.target) && !notificationIcon.contains(event.target) && !closeButton.contains(event.target)) {
            notificationBox.style.display = 'none';
            console.log('Notification box closed by clicking outside');
        }
    });

    // Check for new notifications periodically
    function checkNotifications() {
        fetch('{{ path('admin_notification_count') }}')
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
            .then(data => {
                const newNotificationCount = data.count || 0;
                console.log('Fetched notification count:', newNotificationCount);
                if (newNotificationCount > lastNotificationCount) {
                    playNotificationSound();
                    lastNotificationCount = newNotificationCount;
                }
            })
            .catch(error => console.error('Error fetching notification count:', error));
    }

    // Initial check and set interval
    checkNotifications();
    setInterval(checkNotifications, 10000); // Check every 10 seconds

    console.log('Navbar script loaded');
});
</script>