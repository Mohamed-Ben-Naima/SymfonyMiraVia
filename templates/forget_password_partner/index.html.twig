{% block stylesheets %}
<link href="{{ asset('style-partner/bootstrap.min.css') }}" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('style-partner/style.css') }}">
<style>
    /* Global Styling */
    body {
        margin: 0;
        padding: 0;
        font-family: 'Roboto', sans-serif;
        background: linear-gradient(to bottom, #87CEEB, #f0f9ff); /* Sky gradient with sunlight effect */
        overflow: hidden;
        color: #333;
    }

    .background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
    }

    .background .realistic-cloud {
        position: absolute;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.6));
        filter: blur(15px);
        border-radius: 60% 40% 60% 40%;
        animation: cloud-move 40s linear infinite;
    }

    /* Trajectories */
    .background .trajectory {
        position: absolute;
        width: 200%;
        height: 400px;
        background: none;
        border-top: 2px dashed rgba(1, 58, 113, 0.4); /* Dashed semi-transparent blue line */
        border-radius: 50%;
        animation: trajectory-animation 8s infinite ease-in-out;
    }

    .background .trajectory:nth-child(3) {
        top: 12%;
        left: -60%;
        animation-duration: 6s;
    }

    .background .trajectory:nth-child(4) {
        top: 35%;
        left: -70%;
        animation-duration: 9s;
    }

    .background .trajectory:nth-child(5) {
        top: 55%;
        left: -80%;
        animation-duration: 7s;
    }

    @keyframes cloud-move {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(150%);
        }
    }

    @keyframes trajectory-animation {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(50%);
        }
    }

    .form-container {
        display: flex;
        max-width: 900px;
        width: 100%;
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .form-image {
        flex: 1;
        background-image: url('{{ asset('images-partner/airplane.jpg') }}');
        background-size: cover;
        background-position: center;
    }

    .form-content {
        flex: 1;
        padding: 2rem;
        background: #fafdff;
    }

    .form-content h2 {
        color: #013a71;
        font-weight: bold;
    }

    .form-content img.logo {
        max-width: 120px;
        margin: 0 auto 20px;
        display: block;
    }

    .form-label {
        font-weight: bold;
        color: #013a71;
    }

    .form-control {
        border-radius: 10px;
        border: 2px solid #81a8c5;
        background: #ffffff;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #013a71;
        box-shadow: 0 0 10px rgba(1, 58, 113, 0.3);
    }

    .btn {
        border-radius: 10px;
        font-weight: bold;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-primary {
        background: #013a71;
        border: none;
        color: white;
    }

    .btn-primary:hover {
        background: #012a51;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(1, 58, 113, 0.3);
    }

    @media (max-width: 768px) {
        .form-container {
            flex-direction: column;
        }

        .form-image {
            height: 200px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="background">
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>

    <!-- Trajectories -->
    <div class="trajectory"></div>
    <div class="trajectory"></div>
    <div class="trajectory"></div>
</div>

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="form-container shadow-lg">
        <!-- Side Image -->
        <div class="form-image"></div>

        <!-- Reset Password Form -->
        <div class="form-content">
            <div class="text-center mb-4">
                <img src="{{ asset('images-partner/logo miravia 1 3.png') }}" alt="logo" class="logo">
                <h2 class="mt-3">Réinitialiser le mot de passe</h2>
                <p>Entrez votre adresse email pour recevoir un lien de réinitialisation.</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="mb-3">
                {{ form_label(form.email, 'Adresse Email', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'required': 'required', 'placeholder': 'email@example.com'}}) }}
                {{ form_errors(form.email) }}
            </div>
            {{ form_end(form) }}

            <!-- Back to Login Link -->
            <p class="text-center">
                <a href="{{ path('app_login_controller_partner') }}" class="text-primary text-decoration-none">Retour à la connexion</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}