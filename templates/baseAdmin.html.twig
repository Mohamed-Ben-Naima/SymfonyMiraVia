<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>
		{% block title %}Welcome!{% endblock %}
	</title>
	
	<!-- CSS / JS Imports -->
	<link rel="stylesheet" href="SymfonyMiraVia-main/assets/styles/AdminStyle/sidebar-style.css">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

	<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

	{% block stylesheets %}{% endblock %}
	
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

	{% block javascripts %}
		{% block importmap %}
			{{ importmap('app') }}
		{% endblock %}
	{% endblock %}

	<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden; /* évite scroll global */
    }

    .container-fluid {
        height: 100%;
        padding: 0;
    }

    .row {
        height: 100%;
        margin: 0;
    }

    .sidebar {
        position: fixed;
        top: 93px; /* hauteur du navbar */
        bottom: 0;
        left: 0;
        width: 250px;
        z-index: 1000;
        overflow-y: auto;
        background-color: #f8f9fa;
    }

    .col-md-9.col-lg-10.px-md-4 {
        margin-left: 250px; /* largeur de la sidebar */
        padding: 0;
        height: 100%;
    }

    main {
        background-color: #E8E7DE;
        height: 100%;
        padding: 1rem;
        padding-left: 60px;
        overflow-y: auto; /* Ajout de la barre de défilement pour le contenu principal */
    }
</style>
</head>

<body>
	<!-- Navbar -->
	{% include 'partialAdmin/navbarAdmin.html.twig' %}

	<div class="container-fluid">
		<div class="row">
			<!-- Sidebar -->
			<div class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
				{% include 'partialAdmin/sidebarAdmin.html.twig' %}
			</div>

			<!-- Main content -->
			<div class="main">
				<main >
					{% block body %}{% endblock %}
				</main>
			</div>
		</div>
	</div>
</body>
</html>