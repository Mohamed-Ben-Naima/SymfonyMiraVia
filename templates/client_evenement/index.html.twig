{% extends 'base.client.html.twig' %}

{% block title %}Événements - MiraVia
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>:root
	{
		--primary-dark: #013a71;
		--secondary-blue: #81a8c5;
		--accent-green: #7d8c6d;
		--light-beige: #e8e7de;
		--text-dark: #2d3748;
	}

	.event-container {
		max-width: 1440px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	.event-card {
		border: 1px solid var(--light-beige);
		border-radius: 1.25rem;
		overflow: hidden;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		background: #ffffff;
		margin-bottom: 2rem;
		position: relative;
	}

	.event-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
	}

	.event-image {
		height: 320px;
		object-fit: cover;
		width: 100%;
		border-radius: 1.25rem 0 0 1.25rem;
	}

	.event-header {
		padding: 1.75rem 2rem;
		background: linear-gradient(135deg, var(--primary-dark) 0%, var(--secondary-blue) 100%);
		color: white;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.event-date {
		font-weight: 600;
		font-size: 1.05rem;
		letter-spacing: 0.25px;
		display: flex;
		align-items: center;
	}

	.event-location {
		font-size: 0.95rem;
		opacity: 0.9;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.event-body {
		padding: 2rem;
		background: #fff;
		flex-grow: 1;
	}

	.event-title {
		color: var(--primary-dark);
		font-size: 1.75rem;
		margin-bottom: 1.25rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.event-description {
		color: var(--text-dark);
		line-height: 1.7;
		margin-bottom: 1.75rem;
		font-size: 1.05rem;
		opacity: 0.9;
	}

	.event-actions {
		border-top: 1px solid rgba(232, 231, 222, 0.5);
		padding: 1.5rem 2rem;
		background: #fbfcfd;
	}

	.partner-badge {
		background: linear-gradient(45deg, var(--accent-green), #6b7b5f);
		color: white;
		padding: 0.5rem 1.25rem;
		border-radius: 2rem;
		font-size: 0.9rem;
		font-weight: 500;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}

	.partner-logo {
		width: 24px;
		height: 24px;
		object-fit: contain;
	}

	.btn-event {
		padding: 0.75rem 1.75rem;
		border-radius: 0.75rem;
		font-weight: 500;
		transition: all 0.2s ease;
		border-width: 2px;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}

	@media(max-width: 1200px) {
		.event-image {
			height: 280px;
			border-radius: 1.25rem 1.25rem 0 0;
		}

		.event-header {
			padding: 1.5rem;
		}

		.event-title {
			font-size: 1.5rem;
		}
	}

	@media(max-width: 768px) {
		.event-container {
			padding: 1.5rem 1rem;
		}

		.event-image {
			height: 240px;
		}

		.event-header {
			padding: 1.25rem;
		}

		.event-body {
			padding: 1.5rem;
		}

		.event-title {
			font-size: 1.375rem;
		}

		.btn-event {
			width: 100%;
			justify-content: center;
		}
	}

	.empty-state {
		padding: 4rem 2rem;
		background: rgba(232, 231, 222, 0.15);
		border-radius: 1.25rem;
		text-align: center;
		margin: 2rem 0;
	}

	.empty-state i {
		font-size: 3rem;
		color: var(--accent-green);
		margin-bottom: 1.5rem;
	}
</style>{% endblock %}{% block body %}
<div class="event-container">
	<div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-5 gap-4">
		<h1 class="text-primary fw-bold display-5 mb-0">Événements à Venir</h1>
		<div class="d-flex gap-3 w-100 w-lg-auto">
			<select class="form-select form-select-lg border-2 border-primary">
				<option>Trier par date de départ</option>
				<option>Plus récents</option>
				<option>Plus anciens</option>
			</select>
		</div>
	</div>

	<div class="row g-4">
		{% for event in evenements %}
			<div class="col-12">
				<div class="event-card">
					<div class="row g-0">
						<div class="col-lg-5">
							<img src="{{ event.imageName }}" class="event-image" alt="{{ event.titre }}" loading="lazy">
						</div>

						<div class="col-lg-7 d-flex flex-column">
							<div class="event-header">
								<span class="partner-badge">
									<img src="{{ event.partenaire.logo }}" class="partner-logo" alt="Logo {{ event.partenaire.nom_entreprise }}">
									{{ event.partenaire.nom_entreprise }}
								</span>
								<div class="d-flex flex-column gap-2 mt-3">
									<span class="event-date">
										<i class="fas fa-calendar-alt me-2"></i>
										{{ event.date_evenement|date('d M Y') }}
									</span>
									<span class="event-location">
										<i class="fas fa-map-marker-alt"></i>
										{{ event.lieu }}
									</span>
								</div>
							</div>

							<div class="event-body">
								<h2 class="event-title">{{ event.titre }}</h2>
								<p class="event-description">{{ event.description }}</p>
							</div>

							<div class="event-actions">
								<div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
									<span class="text-muted fw-medium">
										<i class="fas fa-clock me-2"></i>
										Départ à
										{{ event.date_evenement|date('H:i') }}
									</span>
									<div class="d-flex gap-3 w-100 w-lg-auto">
										<button class="btn btn-outline-primary btn-event">
											<i class="fas fa-info-circle"></i>
											Détails
										</button>
										<button class="btn btn-outline-danger btn-event">
											<i class="fas fa-heart"></i>
											Favoris
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		{% else %}
			<div class="empty-state">
				<i class="fas fa-calendar-times"></i>
				<h3 class="text-muted mb-3">Aucun événement programmé</h3>
				<p class="text-muted">Revenez plus tard pour découvrir nos prochains événements</p>
			</div>
		{% endfor %}
	</div>
</div>{% endblock %}{% block javascripts %}
{{ parent() }}
 <script>
        // Enhanced delete confirmation
        document.querySelectorAll('.btn-outline-danger').forEach(button => {
            button.addEventListener('click', function(e) {
                const eventTitle = this.closest('.event-card').querySelector('.event-title').textContent;
                if (confirm(`Voulez-vous vraiment retirer "${eventTitle}" de vos favoris ?`)) {
                    // Add AJAX call here
                    this.closest('.col-12').remove();
                }
            });
        });
    </script>{% endblock %}
