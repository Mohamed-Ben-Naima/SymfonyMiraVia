{# templates/registration/register.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <style>
        /* General Container Styling */
        .register-container {
            background-color: #e8e7de; /* Light cream background */
            padding: 2.5rem;
            border-radius: 15px;
            box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1); /* Slight shadow for depth */
        }

        .register-card {
            background-color: #ffffff;
            border: none;
            border-radius: 15px;
            box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1); /* Soft shadow */
            overflow: hidden;
        }

        .register-card-header {
            background: linear-gradient(135deg, #013a71, #81a8c5); /* Gradient header */
            color: #ffffff;
            padding: 1.5rem;
            text-align: center;
        }

        .register-card-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: 1px;
        }

        .register-card-body {
            padding: 2rem;
        }

        /* Form Styling */
        .form-title {
            color: #013a71;
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .form-row {
            display: flex;
            gap: 1.5rem; /* Consistent spacing between columns */
        }

        .form-row .col-md-6 {
            flex: 1;
        }

        .form-group-icon {
            position: relative;
        }

        .form-group-icon .form-control {
            padding-left: 40px;
        }

        .form-group-icon i {
            position: absolute;
            left: 15px;
            top: 80%;
            transform: translateY(-50%);
            font-size: 1.2rem;
            color: #81a8c5;
        }

        .form-control {
            border-radius: 30px;
            border: 1px solid rgba(129, 168, 197, 0.3);
            padding: 0.75rem 1rem;
            transition: all 0.3s ease-in-out;
        }

        .form-control:focus {
            border-color: #013a71;
            box-shadow: 0 0 5px rgba(1, 58, 113, 0.3); /* Subtle focus shadow */
        }

        .form-check-input {
            margin-top: 0.3rem;
        }

        .form-check-label {
            color: #013a71;
            font-weight: 500;
        }

        /* Button Styling */
        .btn-primary {
            background-color: #013a71;
            border-color: #013a71;
            border-radius: 30px;
            padding: 0.75rem 2rem;
            font-weight: 600;
            transition: all 0.3s ease-in-out;
            font-size: 1rem;
        }

        .btn-primary:hover {
            background-color: #7d8c6d;
            border-color: #7d8c6d;
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Subtle hover shadow */
        }

        /* Responsive Adjustments */
        @media (max-width: 768px) {
            .form-row {
                flex-direction: column; /* Stack rows on smaller screens */
                gap: 1rem; /* Adjust gap for smaller screens */
            }

            .btn-primary {
                width: 100%; /* Full-width button for smaller screens */
            }
        }
    </style>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="register-container">
                    <div class="register-card">
                        <div class="register-card-header">
                            <h1>Créer un compte</h1>
                        </div>
                        <div class="register-card-body">
                            {{ form_start(registrationForm) }}
                                <div class="form-title">Informations personnelles</div>
                                <div class="form-row">
                                    <div class="col-md-6 form-group-icon">
                                        <i class="fas fa-user"></i>
                                        {{ form_row(registrationForm.nom, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                    <div class="col-md-6 form-group-icon">
                                        <i class="fas fa-user-plus"></i>
                                        {{ form_row(registrationForm.prenom, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>

                                <div class="form-group-icon">
                                    <i class="fas fa-envelope"></i>
                                    {{ form_row(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                                </div>

                                <div class="form-group-icon">
                                    <i class="fas fa-lock"></i>
                                    {{ form_row(registrationForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                                </div>

                                <div class="form-title mt-4">Informations supplémentaires</div>
                                <div class="form-row">
                                    <div class="col-md-6 form-group-icon">
                                        <i class="fas fa-phone"></i>
                                        {{ form_row(registrationForm.telephone, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                    <div class="col-md-6 form-group-icon">
                                        <i class="fas fa-calendar-alt"></i>
                                        {{ form_row(registrationForm.birthday, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>

                                <div class="form-group-icon">
                                    <i class="fas fa-map-marker-alt"></i>
                                    {{ form_row(registrationForm.adresseUtilisateur, {'attr': {'class': 'form-control'}}) }}
                                </div>

                                <div class="form-group form-check mt-3">
                                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                    {{ form_errors(registrationForm.agreeTerms) }}
                                </div>

                                <div class="text-center mt-4">
                                    <button type="submit" class="btn btn-primary"><i class="fas fa-user-check me-2"></i>S'inscrire</button>
                                </div>
                            {{ form_end(registrationForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}