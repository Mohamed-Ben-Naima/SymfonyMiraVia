{% extends 'base.client.html.twig' %}

{% block title %}Opportunités de Bénévolat - MiraVia
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>:root
	{
		--primary-dark: #013a71;
		--secondary-blue: #81a8c5;
		--accent-green: #7d8c6d;
		--light-beige: #e8e7de;
		--text-dark: #2d3748;
	}

	.benevole-container {
		max-width: 1440px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	.benevole-card {
		border: 1px solid var(--light-beige);
		border-radius: 1.25rem;
		overflow: hidden;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		background: #ffffff;
		margin-bottom: 2rem;
		position: relative;
	}

	.benevole-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
	}

	.benevole-image {
		height: 320px;
		object-fit: cover;
		width: 100%;
		border-radius: 1.25rem 0 0 1.25rem;
	}

	.benevole-header {
		padding: 1.75rem 2rem;
		background: linear-gradient(135deg, var(--accent-green) 0%, #6b7b5f 100%);
		color: white;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.benevole-status {
		font-weight: 600;
		font-size: 1.05rem;
		letter-spacing: 0.25px;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.benevole-location {
		font-size: 0.95rem;
		opacity: 0.9;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.benevole-body {
		padding: 2rem;
		background: #fff;
		flex-grow: 1;
	}

	.benevole-title {
		color: var(--primary-dark);
		font-size: 1.75rem;
		margin-bottom: 1.25rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.benevole-description {
		color: var(--text-dark);
		line-height: 1.7;
		margin-bottom: 1.75rem;
		font-size: 1.05rem;
		opacity: 0.9;
	}

	.benevole-actions {
		border-top: 1px solid rgba(232, 231, 222, 0.5);
		padding: 1.5rem 2rem;
		background: #fbfcfd;
	}

	.partner-badge {
		background: linear-gradient(45deg, var(--primary-dark), var(--secondary-blue));
		color: white;
		padding: 0.5rem 1.25rem;
		border-radius: 2rem;
		font-size: 0.9rem;
		font-weight: 500;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}

	.partner-logo {
		width: 24px;
		height: 24px;
		object-fit: contain;
	}

	.btn-benevole {
		padding: 0.75rem 1.75rem;
		border-radius: 0.75rem;
		font-weight: 500;
		transition: all 0.2s ease;
		border-width: 2px;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}

	@media(max-width: 1200px) {
		.benevole-image {
			height: 280px;
			border-radius: 1.25rem 1.25rem 0 0;
		}

		.benevole-header {
			padding: 1.5rem;
		}

		.benevole-title {
			font-size: 1.5rem;
		}
	}

	@media(max-width: 768px) {
		.benevole-container {
			padding: 1.5rem 1rem;
		}

		.benevole-image {
			height: 240px;
		}

		.benevole-header {
			padding: 1.25rem;
		}

		.benevole-body {
			padding: 1.5rem;
		}

		.benevole-title {
			font-size: 1.375rem;
		}

		.btn-benevole {
			width: 100%;
			justify-content: center;
		}
	}

	.empty-state {
		padding: 4rem 2rem;
		background: rgba(232, 231, 222, 0.15);
		border-radius: 1.25rem;
		text-align: center;
		margin: 2rem 0;
	}

	.empty-state i {
		font-size: 3rem;
		color: var(--accent-green);
		margin-bottom: 1.5rem;
	}

	.status-badge {
		padding: 0.5rem 1rem;
		border-radius: 2rem;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.status-ouvert {
		background: #38a169;
		color: white;
	}

	.status-ferme {
		background: #e53e3e;
		color: white;
	}
</style>{% endblock %}{% block body %}
<div class="benevole-container">
	<div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-5 gap-4">
		<h1 class="text-primary fw-bold display-5 mb-0">Opportunités de Bénévolat</h1>
		<div class="d-flex gap-3 w-100 w-lg-auto">
			<select class="form-select form-select-lg border-2 border-primary">
				<option>Trier par date</option>
				<option>Plus récents</option>
				<option>Plus anciens</option>
			</select>
		</div>
	</div>

	<div class="row g-4">
		{% for benevolat in benevolats %}
			<div class="col-12">
				<div class="benevole-card">
					<div class="row g-0">
						<div class="col-lg-5">
							<img src="{{ benevolat.imageName }}" class="benevole-image" alt="{{ benevolat.titre }}" loading="lazy">
						</div>

						<div class="col-lg-7 d-flex flex-column">
							<div class="benevole-header">
								<span class="partner-badge">
									<img src="{{ benevolat.partenaire.logo }}" class="partner-logo" alt="Logo {{ benevolat.partenaire.nom_entreprise }}">
									{{ benevolat.partenaire.nom_entreprise }}
								</span>
								<div class="d-flex flex-column gap-2 mt-3">
									<span class="benevole-status">
										<i class="fas fa-circle {% if benevolat.status == 'ouvert' %}text-success{% else %}text-danger{% endif %}"></i>
										{{ benevolat.status|capitalize }}
										<span class="status-badge status-{{ benevolat.status }}">
											{{ benevolat.status == 'ouvert' ? 'Recherche des bénévoles' : 'Complet' }}
										</span>
									</span>
									<span class="benevole-location">
										<i class="fas fa-map-marker-alt"></i>
										{{ benevolat.lieu }}
									</span>
								</div>
							</div>

							<div class="benevole-body">
								<h2 class="benevole-title">{{ benevolat.titre }}</h2>
								<p class="benevole-description">{{ benevolat.description }}</p>
								<div class="d-flex align-items-center gap-2 text-muted mb-3">
									<i class="fas fa-calendar-day"></i>
									{{ benevolat.date_benevolat|date('d M Y à H:i') }}
								</div>
							</div>

							<div class="benevole-actions">
								<div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
									<div class="d-flex gap-2 align-items-center">
										<i class="fas fa-users text-muted"></i>
										<span class="text-muted fw-medium">20 places disponibles</span>
									</div>
									<div class="d-flex gap-3 w-100 w-lg-auto">
										<button class="btn btn-primary btn-benevole">
											<i class="fas fa-hand-holding-heart"></i>
											Postuler
										</button>
										<button class="btn btn-outline-secondary btn-benevole">
											<i class="fas fa-info-circle"></i>
											Détails
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		{% else %}
			<div class="empty-state">
				<i class="fas fa-hands-helping"></i>
				<h3 class="text-muted mb-3">Aucune opportunité disponible</h3>
				<p class="text-muted">Revenez plus tard pour de nouvelles opportunités de bénévolat</p>
			</div>
		{% endfor %}
	</div>
</div>{% endblock %}{% block javascripts %}
{{ parent() }}
 <script>
        // Application handling
        document.querySelectorAll('.btn-primary').forEach(button => {
            button.addEventListener('click', function(e) {
                const benevoleTitle = this.closest('.benevole-card').querySelector('.benevole-title').textContent;
                if (confirm(`Voulez-vous postuler pour "${benevoleTitle}" ?`)) {
                    // Add AJAX call here
                    this.innerHTML = `<i class="fas fa-spinner fa-spin"></i> En cours...`;
                    this.disabled = true;
                }
            });
        });
    </script>{% endblock %}
