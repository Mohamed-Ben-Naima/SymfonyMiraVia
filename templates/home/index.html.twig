{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <style>
        /* General container styling */
        .container {
            position: relative;
            width: 100%;
        }

        /* Styling for the header area */
        .header-include {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: auto;
            z-index: 1;
        }

        /* Styling for the main image */
        .rectangle {
            display: block;
            width: 100%;
            height: 740px; /* Fixed height */
            object-fit: cover; /* Ensures the image fills without distortion */
            z-index: 0;
        }

        /* Styling for the text overlay */
        .text-overlay {
            position: absolute;
            top: 213px;
            left: 50%;
            transform: translateX(-50%);
            color: #013A71;
            text-align: center;
            text-shadow: 0px 5px 13px rgba(255, 255, 255, 0.4);
            font-family: Volkhov, serif;
            font-size: 48px;
            font-weight: 700;
            line-height: normal;
            width: 90%;
            max-width: 744px; /* Keeps text responsive */
            z-index: 2;
        }

        /* Flex container for image and text alignment */
        .video-container {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 43px;
        }

        /* Styling for the video play image */
        .load-image {
            display: block;
            margin: 0;
        }

        /* Styling for the video text */
        .video-text {
            color: var(--Main-Dark, #1C2B38);
            text-align: center;
            font-family: Mulish, sans-serif;
            font-size: 20px;
            font-weight: 700;
            margin-left: 10px;
        }

        /* Styling for the additional styled block */
        .styled-block {
            position: absolute;
            top: 480px;
            left: 50%;
            transform: translateX(-50%);
            width: 966.404px;
            height: 90px;
            border-radius: 10px;
            background: #FFF;
            box-shadow: 0px 10px 30px rgba(123, 188, 176, 0.5);
        }
    </style>

    <div class="container">
        <!-- Text overlay section -->
        <div class="text-overlay">
            Nous trouvons les meilleures excursions pour vous.
            <div class="video-container">
                <img class="load-image" src="{{ asset('images/looad.png') }}" alt="Load Image" />
                <div class="video-text">Regarder la vidéo</div>
            </div>
            <div class="styled-block"></div>
        </div>

        <!-- Main background image -->
        <img class="rectangle" src="https://c.animaapp.com/m9u73nw5frNzDy/img/rectangle-143.svg" alt="Background Image" />
    </div>
{% endblock %}