  <section class="trip-card-section-viewport">
      <div class="events-track">
    {% if evenements is not empty %}
        {% for event in evenements %}
            {#
                If you didn't filter in the controller, you could do it here:
                {% if event.estBloque == 0 %}
            #}

            <div class="trip-card">
                <div class="trip-image-container">
                    <img
                        {# Adjust 'uploads/event_images/' to your actual public image path #}
                        {# Check if event.imagename is not the string 'NULL' and not empty #}
                        src="{{ (event.imagename and event.imagename != 'NULL') ? asset('uploads/event_images/' ~ event.imagename) : asset('images/placeholder-event.jpg') }}"
                        alt="{{ (event.titre and event.titre != 'NULL') ? event.titre : 'Image de l\'événement' }}">
                    <button class="favorite-btn">
                        {# SVG Heart Icon - Ensure IDs like _event_{{ event.idEvenement }} are unique #}
                        <svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 23 23" fill="none">
