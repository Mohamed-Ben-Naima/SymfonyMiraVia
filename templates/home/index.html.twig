    <script>
       document.addEventListener('DOMContentLoaded', () => {
    const prevButton = document.getElementById('carousel-prev-btn');
    const nextButton = document.getElementById('carousel-next-btn');
    const track = document.querySelector('.events-track');
    
    if (!track || !prevButton || !nextButton) {
        console.warn('Carousel elements not found. Ensure track, prevButton, and nextButton have correct IDs.');
        // Hide buttons if track isn't there or has no children
        if (prevButton) prevButton.style.display = 'none';
        if (nextButton) nextButton.style.display = 'none';
        return;
    }

    const cards = Array.from(track.querySelectorAll('.trip-card'));
    const cardsPerPage = 4;
    const totalCards = cards.length;

    if (totalCards === 0) {
        prevButton.style.display = 'none';
        nextButton.style.display = 'none';
        return;
    }
    
    const totalPages = Math.ceil(totalCards / cardsPerPage);
    let currentPage = 0;

    // Calculate the width to shift by (width of 4 cards + 3 gaps)
    // This assumes the viewport is correctly sized by CSS to show 4 cards
    const viewport = document.querySelector('.trip-card-section-viewport');
    const slideWidth = viewport.offsetWidth; // The visible width of 4 cards area

    function updateCarouselState() {
        // Move the track
        track.style.transform = `translateX(-${currentPage * slideWidth}px)`;

        // Update Previous Button State
        if (currentPage === 0) {
            prevButton.setAttribute('data-disabled', 'true');
        } else {
            prevButton.removeAttribute('data-disabled');
        }

        // Update Next Button State
        if (currentPage >= totalPages - 1) {
            nextButton.setAttribute('data-disabled', 'true');
        } else {
            nextButton.removeAttribute('data-disabled');
        }
    }

    nextButton.addEventListener('click', () => {
        if (currentPage < totalPages - 1) {
            currentPage++;
            updateCarouselState();
        }
    });

    prevButton.addEventListener('click', () => {
        if (currentPage > 0) {
            currentPage--;
            updateCarouselState();
        }
    });

    // Initial setup
    if (totalCards <= cardsPerPage) {
        // Not enough cards to need navigation
        prevButton.style.display = 'none';
        nextButton.style.display = 'none';
    } else {
        updateCarouselState(); // Set initial button states and position
    }

    // Optional: Recalculate on window resize if your layout is very fluid.
    // window.addEventListener('resize', () => {
    //    slideWidth = viewport.offsetWidth; // Re-calculate slideWidth
    //    updateCarouselState(); // Re-apply transform, useful if number of visible cards changes (more complex)
    // });
});
    </script>
