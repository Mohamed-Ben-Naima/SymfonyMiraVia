<style>
/* Sidebar Styling */
.sidebar {
    width: 280px;
    background-color: #ffffff;
    border-right: 1px solid #e0e0e0;
    min-height: 100vh;
    position: fixed;
    top: 0;
    padding: 20px;
    overflow-y: auto;
    transition: all 0.3s ease-in-out;
    z-index: 1000;
}

.sidebar.minimal {
    width: 100px;
}

/* Sidebar Toggle Button */
.sidebar .toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    padding: 10px 15px;
    border-radius: 6px;
    background-color: #0d6efd;
    color: white;
    border: none;
}

.sidebar.minimal .toggle-text {
    display: none;
}

/* Profile Section */
.sidebar .profile-section {
    text-align: center;
    padding: 15px 0;
    border-bottom: 1px solid #e0e0e0;
}

.sidebar .profile-img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border: 3px solid #0d6efd;
    padding: 3px;
    transition: all 0.3s ease;
}

.sidebar.minimal .profile-img {
    width: 60px;
    height: 60px;
}

.sidebar .user-name {
    font-size: 1rem;
    font-weight: bold;
    color: #013A71;
    margin-bottom: 5px;
    transition: opacity 0.3s ease;
}

.sidebar .user-location {
    font-size: 0.9rem;
    color: #6c757d;
    transition: opacity 0.3s ease;
}

.sidebar.minimal .user-name,
.sidebar.minimal .user-location {
    opacity: 0;
}

/* Navigation Links */
.sidebar .nav-link {
    display: flex;
    align-items: center;
    padding: 12px 15px;
    font-size: 16px;
    color: #013A71;
    text-decoration: none;
    border-radius: 5px;
    transition: all 0.3s ease-in-out;
}

.sidebar .nav-link i {
    font-size: 20px;
}

/* Minimal Mode Navigation Links */
.sidebar.minimal .nav-link {
    justify-content: center;
    padding: 12px;
}

.sidebar.minimal .nav-link i {
    margin-right: 0;
}

/* Link Text */
.sidebar .link-text {
    transition: opacity 0.3s ease;
    opacity: 1;
}

.sidebar.minimal .link-text {
    opacity: 0;
    pointer-events: none;
}

/* Active and Hover States */
.sidebar .nav-link.active {
    background-color: #e6f7ff;
    font-weight: bold;
    color: #0d6efd;
}

.sidebar .nav-link:hover {
    background-color: #81A8C5;
    color: #ffffff;
}

/* Responsive Design */
@media (max-width: 768px) {
    .sidebar {
        width: 100%;
        height: auto;
        position: relative;
    }

    .sidebar.minimal {
        width: 60px;
    }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.getElementById("sidebar");
    const sidebarToggle = document.getElementById("sidebarToggle");

    // Toggle Sidebar Expand/Collapse
    sidebarToggle.addEventListener("click", () => {
        sidebar.classList.toggle("minimal");
    });
});
</script>