 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> {% block stylesheets %}{% endblock %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">


<div
	class="sidebar d-flex flex-column flex-shrink-0 p-3" id="sidebar">
	<!-- Toggle Button -->
	<button class="btn btn-primary mb-4 toggle-btn" id="sidebarToggle">
		<i class="fas fa-bars"></i>
		<span class="toggle-text">Menu</span>
	</button>

	<!-- User Profile Section -->
	<div class="text-center py-4">
		<img src="https://i.pravatar.cc/100" alt="Profile Picture" class="rounded-circle img-fluid mb-3 profile-img">
		<h5 class="user-name">Ali Ben Salah</h5>
		<p class="user-location text-muted">
			<i class="bi bi-geo-alt"></i>
			Tunisie</p>
	</div>

	<!-- Navigation Links -->
	<ul class="nav nav-pills flex-column mb-auto">
		<li class="nav-item">
			<a href="#" class="nav-link active" id="link-informations" onclick="navigateToSection(event)">
				<i class="bi bi-person me-2"></i>
				<span class="link-text">Informations Personnelles</span>
			</a>
		</li>
		<li class="nav-item">
			<a href="#" class="nav-link" id="link-favoris" onclick="navigateToSection(event)">
				<i class="bi bi-heart me-2"></i>
				<span class="link-text">Favoris</span>
			</a>
		</li>
		<li class="nav-item">
			<a href="#" class="nav-link" id="link-benevolat" onclick="navigateToSection(event)">
				<i class="bi bi-hand-thumbs-up me-2"></i>
				<span class="link-text">Bénévolat</span>
			</a>
		</li>
		<li class="nav-item">
			<a href="#" class="nav-link" id="link-demande" onclick="navigateToSection(event)">
				<i class="bi bi-question-circle me-2"></i>
				<span class="link-text">Demande D'aide</span>
			</a>
		</li>
		<li class="nav-item">
			<a href="#" class="nav-link" id="link-evenements" onclick="navigateToSection(event)">
				<i class="bi bi-calendar-event me-2"></i>
				<span class="link-text">Événements</span>
			</a>
		</li>
		<li class="nav-item">
			<a href="#" class="nav-link" id="link-experiences" onclick="navigateToSection(event)">
				<i class="bi bi-briefcase me-2"></i>
				<span class="link-text">Expériences</span>
			</a>
		</li>
		<li class="nav-item">
			<a href="#" class="nav-link" id="link-parametres" onclick="navigateToSection(event)">
				<i class="bi bi-gear me-2"></i>
				<span class="link-text">Paramètres</span>
			</a>
		</li>
	</ul>
</div>

<style>
	/* Sidebar Styling */
	.sidebar {
		width: 280px;
		background-color: #ffffff; /* White background */
		border-right: 1px solid #ddd; /* Subtle border */
		height: 100vh; /* Full height of the viewport */
		overflow-y: auto; /* Scroll if content overflows */
		position: fixed; /* Fixed layout */
		top: 0;
		padding: 20px;
		transition: all 0.3s ease-in-out; /* Smooth transition */
		z-index: 1000; /* Ensure sidebar stays on top */
	}

	.sidebar.minimal {
		width: 80px; /* Minimal width */
	}

	.sidebar .toggle-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 16px;
		padding: 10px;
		width: 100%;
		transition: all 0.3s ease-in-out;
	}

	.sidebar.minimal .toggle-text {
		display: none; /* Hide text on minimal mode */
	}

	.sidebar .profile-img {
		width: 80px;
		height: 80px;
		object-fit: cover;
		margin-bottom: 10px;
		border: 2px solid #0d6efd; /* Blue border */
		padding: 2px;
		transition: all 0.3s ease-in-out;
	}

	.sidebar.minimal .profile-img {
		width: 40px;
		height: 40px;
	}

	.sidebar .user-name,
	.sidebar .user-location,
	.sidebar .link-text {
		transition: opacity 0.3s ease;
		opacity: 1;
	}

	.sidebar.minimal .user-name,
	.sidebar.minimal .user-location,
	.sidebar.minimal .link-text {
		opacity: 0; /* Hide text when minimal */
	}

	.sidebar .nav-link {
		color: #013A71; /* Text color */
		padding: 12px 15px;
		font-size: 16px;
		border-radius: 6px;
		display: flex;
		align-items: center;
		transition: all 0.3s ease-in-out;
	}

	.sidebar .nav-link i {
		font-size: 18px;
		margin-right: 10px;
		transition: margin 0.3s ease-in-out;
	}

	.sidebar.minimal .nav-link {
		justify-content: center; /* Center align icons on minimal mode */
		padding: 10px;
	}

	.sidebar.minimal .nav-link i {
		margin-right: 0; /* Remove margin for icons */
	}

	.sidebar .nav-link.active {
		background-color: #e6e6e6; /* Active state background */
		color: #013A71;
	}

	.sidebar .nav-link:hover {
		background-color: #81A8C5;
		color: #ffffff;
	}

	/* Responsive Adjustments */
	@media(max-width: 768px) {
		.sidebar {
			width: 100%; /* Full width on smaller screens */
			height: auto;
			position: relative;
			border-right: none;
		}

		.sidebar.minimal {
			width: 60px; /* Minimal width for mobile */
		}

		.sidebar .toggle-btn {
			position: sticky;
			top: 0;
		}
	}
</style>

 <script>
document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.getElementById("sidebar");
    const sidebarToggle = document.getElementById("sidebarToggle");

    // Toggle Sidebar Expand/Collapse
    sidebarToggle.addEventListener("click", () => {
        sidebar.classList.toggle("minimal");
    });
});
</script>
