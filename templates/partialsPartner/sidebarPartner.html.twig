<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{% block title %}MiraVia - Tableau de bord{% endblock %}</title>
  <!-- Bootstrap CSS -->
  <link href="{{ asset('style-partner/bootstrap.min.css') }}" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link href="{{ asset('style-partner/sidebar.css') }}" rel="stylesheet">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar">
    <img src="{{ asset('images/logo.png') }}" alt="Logo" class="logo-img mb-3">
    <a href="#"><i class="bi bi-bar-chart-fill"></i> Tableau de bord</a>
    <a href="#"><i class="bi bi-question-circle"></i> Demande d'aide</a>
    <a href="#"><i class="bi bi-currency-exchange"></i> Dons</a>
    <a href="#"><i class="bi bi-calendar-check-fill"></i> Evénements</a>
    <a href="#"><i class="bi bi-valentine"></i> Bénévolat</a>
    <a href="#"><i class="bi bi-person-badge-fill"></i> Gérer Responsables</a>
    <a href="#"><i class="bi bi-gear-fill"></i> Paramètres</a>
    <a href="#"><i class="bi bi-chat-quote-fill"></i> Messagerie</a>
    <a href="#"><i class="bi bi-box-arrow-left"></i> Déconnexion</a>
  </div>

  <!-- Main Content Section -->
  <div class="flex-grow-1">
    {% block body %}
    <!-- Le contenu des pages enfants sera injecté ici -->
    {% endblock %}
  </div>
</body>
</html>