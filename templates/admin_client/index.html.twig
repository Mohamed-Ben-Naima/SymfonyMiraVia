{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste des Clients{% endblock %}

{% block body %}
<style>
html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #fdfdfd;
    overflow: hidden; /* Remove global scroll */
}

.example-wrapper {
    margin: 0 auto;
    padding: 20px;
    margin-left: 15%;
    max-height: calc(100vh - 40px); /* Dynamically adjust height to fit screen */
    overflow: visible; /* Remove internal scroll */
}

.example-wrapper h1 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 40px;
    color: rgb(0, 0, 0);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.search-box {
    position: relative;
    width: 87%;
}

.search-box input {
    width: 100%;
    padding: 8px 30px 8px 12px;
    border: 1px solid #7D8C6D;
    border-radius: 6px;
    font-size: 14px;
}

#statusFilter {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #7D8C6D;
    font-size: 14px;
    margin-left: -1%;
}

.header button {
    padding: 8px 31px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.button-unblock {
    background-color: #013A71; /* Couleur bleue */
    color: white; /* Texte blanc */
}

.button-unblock:hover {
    background-color:rgb(38, 86, 131); /* Couleur bleue foncée au survol */
}
.button-block {
    background-color:rgb(146, 151, 155); /* Couleur bleue */
    color: white; /* Texte blanc */
}

.button-block:hover {
    background-color:rgb(116, 118, 120); /* Couleur bleue foncée au survol */
}


.header button:hover {
    background-color: #5c7352;
}

table {
    width: 100%;
    max-width: 100%; /* Prevent overflow */
    border-collapse: collapse;
    font-size: 14px;
    background-color: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.05);
    table-layout: auto; /* Allow columns to adjust */
    overflow-x: auto; /* Enable horizontal scroll if needed */
}

th, td {
    padding: 10px;
    text-align: left;
    word-wrap: break-word; /* Ensure text wraps within cells */
}

th {
    background-color: rgb(176, 203, 223);
    color: black;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

tr:hover {
    background-color: #81A8C5;
    color: white;
}

.actions {
    display: flex;
    gap: 8px;
}

.actions button {
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
}

/* Styles pour le modal */
.modal {
    display: none; /* Par défaut, le modal est caché */
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5); /* Couleur de fond semi-transparente */
}

.modal-content {
    background-color: #fff;
    margin: 10% auto;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 30%; /* Largeur du modal */
    box-shadow: 0 10px 20px rgba(87, 104, 202, 0.5);
    max-width: 500px; /* Largeur maximale */
    text-align: center;
}

.modal-header {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
}

.modal-body {
    margin-bottom: 20px;
}

.modal-body label {
    display: block;
    margin-bottom: 5px;
    font-size: 14px;
    text-align: left;
    font-weight: bold; /* Rend le texte en gras */
}

.modal-body input,
.modal-body select {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 14px;
}

.modal-footer {
    display: flex;
    justify-content: center; /* Centre les éléments horizontalement */
    gap: 10px; /* Ajoute un espace entre les boutons */
}

.modal-footer button {
    padding: 10px 20px;
    font-size: 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.modal-footer .confirm-btn {
    background-color: #7D8C6D;
    color: white;
}

.modal-footer .confirm-btn:hover {
    background-color: #5c7352;
}

.modal-footer .cancel-btn {
    background-color:  #013A71;;
    color: white;
}

.modal-footer .cancel-btn:hover {
    background-color:rgb(24, 95, 162);
}

/* Style for the close button */
.modal-header .close-btn {
    background: none;
    border: none;
    font-size: 20px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    position: absolute;
    top: 10px;
    right: 10px;
    outline: none;
    transition: color 0.3s ease;
}

.modal-header .close-btn:hover {
    color: #ff0000; /* Red color on hover */
}

@media (max-width: 992px) {
    .example-wrapper {
        margin-left: 5%;
        margin-right: 5%;
        padding: 10px;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box,
    #statusFilter,
    .header button {
        width: 100%;
        margin: 5px 0;
    }

    #statusFilter {
        margin-left: 0;
    }

    table {
        font-size: 12px;
    }

    th, td {
        padding: 6px;
    }

    .actions {
        flex-direction: column;
        align-items: flex-start;
    }

    .actions button {
        width: 100%;
        margin-bottom: 4px;
    }
}

@media (max-width: 768px) {
    table {
        display: block;
        overflow-x: auto; /* Allow horizontal scroll for small screens */
        white-space: nowrap;
    }
}
</style>

<div class="example-wrapper">
    <h1>Liste des Clients</h1>

    <div class="header">
        <div class="search-box">
            <input type="text" id="search" placeholder="Rechercher un Client...">
        </div>

        <select id="statusFilter">
            <option value="">Tous les états</option>
            <option value="Actif">Actif</option>
            <option value="Inactif">Inactif</option>
        </select>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nom de Client</th>
                <th>Téléphone</th>
                <th>Email</th>
                <th>Adresse</th>
                <th>Date d'inscription</th>
                <th>Etat</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="userTable">
            {% for i in 1..30 %}
            <tr>
                <td>{{ i }}</td>
                <td>Mark</td>
                <td>Otto</td>
                <td>Adresse {{ i }}</td>
                <td>2025-12-31</td>
                <td>Commerce</td>
                <td>{{ i is even ? 'Actif' : 'Inactif' }}</td>
                <td class="actions">
            <button class="button-block" onclick="blockUser({{ i }})">Bloquer</button>
            <button class="button-unblock" onclick="unblockUser({{ i }})">Débloquer</button> 
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Confirmation Modal -->
<div id="actionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            Confirmation
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
            <p id="successMessageAction" style="color: green; font-size: 13px; display: none; margin-bottom: 10px;">
                L'action a été réalisée avec succès.
            </p>
            <p id="actionMessage"></p>
        </div>
        <div class="modal-footer">
            <button class="confirm-btn" onclick="confirmAction()">Confirmer</button>
            <button class="cancel-btn" onclick="closeModal()">Annuler</button>
        </div>
    </div>
</div>

<script>

    let actionCallback; // Variable to store the callback function

    // Open confirmation modal for blocking/unblocking
    function openConfirmationModal(message, callback) {
        const modal = document.getElementById('actionModal');
        const actionMessage = document.getElementById('actionMessage');
        actionMessage.textContent = message; // Update modal message
        modal.style.display = 'block'; // Show modal
        actionCallback = callback; // Store callback
    }

    // Confirm blocking/unblocking action
    function confirmAction() {
        if (typeof actionCallback === 'function') {
            actionCallback(); // Execute callback
            const successMessage = document.getElementById('successMessageAction');
            successMessage.style.display = 'block'; // Show success message
            setTimeout(() => {
                successMessage.style.display = 'none'; // Hide message after 3 seconds
                closeModal(); // Close modal
            }, 3000);
        }
    }

    
    // Block a user
    function blockUser(id) {
        openConfirmationModal(`Êtes-vous sûr de bloquer l'utilisateur #${id} ?`, function() {
            console.log(`Utilisateur #${id} bloqué.`);
        });
    }

    // Unblock a user
    function unblockUser(id) {
        openConfirmationModal(`Êtes-vous sûr de débloquer l'utilisateur #${id} ?`, function() {
            console.log(`Utilisateur #${id} débloqué.`);
        });
    }

        // Open date update modal
    function openModal() {
        document.getElementById('modal').style.display = 'block';
        document.getElementById('successMessageDate').style.display = 'none'; // Hide success message
    }

    // Close all modals
    function closeModal() {
        document.querySelectorAll('.modal').forEach(modal => modal.style.display = 'none');
    }

    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

    function filterTable() {
        const searchFilter = document.getElementById('search').value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value;
        const rows = document.querySelectorAll('#userTable tr');

        rows.forEach(row => {
            const cells = row.querySelectorAll('td');
            const textMatch = Array.from(cells).slice(0, 9)
                .some(cell => cell.textContent.toLowerCase().includes(searchFilter));

            const status = cells[8].textContent.trim();
            const statusMatch = statusFilter === "" || status === statusFilter;

            row.style.display = (textMatch && statusMatch) ? '' : 'none';
        });
    }
</script>
{% endblock %}
