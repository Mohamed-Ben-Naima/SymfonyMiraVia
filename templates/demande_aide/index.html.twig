{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #eef2ff;
            --primary-lighter: #f5f7ff;
            --secondary: #3f37c9;
            --dark: #1e293b;
            --medium: #64748b;
            --light: #f8fafc;
            --border: #e2e8f0;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --radius: 12px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
            --shadow-lg: 0 10px 15px rgba(0,0,0,0.1);
            --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        
        body {
            background-color: var(--light);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--dark);
            line-height: 1.6;
        }
        
        .container {
            max-width: 1400px;
        }
        
        /* Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border);
        }
        
        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--dark);
            margin: 0;
        }
        
        .results-count {
            background-color: var(--primary-light);
            color: var(--primary);
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
        }
        
        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: var(--radius);
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            position: sticky;
            top: 1rem;
        }
        
        .filter-title {
            font-weight: 700;
            margin-bottom: 1.25rem;
            color: var(--dark);
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .filter-title i {
            background: var(--primary-light);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
        }
        
        .filter-group {
            margin-bottom: 1.5rem;
        }
        
        .filter-group h6 {
            font-weight: 600;
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .filter-group h6 i {
            color: var(--primary);
        }
        
        /* Card styles */
        .demande-card {
            border: none;
            border-radius: var(--radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
            height: 100%;
            display: flex;
            flex-direction: column;
            background: white;
        }
        
        .demande-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }
        
        .card-header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 1rem 1.5rem;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .card-header-title {
            font-weight: 600;
            font-size: 1rem;
        }
        
        .proof-icon {
            color: white;
            transition: var(--transition);
        }
        
        .proof-icon:hover {
            color: var(--primary-light);
            transform: scale(1.1);
        }
        
        .card-body {
            padding: 1.5rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        
        .card-description {
            color: var(--medium);
            margin-bottom: 1.25rem;
            flex-grow: 1;
            font-size: 0.95rem;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        /* Meta information */
        .card-meta {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }
        
        .meta-item {
            display: flex;
            align-items: center;
            font-size: 0.9rem;
        }
        
        .meta-icon {
            width: 20px;
            color: var(--primary);
            margin-right: 0.75rem;
        }
        
        /* Status badges */
        .status-badge {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            display: inline-block;
        }
        
        .status-en_attente {
            background-color: var(--warning);
            color: white;
        }
        
        .status-actif {
            background-color: var(--success);
            color: white;
        }
        
        .status-rejete {
            background-color: var(--danger);
            color: white;
        }
        
        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            background: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            margin: 0 auto;
            max-width: 600px;
        }
        
        .empty-icon {
            font-size: 3.5rem;
            color: var(--primary);
            margin-bottom: 1.5rem;
            opacity: 0.8;
        }
        
        .empty-title {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }
        
        .empty-text {
            color: var(--medium);
            max-width: 500px;
            margin: 0 auto 2rem;
            font-size: 1rem;
        }
        
        /* Sorting controls */
        .sort-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .sort-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--medium);
        }
        
        .sort-select {
            border-radius: 50px;
            padding: 0.5rem 1rem;
            border: 1px solid var(--border);
            font-size: 0.9rem;
        }
        
        /* Responsive adjustments */
        @media (max-width: 992px) {
            .filter-section {
                position: static;
                margin-bottom: 2rem;
            }
            
            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }
        }
        
        /* Animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .demande-card {
            animation: fadeIn 0.5s ease forwards;
        }
        
        /* Button styles */
        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
            transition: var(--transition);
        }
        
        .btn-primary:hover {
            background-color: var(--secondary);
            border-color: var(--secondary);
            transform: translateY(-2px);
        }
        
        .btn-outline-secondary {
            transition: var(--transition);
        }
        
        .btn-outline-secondary:hover {
            transform: translateY(-2px);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <!-- Filter Section -->
        <div class="col-lg-3 mb-4 mb-lg-0">
            <form method="get" class="filter-form">
                <div class="filter-section">
                    <h4 class="filter-title">
                        <i class="fas fa-sliders-h"></i>
                        Filtres avancés
                    </h4>
                    
                    <!-- Keyword Search -->
                    <div class="filter-group">
                        <h6><i class="fas fa-search"></i>Recherche</h6>
                        <input type="text" class="form-control" name="q" placeholder="Mot-clé..." value="{{ filters.keyword }}">
                    </div>
                    
                    <!-- Status Filter -->
                    <div class="filter-group">
                        <h6><i class="fas fa-tag"></i>Statut</h6>
                        <select class="form-select" name="status">
                            <option value="">Tous les statuts</option>
                            {% for status in statuses %}
                                <option value="{{ status }}" {{ filters.status == status ? 'selected' }}>
                                    {{ status|capitalize }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <!-- Type Filter -->
                    <div class="filter-group">
                        <h6><i class="fas fa-hands-helping"></i>Type d'aide</h6>
                        <select class="form-select" name="type">
                            <option value="">Tous les types</option>
                            {% for type in types %}
                                <option value="{{ type }}" {{ filters.type == type ? 'selected' }}>
                                    {{ type|capitalize }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <!-- Amount Range -->
                    <div class="filter-group">
                        <h6><i class="fas fa-money-bill-wave"></i>Montant (DT)</h6>
                        <div class="row g-2">
                            <div class="col">
                                <input type="number" class="form-control" name="min_amount" placeholder="Min" value="{{ filters.min_amount }}">
                            </div>
                            <div class="col">
                                <input type="number" class="form-control" name="max_amount" placeholder="Max" value="{{ filters.max_amount }}">
                            </div>
                        </div>
                    </div>
                    
                    <!-- Date Range -->
                    <div class="filter-group">
                        <h6><i class="far fa-calendar-alt"></i>Date</h6>
                        <div class="mb-3">
                            <label class="form-label small">De</label>
                            <input type="date" class="form-control" name="date_from" value="{{ filters.date_from }}">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">À</label>
                            <input type="date" class="form-control" name="date_to" value="{{ filters.date_to }}">
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-filter me-2"></i>Appliquer
                        </button>
                        {% if filters.status != 'Actif' or filters.type or filters.keyword or filters.min_amount or filters.max_amount or filters.date_from or filters.date_to %}
                            <a href="{{ path('app_demande_aide') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-undo me-2"></i>Réinitialiser
                            </a>
                        {% endif %}
                    </div>
                </div>
            </form>
        </div>
        
        <!-- Demandes List -->
        <div class="col-lg-9">
            <div class="page-header">
                <h1 class="page-title">Demandes d'aide</h1>
                <span class="results-count">{{ demandes|length }} résultat(s)</span>
            </div>
            
            <!-- Sorting Controls -->
            <div class="sort-controls">
                <span class="sort-label">Trier par:</span>
                <select class="sort-select" onchange="window.location.href = updateQueryStringParam('sort', this.value)">
                    <option value="date_desc" {{ filters.sort == 'date_desc' ? 'selected' }}>Date (récent)</option>
                    <option value="date_asc" {{ filters.sort == 'date_asc' ? 'selected' }}>Date (ancien)</option>
                    <option value="amount_desc" {{ filters.sort == 'amount_desc' ? 'selected' }}>Montant (haut)</option>
                    <option value="amount_asc" {{ filters.sort == 'amount_asc' ? 'selected' }}>Montant (bas)</option>
                </select>
            </div>
            
            {% if demandes|length > 0 %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    {% for demande in demandes %}
                        <div class="col">
                            <div class="card demande-card">
                                <div class="card-header">
                                    <span class="card-header-title">
                                        <i class="fas fa-hands-helping me-2"></i>
                                        {{ demande.typeAide|capitalize|default('Aide') }}
                                    </span>
                                    {% if demande.preuves %}
                                        <a href="{{ asset('uploads/preuves/' ~ demande.preuves) }}" class="proof-icon" target="_blank" title="Voir les preuves">
                                            <i class="fas fa-file-alt"></i>
                                        </a>
                                    {% endif %}
                                </div>
                                <div class="card-body">
                                    <p class="card-description">
                                        {{ demande.description|default('Aucune description fournie') }}
                                    </p>
                                    
                                    <div class="card-meta">
                                        <div class="meta-item">
                                            <i class="fas fa-money-bill-wave meta-icon"></i>
                                            <span>{{ demande.montantDemande ?? '—' }} DT</span>
                                        </div>
                                        <div class="meta-item">
                                            <i class="fas fa-calendar-alt meta-icon"></i>
                                            <span>{{ demande.dateDemande ? demande.dateDemande|date('d/m/Y') : '—' }}</span>
                                        </div>
                                        <div class="meta-item">
                                            <i class="fas fa-info-circle meta-icon"></i>
                                            <span class="status-badge status-{{ demande.status|lower|replace({'\'': '', ' ': '_'}) }}">
                                                {{ demande.status|replace({'\'': ''})|capitalize }}
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <a href="#" class="btn btn-primary mt-auto">
                                        <i class="fas fa-eye me-2"></i>Voir détails
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="far fa-calendar-times"></i>
                    </div>
                    <h3 class="empty-title">Aucune demande trouvée</h3>
                    <p class="empty-text">
                        Aucune demande ne correspond à vos critères de recherche.
                        Essayez d'ajuster vos filtres ou revenez plus tard.
                    </p>
                    <a href="{{ path('app_demande_aide') }}" class="btn btn-primary px-4">
                        <i class="fas fa-undo me-2"></i>Réinitialiser les filtres
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    function updateQueryStringParam(key, value) {
        const url = new URL(window.location.href);
        url.searchParams.set(key, value);
        return url.toString();
    }
</script>
{% endblock %}