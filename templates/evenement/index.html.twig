{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        .event-card {
            transition: transform 0.3s, box-shadow 0.3s;
            border: none;
            border-radius: 10px;
            overflow: hidden;
            height: 100%;
        }
        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }
        .event-img {
            height: 200px;
            object-fit: cover;
            width: 100%;
        }
        .filter-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            height: fit-content;
        }
        .btn-event {
            background: linear-gradient(45deg, #6c63ff, #4a3ff2);
            border: none;
            width: 100%;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <!-- Filter Section (Left) -->
        <div class="col-md-3 mb-4">
            <div class="filter-section sticky-top">
                <h4 class="mb-4">🔍 Filters</h4>
                <form>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="">All</option>
                            <option value="actif">Active</option>
                            <option value="inactif">Inactive</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Apply</button>
                </form>
            </div>
        </div>

        <!-- Events Grid (Right) -->
        <div class="col-md-9">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for event in evenements %}
                    <div class="col">
                        <div class="card event-card h-100">
                            <!-- Event Image -->
                            <img 
                                src="{{ event.imagename ? asset('uploads/events/' ~ event.imagename) : 'https://via.placeholder.com/300x200?text=No+Image' }}" 
                                class="card-img-top event-img" 
                                alt="{{ event.titre }}"
                            >

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ event.titre }}</h5>
                                <p class="card-text text-muted">{{ event.description|u.truncate(100, '...') }}</p>
                                
                                <!-- Event Meta -->
                                <div class="mt-auto">
                                    <p class="mb-1">
                                        <i class="fas fa-calendar-alt"></i> 
                                        {{ event.dateEvenement|date('d M Y, H:i') }}
                                    </p>
                                    <p class="mb-3">
                                        <i class="fas fa-map-marker-alt"></i> 
                                        {{ event.lieu ?? 'Online' }}
                                    </p>
                                </div>

                                <!-- Button -->
                                <a href="#" class="btn btn-event btn-primary mt-auto">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">No events found.</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}