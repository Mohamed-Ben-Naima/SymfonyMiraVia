<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Espace Client
			{% endblock %}
		</title>

		<!-- Bootstrap CSS -->
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

		<!-- Font Awesome -->
		<link
		rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

		<!-- Custom CSS -->
		<style>:root
		{
			--primary-dark: #013a71;
			--secondary-blue: #81a8c5;
			--accent-green: #7d8c6d;
			--light-beige: #e8e7de;
			--text-dark: #2d3748;
			--sidebar-width: 280px;
		}

		body {
			background-color: var(--light-beige);
			color: var(--text-dark);
		}

		.main-wrapper {
			display: flex;
			min-height: 100vh;
		}

		.sidebar {
			width: var(--sidebar-width);
			background: var(--light-beige);
			box-shadow: 4px 0 15px rgba(0, 0, 0, 0.05);
			transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			z-index: 1020;
		}

		.main-content {
			flex: 1;
			padding: 2rem;
			min-height: 100vh;
		}

		.sidebar-menu-item {
			border-radius: 0.75rem;
			transition: all 0.2s ease;
			color: var(--text-dark);
		}

		.sidebar-menu-item.active {
			background: rgba(1, 58, 113, 0.1) !important;
			color: var(--primary-dark) !important;
			border-left: 4px solid var(--primary-dark);
		}

		.sidebar-menu-item:hover:not(.active) {
			background: rgba(129, 168, 197, 0.1);
			transform: translateX(5px);
		}

		.mobile-toggle-btn {
			width: 45px;
			height: 45px;
			background: var(--primary-dark);
			border-color: var(--primary-dark);
			display: none;
		}

		@media(max-width: 991.98px) {
			.sidebar {
				position: fixed;
				left: calc(-1 * var(--sidebar-width));
				top: 0;
				bottom: 0;
			}

			.sidebar.active {
				left: 0;
				box-shadow: 8px 0 25px rgba(0, 0, 0, 0.1);
			}

			.mobile-toggle-btn {
				display: flex;
				position: fixed;
				bottom: 1.5rem;
				left: 1.5rem;
			}

			.sidebar-backdrop {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.3);
				z-index: 1010;
				opacity: 0;
				visibility: hidden;
				transition: all 0.3s ease;
			}

			.sidebar-backdrop.active {
				opacity: 1;
				visibility: visible;
			}
		}

		.profile-card {
			background: white;
			border-radius: 1rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
			border: 1px solid rgba(1, 58, 113, 0.1);
		}

		.section-title {
			color: var(--primary-dark);
			border-bottom: 2px solid var(--secondary-blue);
			padding-bottom: 0.75rem;
			margin-bottom: 2rem;
		}

		.form-control-custom {
			border: 1px solid var(--secondary-blue);
			border-radius: 0.5rem;
			padding: 0.75rem 1rem;
			transition: all 0.3s ease;
		}

		.form-control-custom:focus {
			border-color: var(--primary-dark);
			box-shadow: 0 0 0 3px rgba(1, 58, 113, 0.1);
		}

		.update-btn {
			background: var(--primary-dark);
			color: white;
			padding: 0.75rem 2rem;
			border-radius: 0.5rem;
			transition: all 0.3s ease;
		}

		.update-btn:hover {
			background: var(--secondary-blue);
		}
	</style>
	{% block stylesheets %}{% endblock %}
</head>
<body>
	{% include 'partials/_navbar.html.twig' %}
	<div
		class="main-wrapper">
		<!-- Sidebar -->
		{% include 'partials/_sidebar2.html.twig' %}

		<!-- Main Content -->
		<main class="main-content">
			{% for type, messages in app.flashes(['success', 'danger', 'warning', 'info', 'primary']) %}
				{% for message in messages %}
					<div class="alert alert-{{ type }} alert-dismissible fade show mb-4 d-flex align-items-center" role="alert">
						<div class="flex-shrink-0">
							<svg class="bi flex-shrink-0 me-3" width="24" height="24" fill="currentColor">
								{% if type == 'success' %}
									<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
								{% elseif type == 'danger' %}
									<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
								{% elseif type == 'warning' %}
									<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
								{% elseif type == 'primary' %}
									<path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
								{% else %}
									<path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
								{% endif %}
							</svg>
						</div>
						<div class="flex-grow-1 pe-3">
							{{ message|raw }}
						</div>
						<button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				{% endfor %}
			{% endfor %}
			<div class="container-fluid"> {% block body %}{% endblock %}
				</div>
			</main>

			<!-- Mobile Backdrop -->
			<div class="sidebar-backdrop"></div>

			<!-- Mobile Toggle Button -->
			<button class="mobile-toggle-btn btn btn-primary rounded-circle shadow-lg d-lg-none">
				<i class="fas fa-bars"></i>
			</button>
		</div>

		<!-- Bootstrap JS -->
		 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

		<!-- Custom JS -->
		 <script>
				        document.addEventListener('DOMContentLoaded', function() {
				            // Toggle sidebar
				            document.querySelector('.mobile-toggle-btn').addEventListener('click', function() {
				                document.querySelector('.sidebar').classList.toggle('active');
				                document.querySelector('.sidebar-backdrop').classList.toggle('active');
				            });
				
				            // Close sidebar on backdrop click
				            document.querySelector('.sidebar-backdrop').addEventListener('click', function() {
				                this.classList.remove('active');
				                document.querySelector('.sidebar').classList.remove('active');
				            });
				
				            // Set active menu item
				            document.querySelectorAll('.sidebar-menu-item').forEach(item => {
				                if(item.href === window.location.href) {
				                    item.classList.add('active');
				                }
				            });
				        });
				    </script>{% block javascripts %}
	{% endblock %}
</body></html>
