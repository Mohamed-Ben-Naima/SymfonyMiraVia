{% extends 'base.html.twig' %}

{% block title %}Utilisateur index{% endblock %}

{% block body %}
    <h1>Utilisateur index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id_utilisateur</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Email</th>
                <th>Mot_de_passe</th>
                <th>Telephone</th>
                <th>Date_inscription</th>
                <th>Type_utilisateur</th>
                <th>Avatar</th>
                <th>Statut_verification</th>
                <th>Status</th>
                <th>Birthday</th>
                <th>Adresse_utilisateur</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for utilisateur in utilisateurs %}
            <tr>
                <td>{{ utilisateur.idUtilisateur }}</td>
                <td>{{ utilisateur.nom }}</td>
                <td>{{ utilisateur.prenom }}</td>
                <td>{{ utilisateur.email }}</td>
                <td>{{ utilisateur.motDePasse }}</td>
                <td>{{ utilisateur.telephone }}</td>
                <td>{{ utilisateur.dateInscription ? utilisateur.dateInscription|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ utilisateur.typeUtilisateur }}</td>
                <td>{{ utilisateur.avatar }}</td>
                <td>{{ utilisateur.statutVerification }}</td>
                <td>{{ utilisateur.status }}</td>
                <td>{{ utilisateur.birthday ? utilisateur.birthday|date('Y-m-d') : '' }}</td>
                <td>{{ utilisateur.adresseUtilisateur }}</td>
                <td>
                    <a href="{{ path('app_utilisateur_show', {'id_utilisateur': utilisateur.id_utilisateur}) }}">show</a>
                    <a href="{{ path('app_utilisateur_edit', {'id_utilisateur': utilisateur.id_utilisateur}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="14">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_utilisateur_new') }}">Create new</a>
{% endblock %}
