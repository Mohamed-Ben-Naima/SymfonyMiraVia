{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste des Partenaires{% endblock %}

{% block body %}
<style>
html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #fdfdfd;
    overflow: hidden; /* Remove vertical scroll */
}

.example-wrapper {
    margin: 0 auto;
    padding: 20px;
    margin-left: 15%;
    max-height: calc(100vh - 40px); /* Dynamically adjust height */
    overflow: visible; /* No internal scroll */
}

.example-wrapper h1 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 40px;
    color: rgb(0, 0, 0);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.search-box {
    position: relative;
    width: 66%;
}

.search-box input {
    width: 100%;
    padding: 8px 30px 8px 12px;
    border: 1px solid #7D8C6D;
    border-radius: 6px;
    font-size: 14px;
}

#statusFilter {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #7D8C6D;
    font-size: 14px;
    margin-left: -1%;
}

.header button {
    padding: 8px 10px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}
.button-unblock {
    background-color: #013A71; /* Couleur bleue */
    color: white; /* Texte blanc */
}

.button-unblock:hover {
    background-color:rgb(38, 86, 131); /* Couleur bleue foncée au survol */
}
.button-block {
    background-color:rgb(146, 151, 155); /* Couleur bleue */
    color: white; /* Texte blanc */
}

.button-block:hover {
    background-color:rgb(116, 118, 120); /* Couleur bleue foncée au survol */
}

.header button:hover {
    background-color: #5c7352;
}

table {
    width: 100%;
    max-width: 100%; /* Prevent overflow */
    border-collapse: collapse;
    font-size: 14px;
    background-color: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.05);
    table-layout: auto; /* Allow columns to adjust */
    overflow-x: auto; /* Enable horizontal scroll if needed */
}

th, td {
    padding: 10px;
    text-align: left;
    word-wrap: break-word; /* Ensure text wraps within cells */
}

th {
    background-color: rgb(176, 203, 223);
    color: black;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

tr:hover {
    background-color: #81A8C5;
    color: white;
}

.actions {
    display: flex;
    gap: 8px;
}

.actions button {
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
}



@media (max-width: 992px) {
    .example-wrapper {
        margin-left: 5%;
        margin-right: 5%;
        padding: 10px;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box,
    #statusFilter,
    .header button {
        width: 100%;
        margin: 5px 0;
    }

    #statusFilter {
        margin-left: 0;
    }

    table {
        font-size: 12px;
    }

    th, td {
        padding: 6px;
    }

    .actions {
        flex-direction: column;
        align-items: flex-start;
    }

    .actions button {
        width: 100%;
        margin-bottom: 4px;
    }
}

@media (max-width: 768px) {
    table {
        display: block;
        overflow-x: auto; /* Enable horizontal scroll for small screens */
        white-space: nowrap; /* Prevent columns from wrapping */
    }
}
/* Styles pour le modal */
.modal {
    display: none; /* Par défaut, le modal est caché */
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5); /* Couleur de fond semi-transparente */
}

.modal-content {
    background-color: #fff;
    margin: 10% auto;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 30%; /* Largeur du modal */
    box-shadow: 0 10px 20px rgba(87, 104, 202, 0.5);
    max-width: 500px; /* Largeur maximale */
    text-align: center;
}

.modal-header {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
}

.modal-body {
    margin-bottom: 20px;
}

.modal-body label {
    display: block;
    margin-bottom: 5px;
    font-size: 14px;
    text-align: left;
    font-weight: bold; /* Rend le texte en gras */
}

.modal-body input,
.modal-body select {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 14px;
}

.modal-footer {
    display: flex;
    justify-content: center; /* Centre les éléments horizontalement */
    gap: 10px; /* Ajoute un espace entre les boutons */
}

.modal-footer button {
    padding: 10px 20px;
    font-size: 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.modal-footer .confirm-btn {
    background-color: #7D8C6D;
    color: white;
}

.modal-footer .confirm-btn:hover {
    background-color: #5c7352;
}

.modal-footer .cancel-btn {
    background-color:  #013A71;;
    color: white;
}

.modal-footer .cancel-btn:hover {
    background-color:rgb(24, 95, 162);
}

/* Style for the close button */
.modal-header .close-btn {
    background: none;
    border: none;
    font-size: 20px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    position: absolute;
    top: 10px;
    right: 10px;
    outline: none;
    transition: color 0.3s ease;
}

.modal-header .close-btn:hover {
    color: #ff0000; /* Red color on hover */
}

</style>
<div class="example-wrapper">
    <h1>Liste des partenaires</h1>

    <div class="header">
        <div class="search-box">
            <input type="text" id="search" placeholder="Rechercher un partenaire...">
        </div>

        <select id="statusFilter">
            <option value="">Tous les statuts</option>
            <option value="Actif">Actif</option>
            <option value="Inactif">Inactif</option>
        </select>

        <button onclick="openModal()">Modifier date d'expiration</button>
    </div>
<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Nom de partenaire</th>
            <th>Téléphone Partenaire</th>
            <th>Email</th>
            <th>Adresse</th>
            <th>Nom d'entreprise</th>
            <th>Date d'expiration</th>
            <th>Type d'activité</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="userTable">
        {% for partenaire in partenaires %}
        <tr>
            <td>{{ partenaire.id_partenaire }}</td>
            <td>{{ partenaire.nom }} {{ partenaire.prenom }}</td>
            <td>{{ partenaire.partenaire_telephone }}</td>
            <td>{{ partenaire.email }}</td>
            <td>{{ partenaire.adresse }}</td>
            <td>{{ partenaire.nom_entreprise }}</td>
            <td>{{ partenaire.date_expiration ? partenaire.date_expiration|date('Y-m-d') : 'N/A' }}</td>
            <td>{{ partenaire.type_activite }}</td>
        <td>{{ partenaire.utilisateur_status }}</td>
            <td class="actions">
                <button class="button-block" onclick="blockUser({{ partenaire.id_partenaire }})">Bloquer</button>
                <button class="button-unblock" onclick="unblockUser({{ partenaire.id_partenaire }})">Débloquer</button>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
</div>

<!-- Modal for updating expiration date -->
<div id="modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            Sélectionner date d'expiration
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
            <p id="successMessageDate" style="color: green; font-size: 13px; display: none; margin-bottom: 10px;">
                La date d'expiration a été modifiée avec succès.
            </p>
            <label for="partnerSelect">Partenaire :</label>
<select id="partnerSelect" required>
    <option value="">-- Sélectionnez un partenaire --</option>
    {% for partenaire in partenaires %}
    <option value="{{ partenaire.id_partenaire }}">{{ partenaire.nom }} {{ partenaire.prenom }}</option>
    {% endfor %}
</select>
            <label for="expirationDate">Date d'expiration :</label>
            <input type="date" id="expirationDate" required>
            <p id="errorMessage" style="color: red; font-size: 13px; display: none; margin-top: 10px;">
                Veuillez remplir tous les champs correctement.
            </p>
        </div>
        <div class="modal-footer">
            <button class="confirm-btn" onclick="confirmExpiration()">Confirmer</button>
            <button class="cancel-btn" onclick="closeModal()">Annuler</button>
        </div>
    </div>
</div>


<!-- Confirmation Modal -->
<div id="actionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            Confirmation
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
            <p id="successMessageAction" style="color: green; font-size: 13px; display: none; margin-bottom: 10px;">
                L'action a été réalisée avec succès.
            </p>
            <p id="actionMessage"></p>
        </div>
        <div class="modal-footer">
            <button class="confirm-btn" onclick="confirmAction()">Confirmer</button>
            <button class="cancel-btn" onclick="closeModal()">Annuler</button>
        </div>
    </div>
</div>



<script>
    let actionCallback; // Variable to store the callback function

function openConfirmationModal(message, callback) {
    const modal = document.getElementById('actionModal'); // Sélectionner le modal
    const actionMessage = document.getElementById('actionMessage'); // Sélectionner l'élément de message
    actionMessage.textContent = message; // Mettre à jour le message dans le modal
    modal.style.display = 'block'; // Afficher le modal
    actionCallback = callback; // Stocker le callback pour l'action de confirmation
}

    // Confirm blocking/unblocking action
function confirmAction() {
    if (typeof actionCallback === 'function') {
        actionCallback(); // Exécuter le callback passé
        const successMessage = document.getElementById('successMessageAction');
        successMessage.style.display = 'block'; // Afficher un message de succès
        setTimeout(() => {
            successMessage.style.display = 'none'; // Masquer le message après 3 secondes
            closeModal(); // Fermer le modal
        }, 3000);
    }
}

function updateStatus(id, status) {
    console.log('Sending data:', { id, status }); // Log les données envoyées

    fetch('/admin/partner/change-status', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ id: id, status: status }),
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
        }
        // Pas besoin de traitement de réponse car le serveur retourne 204 No Content
    })
    .then(() => {
        location.reload(); // Recharger la page entière pour voir les changements
    })
    .catch(error => {
        console.error('Error:', error); // Affiche les erreurs dans la console
    });
}


// Fonction pour bloquer un utilisateur
function blockUser(id) {
    openConfirmationModal(`Êtes-vous sûr de vouloir bloquer l'utilisateur #${id} ?`, function () {
        updateStatus(id, 'Inactif');
    });
}

// Fonction pour débloquer un utilisateur
function unblockUser(id) {
    openConfirmationModal(`Êtes-vous sûr de vouloir débloquer l'utilisateur #${id} ?`, function () {
        updateStatus(id, 'Actif');
    });
}


    // Open date update modal
    function openModal() {
        document.getElementById('modal').style.display = 'block';
        document.getElementById('successMessageDate').style.display = 'none'; // Hide success message
    }

    // Close all modals
    function closeModal() {
        document.querySelectorAll('.modal').forEach(modal => modal.style.display = 'none');
    }

    // Confirm expiration date update
function confirmExpiration() {
    const partnerSelect = document.getElementById('partnerSelect');
    const expirationDate = document.getElementById('expirationDate');
    const errorMessage = document.getElementById('errorMessage');
    const successMessage = document.getElementById('successMessageDate');
    
    const today = new Date().toISOString().split('T')[0]; // Obtenir la date actuelle au format YYYY-MM-DD

    if (partnerSelect.value === "" || expirationDate.value === "") {
        errorMessage.textContent = "Veuillez remplir tous les champs correctement.";
        errorMessage.style.display = 'block';
        successMessage.style.display = 'none'; // Cacher le message de succès
        return;
    }

    if (expirationDate.value < today) {
        errorMessage.textContent = "Veuillez sélectionner une date valide (postérieure ou égale à la date d'aujourd'hui).";
        errorMessage.style.display = 'block';
        successMessage.style.display = 'none'; // Cacher le message de succès
        return;
    }

    // Préparer les données pour l'API
    const data = {
        id: partnerSelect.value,
        expirationDate: expirationDate.value
    };

    // Envoyer les données au serveur
    fetch('/admin/partner/update-expiration', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(data),
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
        }
        return response.json();
    })
    .then(responseData => {
        successMessage.innerText = responseData.message;
        successMessage.style.display = 'block';
        errorMessage.style.display = 'none'; // Cacher le message d'erreur

        setTimeout(() => {
            successMessage.style.display = 'none'; // Cacher le message après 3 secondes
            closeModal(); // Fermer le modal
            location.reload(); // Recharger la page pour voir les changements
        }, 3000);
    })
    .catch(error => {
        console.error('Error:', error);
        errorMessage.textContent = 'Erreur lors de la mise à jour. Veuillez réessayer.';
        errorMessage.style.display = 'block';
    });
}

    // Search and filter table
    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

function filterTable() {
    const searchFilter = document.getElementById('search').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
    const rows = document.querySelectorAll('#userTable tr');

    rows.forEach(row => {
        const cells = row.querySelectorAll('td');
        const textMatch = Array.from(cells) // Vérifie si une cellule contient le texte recherché
            .some(cell => cell.textContent.toLowerCase().includes(searchFilter));
        
        const status = cells[8]?.textContent.toLowerCase().trim(); // 8ème colonne pour le statut
        const statusMatch = statusFilter === "" || status === statusFilter;

        // Affiche ou masque la ligne selon les critères de filtrage
        row.style.display = (textMatch && statusMatch) ? '' : 'none';
    });
}

    // Close modal on Escape key press
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeModal();
    }
});
</script>
{% endblock %}