{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste des Partenaires{% endblock %}

{% block body %}
<style>
html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #fdfdfd;
    overflow: hidden; /* Remove vertical scroll */
}

.example-wrapper {
    margin: 0 auto;
    padding: 20px;
    margin-left: 15%;
    max-height: calc(100vh - 40px); /* Dynamically adjust height */
    overflow: visible; /* No internal scroll */
}

.example-wrapper h1 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 40px;
    color: rgb(0, 0, 0);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.search-box {
    position: relative;
    width: 66%;
}

.search-box input {
    width: 100%;
    padding: 8px 30px 8px 12px;
    border: 1px solid #7D8C6D;
    border-radius: 6px;
    font-size: 14px;
}

#statusFilter {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #7D8C6D;
    font-size: 14px;
    margin-left: -1%;
}

.header button {
    padding: 8px 31px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}
.button-unblock {
    background-color: #013A71; /* Couleur bleue */
    color: white; /* Texte blanc */
    transition: background-color 0.3s ease;
}

.button-unblock:hover {
    background-color: #013A71; /* Couleur bleue foncée au survol */
}

.header button:hover {
    background-color: #5c7352;
}

table {
    width: 100%;
    max-width: 100%; /* Prevent overflow */
    border-collapse: collapse;
    font-size: 14px;
    background-color: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.05);
    table-layout: auto; /* Allow columns to adjust */
    overflow-x: auto; /* Enable horizontal scroll if needed */
}

th, td {
    padding: 10px;
    text-align: left;
    word-wrap: break-word; /* Ensure text wraps within cells */
}

th {
    background-color: rgb(176, 203, 223);
    color: black;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

tr:hover {
    background-color: #81A8C5;
    color: white;
}

.actions {
    display: flex;
    gap: 8px;
}

.actions button {
    background-color: #ccc;
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
}

.actions button:hover {
    background-color: #999;
    color: white;
}

@media (max-width: 992px) {
    .example-wrapper {
        margin-left: 5%;
        margin-right: 5%;
        padding: 10px;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box,
    #statusFilter,
    .header button {
        width: 100%;
        margin: 5px 0;
    }

    #statusFilter {
        margin-left: 0;
    }

    table {
        font-size: 12px;
    }

    th, td {
        padding: 6px;
    }

    .actions {
        flex-direction: column;
        align-items: flex-start;
    }

    .actions button {
        width: 100%;
        margin-bottom: 4px;
    }
}

@media (max-width: 768px) {
    table {
        display: block;
        overflow-x: auto; /* Enable horizontal scroll for small screens */
        white-space: nowrap; /* Prevent columns from wrapping */
    }
}
</style>
<div class="example-wrapper">
    <h1>Liste des partenaires</h1>

    <div class="header">
        <div class="search-box">
            <input type="text" id="search" placeholder="Rechercher un partenaire...">
        </div>

        <select id="statusFilter">
            <option value="">Tous les statuts</option>
            <option value="Actif">Actif</option>
            <option value="Inactif">Inactif</option>
        </select>

        <button onclick="addUser()">Modifier date d'expiration</button>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nom de partenaire</th>
                <th>Téléphone</th>
                <th>Email</th>
                <th>Adresse</th>
                <th>Nom d'entreprise</th>
                <th>Date d'expiration</th>
                <th>Type d'activité</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="userTable">
            {% for i in 1..30 %}
            <tr>
                <td>{{ i }}</td>
                <td>Mark</td>
                <td>Otto</td>
                <td>@mdo</td>
                <td>Adresse {{ i }}</td>
                <td>Entreprise {{ i }}</td>
                <td>2025-12-31</td>
                <td>Commerce</td>
                <td>{{ i is even ? 'Actif' : 'Inactif' }}</td>
                <td class="actions">
                    <button onclick="editUser({{ i }})">Bloquer</button>
<button class="button-unblock" onclick="deleteUser({{ i }})">Débloquer</button>                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
    function addUser() {
        alert('Ajouter un nouvel utilisateur');
    }

    function editUser(id) {
        alert('Modifier utilisateur #' + id);
    }

    function deleteUser(id) {
        if (confirm('Voulez-vous vraiment supprimer l’utilisateur #' + id + ' ?')) {
            alert('Utilisateur supprimé');
        }
    }

    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

    function filterTable() {
        const searchFilter = document.getElementById('search').value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value;
        const rows = document.querySelectorAll('#userTable tr');

        rows.forEach(row => {
            const cells = row.querySelectorAll('td');
            const textMatch = Array.from(cells).slice(0, 9)
                .some(cell => cell.textContent.toLowerCase().includes(searchFilter));

            const status = cells[8].textContent.trim();
            const statusMatch = statusFilter === "" || status === statusFilter;

            row.style.display = (textMatch && statusMatch) ? '' : 'none';
        });
    }
</script>
{% endblock %}
