{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste des Partenaires{% endblock %}

{% block body %}
<style>
html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #fdfdfd;
    overflow: hidden;
    transition: background-color 0.3s ease, color 0.3s ease;
}

body.dark-mode {
    background-color: #1a202c;
    color: #e2e8f0;
}

.example-wrapper {
    margin: 0 auto;
    padding: 20px;
    margin-left: 15%;
    max-height: calc(100vh - 40px);
    overflow: visible;
}

.example-wrapper h1 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 40px;
    color: rgb(0, 0, 0);
}

body.dark-mode .example-wrapper h1 {
    color: #e2e8f0;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.search-box {
    position: relative;
    width: 66%;
}

.search-box input {
    width: 100%;
    padding: 8px 30px 8px 12px;
    border: 1px solid #7D8C6D;
    border-radius: 6px;
    font-size: 14px;
    background-color: #fff;
    color: #000;
}

body.dark-mode .search-box input {
    background-color: #4a5568;
    border-color: #718096;
    color: #e2e8f0;
}

#statusFilter {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #7D8C6D;
    font-size: 14px;
    margin-left: -1%;
    background-color: #fff;
    color: #000;
}

body.dark-mode #statusFilter {
    background-color: #4a5568;
    border-color: #718096;
    color: #e2e8f0;
}

.header button {
    padding: 8px 10px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

body.dark-mode .header button {
    background-color: #4a90e2;
}

.header button:hover {
    background-color: #5c7352;
}

body.dark-mode .header button:hover {
    background-color: #357abd;
}

.button-unblock {
    background-color: #013A71;
    color: white;
}

body.dark-mode .button-unblock {
    background-color: #4a90e2;
}

.button-unblock:hover {
    background-color: rgb(38, 86, 131);
}

body.dark-mode .button-unblock:hover {
    background-color: #357abd;
}

.button-block {
    background-color: rgb(146, 151, 155);
    color: white;
}

body.dark-mode .button-block {
    background-color: #718096;
}

.button-block:hover {
    background-color: rgb(116, 118, 120);
}

body.dark-mode .button-block:hover {
    background-color: #4a5568;
}

table {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background-color: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.05);
    table-layout: auto;
    overflow-x: auto;
}

body.dark-mode table {
    background-color: #2d3748;
    box-shadow: 0 0 8px rgba(0,0,0,0.3);
}

th, td {
    padding: 10px;
    text-align: left;
    word-wrap: break-word;
}

th {
    background-color: rgb(176, 203, 223);
    color: black;
}

body.dark-mode th {
    background-color: #4a5568;
    color: #e2e8f0;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

body.dark-mode tr:nth-child(even) {
    background-color: #2d3748;
}

tr:hover {
    background-color: #81A8C5;
    color: white;
}

body.dark-mode tr:hover {
    background-color: #4a90e2;
    color: #e2e8f0;
}

.actions {
    display: flex;
    gap: 8px;
}

.actions button {
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
}

@media (max-width: 992px) {
    .example-wrapper {
        margin-left: 5%;
        margin-right: 5%;
        padding: 10px;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box,
    #statusFilter,
    .header button {
        width: 100%;
        margin: 5px 0;
    }

    #statusFilter {
        margin-left: 0;
    }

    table {
        font-size: 12px;
    }

    th, td {
        padding: 6px;
    }

    .actions {
        flex-direction: column;
        align-items: flex-start;
    }

    .actions button {
        width: 100%;
        margin-bottom: 4px;
    }
}

@media (max-width: 768px) {
    table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }
}

.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
    background-color: #fff;
    margin: 10% auto;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 30%;
    box-shadow: 0 10px 20px rgba(87, 104, 202, 0.5);
    max-width: 500px;
    text-align: center;
}

body.dark-mode .modal-content {
    background-color: #2d3748;
    border-color: #4a5568;
    color: #e2e8f0;
}

.modal-header {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
}

body.dark-mode .modal-header {
    color: #e2e8f0;
}

.modal-header .close-btn {
    background: none;
    border: none;
    font-size: 20px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    position: absolute;
    top: 10px;
    right: 10px;
    outline: none;
    transition: color 0.3s ease;
}

body.dark-mode .modal-header .close-btn {
    color: #e2e8f0;
}

.modal-header .close-btn:hover {
    color: #ff0000;
}

.modal-body {
    margin-bottom: 20px;
}

.modal-body label {
    display: block;
    margin-bottom: 5px;
    font-size: 14px;
    text-align: left;
    font-weight: bold;
    color: #333;
}

body.dark-mode .modal-body label {
    color: #e2e8f0;
}

.modal-body input,
.modal-body select {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 14px;
    background-color: #fff;
    color: #000;
}

body.dark-mode .modal-body input,
body.dark-mode .modal-body select {
    background-color: #4a5568;
    border-color: #718096;
    color: #e2e8f0;
}

.modal-footer {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.modal-footer button {
    padding: 10px 20px;
    font-size: 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.modal-footer .confirm-btn {
    background-color: #7D8C6D;
    color: white;
}

body.dark-mode .modal-footer .confirm-btn {
    background-color: #4a90e2;
}

.modal-footer .confirm-btn:hover {
    background-color: #5c7352;
}

body.dark-mode .modal-footer .confirm-btn:hover {
    background-color: #357abd;
}

.modal-footer .cancel-btn {
    background-color: #013A71;
    color: white;
}

body.dark-mode .modal-footer .cancel-btn {
    background-color: #4a90e2;
}

.modal-footer .cancel-btn:hover {
    background-color: rgb(24, 95, 162);
}

body.dark-mode .modal-footer .cancel-btn:hover {
    background-color: #357abd;
}
</style>

<div class="example-wrapper">
    <h1>Liste des partenaires</h1>

    <div class="header">
        <div class="search-box">
            <input type="text" id="search" placeholder="Rechercher un partenaire...">
        </div>
        <select id="statusFilter">
            <option value="">Tous les statuts</option>
            <option value="Actif">Actif</option>
            <option value="Inactif">Inactif</option>
        </select>
        <button onclick="openModal()">Modifier date d'expiration</button>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nom de partenaire</th>
                <th>Téléphone Partenaire</th>
                <th>Email</th>
                <th>Adresse</th>
                <th>Nom d'entreprise</th>
                <th>Date d'expiration</th>
                <th>Type d'activité</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="userTable">
            {% for partenaire in partenaires %}
            <tr>
                <td>{{ partenaire.id_partenaire }}</td>
                <td>{{ partenaire.nom }} {{ partenaire.prenom }}</td>
                <td>{{ partenaire.partenaire_telephone }}</td>
                <td>{{ partenaire.email }}</td>
                <td>{{ partenaire.adresse }}</td>
                <td>{{ partenaire.nom_entreprise }}</td>
                <td>{{ partenaire.date_expiration ? partenaire.date_expiration|date('Y-m-d') : 'N/A' }}</td>
                <td>{{ partenaire.type_activite }}</td>
                <td>{{ partenaire.utilisateur_statut_verification }}</td>
                <td class="actions">
                    <button class="button-block" onclick="blockUser({{ partenaire.id_partenaire }})">Bloquer</button>
                    <button class="button-unblock"  onclick="unblockUser({{ partenaire.id_partenaire }})">Débloquer</button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Modal for updating expiration date -->
<div id="modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            Sélectionner date d'expiration
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
            <p id="successMessageDate" style="color: green; font-size: 13px; display: none; margin-bottom: 10px;">
                La date d'expiration a été modifiée avec succès.
            </p>
            <label for="partnerSelect">Partenaire :</label>
            <select id="partnerSelect" required>
                <option value="">-- Sélectionnez un partenaire --</option>
                {% for partenaire in partenaires %}
                <option value="{{ partenaire.id_partenaire }}">{{ partenaire.nom }} {{ partenaire.prenom }}</option>
                {% endfor %}
            </select>
            <label for="expirationDate">Date d'expiration :</label>
            <input type="date" id="expirationDate" required>
            <p id="errorMessage" style="color: red; font-size: 13px; display: none; margin-top: 10px;">
                Veuillez remplir tous les champs correctement.
            </p>
        </div>
        <div class="modal-footer">
            <button class="confirm-btn" onclick="confirmExpiration()">Confirmer</button>
            <button class="cancel-btn" onclick="closeModal()">Annuler</button>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="actionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            Confirmation
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
            <p id="successMessageAction" style="color: green; font-size: 13px; display: none; margin-bottom: 10px;">
                L'action a été réalisée avec succès.
            </p>
            <p id="actionMessage"></p>
        </div>
        <div class="modal-footer">
            <button class="confirm-btn" onclick="confirmAction()">Confirmer</button>
            <button class="cancel-btn" onclick="closeModal()">Annuler</button>
        </div>
    </div>
</div>

<script>
function toggleDarkMode() {
    document.body.classList.toggle('dark-mode');
    localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
}

document.addEventListener('DOMContentLoaded', () => {
    // Apply dark mode if previously selected
    if (localStorage.getItem('darkMode') === 'true') {
        document.body.classList.add('dark-mode');
    }

    let actionCallback;

    function openConfirmationModal(message, callback) {
        const modal = document.getElementById('actionModal');
        const actionMessage = document.getElementById('actionMessage');
        actionMessage.textContent = message;
        modal.style.display = 'block';
        actionCallback = callback;
    }

    function confirmAction() {
        if (typeof actionCallback === 'function') {
            actionCallback();
            const successMessage = document.getElementById('successMessageAction');
            successMessage.style.display = 'block';
            setTimeout(() => {
                successMessage.style.display = 'none';
                closeModal();
            }, 3000);
        }
    }

function updateStatus(id, statut_verification) {
    console.log('Sending data:', { id, statut_verification });

    fetch('/admin/partner/change-status', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ id: id, statut_verification: statut_verification }),
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
        }
    })
    .then(() => {
        location.reload();
    })
    .catch(error => {
        console.error('Error:', error);
    });
}

    function blockUser(id) {
        openConfirmationModal(`Êtes-vous sûr de vouloir bloquer l'utilisateur #${id} ?`, function () {
            updateStatus(id, 'Inactif');
        });
    }

    function unblockUser(id) {
        openConfirmationModal(`Êtes-vous sûr de vouloir débloquer l'utilisateur #${id} ?`, function () {
            updateStatus(id, 'Actif');
        });
    }

    function openModal() {
        document.getElementById('modal').style.display = 'block';
        document.getElementById('successMessageDate').style.display = 'none';
    }

    function closeModal() {
        document.querySelectorAll('.modal').forEach(modal => modal.style.display = 'none');
    }

    function confirmExpiration() {
        const partnerSelect = document.getElementById('partnerSelect');
        const expirationDate = document.getElementById('expirationDate');
        const errorMessage = document.getElementById('errorMessage');
        const successMessage = document.getElementById('successMessageDate');
        
        const today = new Date().toISOString().split('T')[0];

        if (partnerSelect.value === "" || expirationDate.value === "") {
            errorMessage.textContent = "Veuillez remplir tous les champs correctement.";
            errorMessage.style.display = 'block';
            successMessage.style.display = 'none';
            return;
        }

        if (expirationDate.value < today) {
            errorMessage.textContent = "Veuillez sélectionner une date valide (postérieure ou égale à la date d'aujourd'hui).";
            errorMessage.style.display = 'block';
            successMessage.style.display = 'none';
            return;
        }

        const data = {
            id: partnerSelect.value,
            expirationDate: expirationDate.value
        };

        fetch('/admin/partner/update-expiration', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify(data),
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }
            return response.json();
        })
        .then(responseData => {
            successMessage.textContent = responseData.message;
            successMessage.style.display = 'block';
            errorMessage.style.display = 'none';
            setTimeout(() => {
                successMessage.style.display = 'none';
                closeModal();
                location.reload();
            }, 3000);
        })
        .catch(error => {
            console.error('Error:', error);
            errorMessage.textContent = 'Erreur lors de la mise à jour. Veuillez réessayer.';
            errorMessage.style.display = 'block';
        });
    }

    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

    function filterTable() {
        const searchFilter = document.getElementById('search').value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
        const rows = document.querySelectorAll('#userTable tr');

        rows.forEach(row => {
            const cells = row.querySelectorAll('td');
            const textMatch = Array.from(cells)
                .some(cell => cell.textContent.toLowerCase().includes(searchFilter));
            const status = cells[8]?.textContent.toLowerCase().trim();
            const statusMatch = statusFilter === "" || status === statusFilter;

            row.style.display = (textMatch && statusMatch) ? '' : 'none';
        });
    }

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeModal();
        }
    });

    // Expose functions globally for HTML onclick
    window.blockUser = blockUser;
    window.unblockUser = unblockUser;
    window.openModal = openModal;
    window.closeModal = closeModal;
    window.confirmExpiration = confirmExpiration;
    window.confirmAction = confirmAction;
});
</script>
{% endblock %}