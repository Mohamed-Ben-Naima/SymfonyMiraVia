{% extends 'baseAdmin.html.twig' %}

{% block title %}Paramètres Administrateur{% endblock %}

{% block body %}
<style>
    /* Wrapper for the settings page */
    .settings-wrapper {
        margin: 2rem auto;
        max-width: calc(100% - 250px);
        margin-left: 250px;
        font-family: 'Arial', sans-serif;
    }

    .settings-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .settings-header h1 {
        font-size: 2.5rem;
        color: #374151;
        position: relative;
        display: inline-block;
    }

    .settings-header h1::after {
        content: "";
        display: block;
        width: 50%;
        height: 4px;
        background-color: #013A71;
        margin: 0.5rem auto 0;
        border-radius: 2px;
        animation: slide-in 1s ease-in-out;
    }

    @keyframes slide-in {
        from {
            width: 0;
        }
        to {
            width: 50%;
        }
    }

    .settings-container {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        justify-content: space-around;
    }

    .settings-card {
        flex: 1 1 calc(33% - 2rem);
        background-color: #ffffff;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 0.5rem;
        padding: 1.5rem;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    .settings-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.2);
    }

    .settings-card i {
        font-size: 3rem;
        color: #013A71;
        margin-bottom: 1rem;
        animation: bounce 2s infinite;
    }

    @keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    .settings-card h3 {
        font-size: 1.5rem;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .settings-card p {
        font-size: 1rem;
        color: #6b7280;
    }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content {
        background-color: #fff;
        margin: 10% auto;
        padding: 20px;
        border-radius: 12px;
        width: 50%;
        text-align: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

    .close:hover,
    .close:focus {
        color: black;
        text-decoration: none;
        cursor: pointer;
    }

    /* Toggle Switch */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
        margin-top: 15px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: 0.4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: 0.4s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: #013A71;
    }

    input:checked + .slider:before {
        transform: translateX(26px);
    }

    .modal-header {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 1rem;
    }

    .modal-body {
        font-size: 1rem;
        color: #6b7280;
        margin-bottom: 1rem;
    }

    .modal-footer {
        display: flex;
        justify-content: center;
        gap: 1rem;
    }

    .modal-footer button {
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .modal-footer button.primary {
        background-color: #013A71;
        color: white;
    }

    .modal-footer button.primary:hover {
        background-color: #00509e;
    }

    .modal-footer button.secondary {
        background-color: #e5e7eb;
        color: #374151;
    }

    .modal-footer button.secondary:hover {
        background-color: #d1d5db;
    }

    .notification-settings {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
        margin-top: 1rem;
    }

    .notification-settings label {
        font-size: 1rem;
        color: #374151;
    }

    .notification-settings select {
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
        width: 100%;
    }

    .notification-settings input[type="checkbox"] {
        margin-right: 0.5rem;
    }
</style>
<div class="settings-wrapper">
    <div class="settings-header">
        <h1>Paramètres </h1>
        <p>Gérez vos paramètres </p>
    </div>

    <div class="settings-container">
        <!-- Card 1 -->
        <div class="settings-card" onclick="openModal('user-settings-modal')">
            <i class="fas fa-user-cog"></i>
            <h3>Profile</h3>
            <p>Gérez profile.</p>
        </div>

        <!-- Card 2 -->
        <div class="settings-card" onclick="openModal('notifications-modal')">
            <i class="fas fa-bell"></i>
            <h3>Notifications</h3>
            <p>Configurez vos préférences de notifications.</p>
        </div>

        <!-- Card 3 -->
        <div class="settings-card" onclick="openModal('database-modal')">
            <i class="fas fa-database"></i>
            <h3>Base de Données</h3>
            <p>Effectuez des sauvegardes et restaurez vos données.</p>
        </div>

        <!-- Card 4 -->
        <div class="settings-card" onclick="openModal('customization-modal')">
            <i class="fas fa-paint-brush"></i>
            <h3>Personnalisation</h3>
            <p>Changez le thème et les couleurs de l'interface.</p>
        </div>

        <!-- Card 5 -->
        <div class="settings-card" onclick="openModal('security-modal')">
            <i class="fas fa-lock"></i>
            <h3>Sécurité</h3>
            <p>Mettez à jour les mots de passe et les politiques de sécurité.</p>
        </div>

        <!-- Card 6 -->
        <div class="settings-card" onclick="openModal('statistics-modal')">
            <i class="fas fa-chart-line"></i>
            <h3>Statistiques</h3>
            <p>Consultez les rapports et les performances.</p>
        </div>
    </div>
</div>

<!-- Profile Modal -->
<div id="user-settings-modal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('user-settings-modal')">&times;</span>
        <div class="modal-header">Modifier le Profil</div>
        <div class="modal-body">
            <p>Accédez à la page de modification de votre profil en cliquant sur le bouton ci-dessous.</p>
        </div>
        <div class="modal-footer">
            <a href="{{ path('app_admin_profil') }}">
                <button class="primary">Modifier le Profil</button>
            </a>
            <button class="secondary" onclick="closeModal('user-settings-modal')">Annuler</button>
        </div>
    </div>
</div>

<script>
    function openModal(modalId) {
        document.getElementById(modalId).style.display = "block";
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = "none";
    }
</script>

</div>

<!-- Notifications Modal -->
<div id="notifications-modal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('notifications-modal')">&times;</span>
        <div class="modal-header">Notifications</div>
        <div class="modal-body">
            <p>Configurez vos préférences de notifications.</p>
            <div class="notification-settings">
                <label>
                    <input type="checkbox" id="email-notifications">
                    Activer les notifications par e-mail
                </label>
                <label>
                    <input type="checkbox" id="sms-notifications">
                    Activer les notifications par SMS
                </label>
                <label>
                    <input type="checkbox" id="push-notifications">
                    Activer les notifications push
                </label>
                <label for="frequency">Fréquence des notifications :</label>
                <select id="frequency">
                    <option value="immediate">Immédiatement</option>
                    <option value="daily">Quotidiennement</option>
                    <option value="weekly">Hebdomadairement</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="primary" onclick="saveNotificationSettings()">Enregistrer</button>
            <button class="secondary" onclick="closeModal('notifications-modal')">Annuler</button>
        </div>
    </div>
</div>

<script>
    function openModal(modalId) {
        document.getElementById(modalId).style.display = "block";
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = "none";
    }

    function saveNotificationSettings() {
        const emailEnabled = document.getElementById('email-notifications').checked;
        const smsEnabled = document.getElementById('sms-notifications').checked;
        const pushEnabled = document.getElementById('push-notifications').checked;
        const frequency = document.getElementById('frequency').value;

        alert(`Paramètres enregistrés :
            E-mail : ${emailEnabled ? 'Activé' : 'Désactivé'}
            SMS : ${smsEnabled ? 'Activé' : 'Désactivé'}
            Push : ${pushEnabled ? 'Activé' : 'Désactivé'}
            Fréquence : ${frequency}`);
        closeModal('notifications-modal');
    }
</script>

<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
{% endblock %}