    function openModal(modalId) {
        document.getElementById(modalId).style.display = "block";
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = "none";
    }

    function applyLanguage() {
        const language = localStorage.getItem('language') || 'fr';
        document.querySelectorAll('[data-translate]').forEach(element => {
            const key = element.getAttribute('data-translate');
            element.textContent = translations[language][key] || element.textContent;
        });
    }

    function saveNotificationSettings() {
        const emailEnabled = document.getElementById('email-notifications').checked;
        const smsEnabled = document.getElementById('sms-notifications').checked;
        const pushEnabled = document.getElementById('push-notifications').checked;
        const frequency = document.getElementById('frequency').value;

        alert(`Paramètres enregistrés :
            E-mail : ${emailEnabled ? translations[localStorage.getItem('language') || 'fr'].enabled : translations[localStorage.getItem('language') || 'fr'].disabled}
            SMS : ${smsEnabled ? translations[localStorage.getItem('language') || 'fr'].enabled : translations[localStorage.getItem('language') || 'fr'].disabled}
            Push : ${pushEnabled ? translations[localStorage.getItem('language') || 'fr'].enabled : translations[localStorage.getItem('language') || 'fr'].disabled}
            Fréquence : ${translations[localStorage.getItem('language') || 'fr'][frequency] || frequency}`);
        closeModal('notifications-modal');
    }

    function saveLanguageSettings() {
        const language = document.getElementById('language').value;
        localStorage.setItem('language', language);
        applyLanguage();
        alert(`Paramètres enregistrés : Langue : ${language === 'fr' ? translations.fr.french : translations.en.english}`);
        closeModal('language-modal');
        // Trigger a custom event to notify other parts of the platform
        const languageChangeEvent = new Event('languageChange');
        document.dispatchEvent(languageChangeEvent);
    }

    function toggleDarkMode() {
        const isDarkMode = document.getElementById('dark-mode-toggle').checked;
        document.body.classList.toggle('dark-mode', isDarkMode);
        localStorage.setItem('darkMode', isDarkMode);
    }

    function saveCustomizationSettings() {
        const isDarkMode = document.getElementById('dark-mode-toggle').checked;
        localStorage.setItem('darkMode', isDarkMode);
        alert(`Paramètres enregistrés : Mode sombre ${isDarkMode ? translations[localStorage.getItem('language') || 'fr'].enabled : translations[localStorage.getItem('language') || 'fr'].disabled}`);
        closeModal('customization-modal');
    }

    function generateReport() {
        const reportType = document.getElementById('report-type').value;
        const reportPeriod = document.getElementById('report-period').value;
        const language = localStorage.getItem('language') || 'fr';

        alert(`Rapport généré :
            Type : ${translations[language][reportType] || reportType}
            Période : ${translations[language][reportPeriod] || reportPeriod}`);
        closeModal('statistics-modal');
    }

    function downloadReport() {
        const reportType = document.getElementById('report-type').value;
        const reportPeriod = document.getElementById('report-period').value;
        const language = localStorage.getItem('language') || 'fr';

        alert(`Téléchargement du rapport :
            Type : ${translations[language][reportType] || reportType}
            Période : ${translations[language][reportPeriod] || reportPeriod}
            Format : PDF/CSV`);
        closeModal('statistics-modal');
    }

    document.addEventListener('DOMContentLoaded', () => {
        const savedLanguage = localStorage.getItem('language') || 'fr';
        document.getElementById('language').value = savedLanguage;
        applyLanguage();

        const savedDarkMode = localStorage.getItem('darkMode') === 'true';
        document.getElementById('dark-mode-toggle').checked = savedDarkMode;
        document.body.classList.toggle('dark-mode', savedDarkMode);

        // Ensure language is applied to all modals
        document.addEventListener('languageChange', () => {
            applyLanguage();
        });
    });
</script>

