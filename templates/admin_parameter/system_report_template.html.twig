{# templates/admin_parameter/report_template.html.twig #}

{# HTML document structure for the PDF report generated by MPDF #}
<!DOCTYPE html>
<html lang="fr">
<head>
    {# Set UTF-8 encoding for proper character rendering in the PDF #}
    <meta charset="UTF-8">
    {# Title of the PDF document #}
    <title>Rapport de Performance</title>
    <style>
        {# Body styling for the PDF #}
        body {
            font-family: Arial, sans-serif; /* Arial for a clean, professional look */
            margin: 20px; /* Margin around the content */
            color: #333; /* Dark gray text for readability */
        }
        {# Main heading style #}
        h1 {
            color: #013A71; /* Blue color matching the application's theme */
            text-align: center; /* Center the title */
            border-bottom: 2px solid #013A71; /* Blue underline */
            padding-bottom: 10px; /* Space below the title */
        }
        {# Subheading style #}
        h2 {
            color: #374151; /* Darker gray for subheadings */
            margin-top: 20px; /* Space above subheadings */
        }
        {# Styling for the report details section (type, period, date) #}
        .report-details {
            margin: 20px 0; /* Vertical spacing */
            font-size: 14px; /* Smaller font for details */
        }
        .report-details p {
            margin: 5px 0; /* Spacing between detail lines */
        }
        {# Styling for the metrics table #}
        .metrics-table {
            width: 100%; /* Full-width table */
            border-collapse: collapse; /* Remove gaps between cells */
            margin-top: 20px; /* Space above the table */
        }
        .metrics-table th, .metrics-table td {
            border: 1px solid #d1d5db; /* Light gray border */
            padding: 10px; /* Padding inside cells */
            text-align: left; /* Left-align text */
        }
        .metrics-table th {
            background-color: #013A71; /* Blue background for headers */
            color: white; /* White text for contrast */
        }
        .metrics-table tr:nth-child(even) {
            background-color: #f8fafc; /* Light gray for even rows */
        }
        {# Footer styling #}
        .footer {
            margin-top: 40px; /* Space above footer */
            text-align: center; /* Center footer text */
            font-size: 12px; /* Smaller font */
            color: #6b7280; /* Gray text */
        }
    </style>
</head>
<body>
    {# Main report title #}
    <h1>Rapport de Performance</h1>

    {# Report metadata section #}
    <div class="report-details">
        {# Report type, translated based on the controller's 'report.type' value #}
        <p><strong>Type de Rapport:</strong> {{ report.type|trans({
            'users': 'Rapport des utilisateurs',
            'activity': 'Rapport d\'activité',
            'system': 'Rapport de performance système'
        }) }}</p>
        {# Report period, translated based on the controller's 'report.period' value #}
        <p><strong>Période:</strong> {{ report.period|trans({
            'today': 'Aujourd\'hui',
            'week': 'Dernière semaine',
            'month': 'Dernier mois',
            'custom': 'Personnalisé'
        }) }}</p>
        {# Date and time the report was generated #}
        <p><strong>Généré le:</strong> {{ report.generated_at }}</p>
    </div>

    {# Key metrics section #}
    <h2>Métriques Clés</h2>
    {# Table displaying the metrics passed from the controller #}
    <table class="metrics-table">
        <thead>
            <tr>
                <th>Métrique</th>
                <th>Valeur</th>
            </tr>
        </thead>
        <tbody>
            {# Active users metric #}
            <tr>
                <td>Utilisateurs Actifs</td>
                <td>{{ report.metrics.active_users }}</td>
            </tr>
            {# Average time metric #}
            <tr>
                <td>Temps Moyen</td>
                <td>{{ report.metrics.average_time }}</td>
            </tr>
            {# Total time spent metric #}
            <tr>
                <td>Temps Passé</td>
                <td>{{ report.metrics.time_spent }}</td>
            </tr>
        </tbody>
    </table>

    {# Footer with generation notice and copyright #}
    <div class="footer">
        <p>Généré par le système d'administration</p>
        <p>© {{ "now"|date("Y") }} Votre Entreprise</p>
    </div>
</body>
</html>