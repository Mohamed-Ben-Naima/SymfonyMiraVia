{% block stylesheets %}
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
            /* Ensure body takes full page if base.html.twig doesn't enforce bg color */
            background-color: #E8E7DE; 
            color: #013A71;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #81A8C5; 
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #7D8C6D; 
        }
        .fade-in-section {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
        }
        .fade-in-section.is-visible {
            opacity: 1;
            transform: translateY(0);
        }
        .card-hover-effect {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card-hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        .btn-primary {
            background-color: #81A8C5; 
            color: white;
            transition: background-color 0.3s ease;
        }
        .btn-primary:hover {
            background-color: #7D8C6D; 
        }
        .btn-secondary {
            background-color: transparent;
            color: #013A71; 
            border: 2px solid #013A71; 
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        .btn-secondary:hover {
            background-color: #013A71; 
            color: white;
        }
        .spinner {
            border: 4px solid rgba(0, 0, 0, 0.1);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border-left-color: #81A8C5; 
            animation: spin 1s ease infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .prose h4 {
            color: #013A71;
            margin-top: 1rem;
            margin-bottom: 0.5rem;
        }
        .prose ul {
            list-style-type: disc;
            margin-left: 1.5rem;
            color: #374151;
        }
        .prose p {
            color: #374151;
        }

        /* Keyframe animations for hero text (moved from JS to CSS for better separation) */
        @keyframes fadeInDown {
            0% { opacity: 0; transform: translateY(-20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-down { animation: fadeInDown 0.8s ease-out forwards; }

        @keyframes fadeInUp {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up { animation: fadeInUp 0.8s ease-out forwards; }
    </style>
{% endblock %}

