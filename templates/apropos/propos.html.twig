{% block javascripts %}
    <script>
        // Intersection Observer API animations
        const sections = document.querySelectorAll('.fade-in-section');
        const observerOptions = {
            root: null, 
            rootMargin: '0px',
            threshold: 0.1 
        };

        const observer = new IntersectionObserver((entries, obs) => { 
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    // Optional: unobserve after animation to save resources
                    // obs.unobserve(entry.target); 
                }
            });
        }, observerOptions);

        sections.forEach(section => {
            observer.observe(section);
        });

        // Gemini API Integration for Event Inspiration
        const generateEventIdeasBtn = document.getElementById('generateEventIdeasBtn');
        const eventIdeaInput = document.getElementById('eventIdeaInput');
        const eventIdeasResultDiv = document.getElementById('eventIdeasResult');
        const eventLoadingSpinner = document.getElementById('eventLoadingSpinner');
        const eventErrorMessageDiv = document.getElementById('eventErrorMessage');

        // API Key passed from Symfony Controller
        // The |e('js') filter is crucial for security to escape characters for JavaScript context.
        const apiKey = "{{ gemini_api_key|e('js') }}"; 

        // Check if API key is provided. If not, you might want to disable the feature or show a message.
        if (!apiKey) {
            console.warn("Gemini API Key is not configured. Event inspiration feature might not work.");
            // Optionally disable the button or show a message to the user
            // if (generateEventIdeasBtn) generateEventIdeasBtn.disabled = true;
        }
        
        // The API URL already has `?key=${apiKey}` at the end.
        // Make sure your full API URL including the model is correct.
        // Example: https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key=YOUR_API_KEY
        // For gemini-2.0-flash it would be:
        const modelName = "gemini-1.5-flash-latest"; // Or "gemini-pro" or the specific model you intend to use
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`;


        if (generateEventIdeasBtn) { // Check if the button exists on the page
            generateEventIdeasBtn.addEventListener('click', async () => {
                const userEventIdea = eventIdeaInput.value.trim();
                if (!userEventIdea) {
                    eventErrorMessageDiv.textContent = "Veuillez entrer une description de votre idée d'événement.";
                    eventErrorMessageDiv.classList.remove('hidden');
                    eventIdeasResultDiv.classList.add('hidden');
                    return;
                }

                if (!apiKey) {
                    eventErrorMessageDiv.textContent = "La fonctionnalité de génération d'idées n'est pas disponible (clé API manquante).";
                    eventErrorMessageDiv.classList.remove('hidden');
                    eventIdeasResultDiv.classList.add('hidden');
                    return;
                }

                eventIdeasResultDiv.classList.add('hidden');
                eventErrorMessageDiv.classList.add('hidden');
                eventLoadingSpinner.classList.remove('hidden');
                generateEventIdeasBtn.disabled = true;
                
                const eventPrompt = `En tant qu'expert en communication pour des causes sociales, suggère 3 idées créatives et engageantes pour un événement basé sur la description suivante : "${userEventIdea}". 
                Pour chaque idée, propose :
                1. Un titre accrocheur pour l'événement.
                2. Une courte description (2-3 phrases) pour promouvoir l'événement.
                3. Une suggestion d'activité principale.
                4. Une idée pour engager les bénévoles.
                5. Une idée pour encourager les dons (si applicable).
                Formate la réponse en HTML avec des titres (h4) pour chaque idée et des listes à puces pour les détails. Assure-toi que le HTML est valide et bien structuré.`;

                // Using the simpler generateContent structure for Gemini API
                const eventPayload = {
                    contents: [{
                        parts: [{ text: eventPrompt }]
                    }]
                    // You can add generationConfig if needed, e.g.:
                    // generationConfig: {
                    //   temperature: 0.7,
                    //   topK: 1,
                    //   topP: 1,
                    //   maxOutputTokens: 8192,
                    // },
                    // safetySettings: [ /* configure as needed */ ]
                };

                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(eventPayload)
                    });

                    if (!response.ok) {
                        const errorData = await response.json();
                        console.error('Error from API (Event Ideas):', errorData);
                        let errorMessage = `Erreur de l'API: ${response.statusText}.`;
                        if (errorData && errorData.error && errorData.error.message) {
                            errorMessage += ` ${errorData.error.message}`;
                        }
                        // Check for specific API key related errors
                        if (response.status === 400 && errorData?.error?.message?.toLowerCase().includes("api key not valid")) {
                             errorMessage = "La clé API fournie n'est pas valide. Veuillez contacter l'administrateur.";
                        } else if (response.status === 403) {
                            errorMessage = "L'accès à l'API a été refusé. Vérifiez les permissions de la clé API.";
                        }
                        throw new Error(errorMessage);
                    }

                    const result = await response.json();

                    if (result.candidates && result.candidates.length > 0 &&
                        result.candidates[0].content && result.candidates[0].content.parts &&
                        result.candidates[0].content.parts.length > 0 &&
                        result.candidates[0].content.parts[0].text) {
                        const text = result.candidates[0].content.parts[0].text;
                        eventIdeasResultDiv.innerHTML = text; // Make sure 'text' is safe HTML or sanitize it
                        eventIdeasResultDiv.classList.remove('hidden');
                    } else {
                        console.error('Unexpected response structure (Event Ideas):', result);
                        if (result.promptFeedback && result.promptFeedback.blockReason) {
                             throw new Error(`La réponse de l'IA a été bloquée: ${result.promptFeedback.blockReason}. Veuillez ajuster votre demande.`);
                        } else {
                             throw new Error("La réponse de l'IA (Idées d'événement) n'a pas pu être traitée. Structure inattendue.");
                        }
                    }

                } catch (error) {
                    console.error('Failed to generate event ideas:', error);
                    eventErrorMessageDiv.textContent = `Une erreur est survenue : ${error.message}. Veuillez réessayer.`;
                    eventErrorMessageDiv.classList.remove('hidden');
                } finally {
                    eventLoadingSpinner.classList.add('hidden');
                    generateEventIdeasBtn.disabled = false;
                }
            });
        } else {
            console.warn("Element with ID 'generateEventIdeasBtn' not found.");
        }
    </script>
    </div>
{% endblock %}