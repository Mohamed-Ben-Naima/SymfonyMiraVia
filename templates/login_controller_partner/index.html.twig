{% block stylesheets %}
<link href="{{ asset('style-partner/bootstrap.min.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('style-partner/style.css') }}">
    <style>
        /* Global Styling */
        body {
            margin: 0;
            padding: 0;
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(to bottom, #87CEEB, #f0f9ff); /* Sky gradient with sunlight effect */
            overflow: hidden; /* Prevent scrolling */
            color: #333;
        }

        /* Sky and Floating Clouds */
        .background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: -1; /* Place behind content */
        }

        /* Dynamic Clouds */
        .background .realistic-cloud {
            position: absolute;
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.6)); /* Sunlit cloud gradient */
            filter: blur(15px);
            border-radius: 60% 40% 60% 40%; /* Irregular shape for natural clouds */
            animation: cloud-move 40s linear infinite;
        }

        .background .realistic-cloud:nth-child(1) {
            width: 350px;
            height: 200px;
            top: 5%;
            left: -30%;
            animation-duration: 40s;
        }

        .background .realistic-cloud:nth-child(2) {
            width: 500px;
            height: 250px;
            top: 15%;
            left: 10%;
            animation-duration: 60s;
        }

        .background .realistic-cloud:nth-child(3) {
            width: 400px;
            height: 220px;
            top: 40%;
            left: -40%;
            animation-duration: 50s;
        }

        .background .realistic-cloud:nth-child(4) {
            width: 600px;
            height: 300px;
            top: 60%;
            left: 15%;
            animation-duration: 70s;
        }

        .background .realistic-cloud:nth-child(5) {
            width: 700px;
            height: 400px;
            top: 80%;
            left: 40%;
            animation-duration: 80s;
        }

        /* Cloud Movement */
        @keyframes cloud-move {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(120%);
            }
        }

        /* Trajectories */
        .background .trajectory {
            position: absolute;
            width: 200%;
            height: 400px;
            background: none;
            border-top: 2px dashed rgba(1, 58, 113, 0.4); /* Dashed semi-transparent blue line */
            border-radius: 50%;
            animation: trajectory-animation 8s infinite ease-in-out;
        }

        .background .trajectory:nth-child(6) {
            top: 12%;
            left: -60%;
            animation-duration: 6s;
        }

        .background .trajectory:nth-child(7) {
            top: 35%;
            left: -70%;
            animation-duration: 9s;
        }

        .background .trajectory:nth-child(8) {
            top: 55%;
            left: -80%;
            animation-duration: 7s;
        }

        .background .trajectory:nth-child(9) {
            top: 75%;
            left: -90%;
            animation-duration: 10s;
        }

        /* Airplanes */
        .background .airplane {
            position: absolute;
            width: 30px;
            height: 30px;
            background: url('{{ asset('images-partner/airplane-icon.png') }}') no-repeat center center;
            background-size: contain;
            animation: airplane-fly 12s infinite ease-in-out;
        }

        .background .airplane:nth-child(10) {
            top: 15%;
            left: -10%;
            animation-duration: 8s;
        }

        .background .airplane:nth-child(11) {
            top: 45%;
            left: -20%;
            animation-duration: 10s;
        }

        .background .airplane:nth-child(12) {
            top: 65%;
            left: -30%;
            animation-duration: 9s;
        }

        @keyframes trajectory-animation {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(50%);
            }
        }

        @keyframes airplane-fly {
            0% {
                transform: translateX(0) rotate(0deg);
            }
            50% {
                transform: translateX(25%) rotate(3deg);
            }
            100% {
                transform: translateX(50%) rotate(0deg);
            }
        }

        /* Form Container */
        .form-container {
            display: flex;
            max-width: 900px;
            width: 100%;
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .form-image {
            flex: 1;
            background-image: url('{{ asset('images-partner/airplane.jpg') }}');
            background-size: cover;
            background-position: center;
        }
     .text-center a {
    font-size: 0.95rem;
    font-weight: 500;
}
.btn-outline-primary {
    border: 2px solid #dce8f5;
    color: #3b5998;
    background: #ffffff;
}

.btn-outline-primary:hover {
    background: #3b5998;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(59, 89, 152, 0.3);
}


        .form-content {
            flex: 1;
            padding: 2rem;
            background: #fafdff;
        }

        .form-content h2 {
            color: #013a71;
            font-weight: bold;
        }

        .form-content img.logo {
            max-width: 120px;
            margin: 0 auto 20px;
            display: block;
        }

        .form-label {
            font-weight: bold;
            color: #013a71;
        }

        .form-control {
            border-radius: 10px;
            border: 2px solid #81a8c5;
            background: #ffffff;
            transition: 0.3s;
        }

        .form-control:focus {
            border-color: #013a71;
            box-shadow: 0 0 10px rgba(1, 58, 113, 0.3);
        }

        .btn {
            border-radius: 10px;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-primary {
            background: #013a71;
            border: none;
            color: white;
        }

        .btn-primary:hover {
            background: #012a51;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(1, 58, 113, 0.3);
        }

        .btn-outline-danger {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 2px solid #e8e7de;
            color: #ea4335;
        }

        .btn-outline-danger img {
            height: 20px;
            margin-right: 8px;
        }

        .btn-outline-danger:hover {
            background: #ea4335;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(234, 67, 53, 0.3);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .form-container {
                flex-direction: column;
            }

            .form-image {
                height: 200px;
            }
        }
    </style>
{% endblock %}

