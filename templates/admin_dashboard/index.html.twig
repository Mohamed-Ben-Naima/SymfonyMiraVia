{% extends 'baseAdmin.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .card {
            border: none; /* Supprime la bordure par défaut */
            border-radius: 15px; /* Coins arrondis */
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1); /* Ombre subtile */
            transition: transform 0.3s ease, box-shadow 0.3s ease; /* Animation au survol */
            height: 100%; /* Uniformité dans la hauteur */
        }

        .card:hover {
            transform: translateY(-5px); /* Légère élévation au survol */
            box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.15); /* Ombre accentuée */
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
        }

        .card-title i {
            margin-right: 10px;
            font-size: 1.5rem;
        }

        .card.bg-primary {
            background-color: #FFCDD2FF !important; /* Couleur rose */
            color: #000000; /* Texte noir pour contraste */
        }

        .card.bg-success {
            background-color: #C8E6C9FF !important; /* Couleur vert */
            color: #000000;
        }

        .card.bg-warning {
            background-color: #FFE0B2FF !important;  /* Couleur orange */
            color: #000000;
        }

        .card.bg-danger {
            background-color: #E1BEE7FF !important; /* Couleur violet */
            color: #000000;
        }

        .card.bg-info {
            background-color: #BBDEFBFF !important; /* Couleur bleu */
            color: #000000;
        }

        /* Container for all cards with white background */
        .cards-background {
            background-color: #ffffff; /* White background */
            border-radius: 15px; /* Rounded corners */
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1); /* Subtle shadow */
            padding: 20px; /* Internal spacing */
            margin-bottom: 2rem; /* Space below the container */
        }

        .cards-container {
            display: flex;
            gap: 20px; /* Espace entre les cartes */
            justify-content: space-between; /* Distribution uniforme des cartes */
            flex-wrap: nowrap; /* Empêche les cartes de passer à la ligne suivante */
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">

            <!-- Cards Section with White Background -->
            <div class="cards-background">
                <div class="cards-container">
                    <div class="card bg-primary">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-users"></i> Total Users</h5>
                            <p class="card-text">78,250</p>
                        </div>
                    </div>
                    <div class="card bg-success">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-dollar-sign"></i> Total Sales</h5>
                            <p class="card-text">$35,078</p>
                        </div>
                    </div>
                    <div class="card bg-warning">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-shopping-cart"></i> Total Orders</h5>
                            <p class="card-text">18,800</p>
                        </div>
                    </div>
                    <div class="card bg-danger">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-chart-line"></i> Revenue</h5>
                            <p class="card-text">$7,650</p>
                        </div>
                    </div>
                    <div class="card bg-info">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-comments"></i> Feedbacks</h5>
                            <p class="card-text">1,245</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="recent-orders card mt-4">
                <div class="card-header">
                    Recent Orders
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Tracking No.</th>
                                    <th>Product Name</th>
                                    <th>Total Order</th>
                                    <th>Status</th>
                                    <th>Total Amount</th>
                                    <th>Image</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>84564564</td>
                                    <td>Camera Lens</td>
                                    <td>40</td>
                                    <td><span class="badge bg-danger">Rejected</span></td>
                                    <td>$40,570</td>
                                    <td><img src="/images/camera-lens.jpg" alt="Camera Lens" class="img-thumbnail" width="50"></td>
                                </tr>
                                <tr>
                                    <td>84564565</td>
                                    <td>Laptop</td>
                                    <td>300</td>
                                    <td><span class="badge bg-warning">Pending</span></td>
                                    <td>$180,139</td>
                                    <td><img src="/images/laptop.jpg" alt="Laptop" class="img-thumbnail" width="50"></td>
                                </tr>
                                <tr>
                                    <td>84564566</td>
                                    <td>Mobile</td>
                                    <td>355</td>
                                    <td><span class="badge bg-success">Approved</span></td>
                                    <td>$180,139</td>
                                    <td><img src="/images/mobile.jpg" alt="Mobile" class="img-thumbnail" width="50"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        var stackedBarOptions = {
            chart: {
                type: 'bar',
                height: 350,
                stacked: true
            },
            series: [
                { name: 'Product A', data: [60, 70, 80, 90, 100, 110] },
                { name: 'Product B', data: [50, 60, 70, 80, 90, 100] },
                { name: 'Product C', data: [40, 50, 60, 70, 80, 90] }
            ],
            xaxis: {
                categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun']
            },
            colors: ['#81A8C5', '#E8E7DE', '#7D8C6D']
        };
        var stackedBarChart = new ApexCharts(document.querySelector("#stackedBarChart"), stackedBarOptions);
        stackedBarChart.render();

        var radarOptions = {
            chart: {
                type: 'radar',
                height: 350
            },
            series: [{
                name: 'Performance',
                data: [70, 60, 80, 90, 100, 50]
            }],
            labels: ['Communication', 'Sales', 'Support', 'Development', 'Marketing', 'Design']
        };
        var radarChart = new ApexCharts(document.querySelector("#radarChart"), radarOptions);
        radarChart.render();
    </script>
{% endblock %}