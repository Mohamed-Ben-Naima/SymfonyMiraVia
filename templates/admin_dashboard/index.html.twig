{% extends 'baseAdmin.html.twig' %}

{% block title %}
    Dashboard
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 50%;
            overflow-y: auto; /* Active le scroll vertical pour toute la page */
        }

        main {
            flex: 1;
            overflow-y: auto; /* Active le scroll pour le contenu principal */
            padding-bottom: 20px;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.15);
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center; /* Centre le contenu horizontalement */
            flex-wrap: wrap; /* Permet à l'élément de s'adapter aux petites tailles */
            text-align: center;
            word-wrap: break-word; /* Permet de couper les mots si nécessaire */
        }

        .card-title i {
            margin-right: 10px;
            font-size: 1.5rem;
        }

        .card-text {
            font-size: 1rem;
            font-weight: 500;
            text-align: center; /* Centre le texte dans la carte */
            white-space: nowrap; /* Empêche de couper le texte en ligne */
            overflow: hidden; /* Masque le texte qui dépasse */
            text-overflow: ellipsis; /* Ajoute "..." si le texte est trop long */
        }

        @media (max-width: 768px) {
            .card-title {
                font-size: rem; /* Réduit la taille de la police pour petits écrans */
            }

            .card-text {
                font-size: 0.9rem; /* Réduit la taille de la police pour petits écrans */
            }
        }

        .card.bg-primary {
            background-color: #FFCDD2FF !important;
            color: #000000;
        }

        .card.bg-success {
            background-color: #C8E6C9FF !important;
            color: #000000;
        }

        .card.bg-warning {
            background-color: #FFE0B2FF !important;
            color: #000000;
        }

        .card.bg-danger {
            background-color: #E1BEE7FF !important;
            color: #000000;
        }

        .card.bg-info {
            background-color: #BBDEFBFF !important;
            color: #000000;
        }

        .cards-container {
            display: flex;
            gap: 20px;
            justify-content: space-between; /* Sépare les cartes horizontalement */
            flex-wrap: wrap; /* Permet aux cartes de passer sur plusieurs lignes si nécessaire */
        }

        .card-body {
            display: flex;
            flex-direction: column;
            align-items: center; /* Centre le contenu de la carte */
            justify-content: center;
        }

        .cards-background {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 2rem;
        }

        .graphs-section {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: space-between;
            margin-top: 20px; /* Sépare les graphiques de la table */
        }

        .graph-container {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 48%; /* Ajuste la largeur pour un affichage responsive */
            min-height: 350px; /* Définit une hauteur minimale pour que les graphiques soient visibles */
        }

        .recent-orders {
            overflow-x: auto; /* Permet un défilement horizontal si nécessaire */
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="cards-background">
                <h2 class="mb-3" style="font-size: 1.5rem; font-weight: bold;">Statistiques</h2>
                <div class="cards-container">
                    <div class="card bg-primary">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-user-friends"></i> Clients</h5>
                            <p class="card-text">78,250</p>
                        </div>
                    </div>
                    <div class="card bg-success">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-handshake"></i> Partenaires</h5>
                            <p class="card-text">250</p>
                        </div>
                    </div>
                    <div class="card bg-warning">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-calendar-alt"></i> Evenements</h5>
                            <p class="card-text">180</p>
                        </div>
                    </div>
                    <div class="card bg-danger">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-life-ring"></i> Demandes d'aide</h5>
                            <p class="card-text">40</p>
                        </div>
                    </div>
                    <div class="card bg-info">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-donate"></i> Dons</h5>
                            <p class="card-text">12</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="recent-orders card mt-4">
                <div class="card-header">
                    Recent Orders
                </div>
                <div class="card-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Tracking No.</th>
                                <th>Product Name</th>
                                <th>Total Order</th>
                                <th>Status</th>
                                <th>Total Amount</th>
                                <th>Image</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>84564564</td>
                                <td>Camera Lens</td>
                                <td>40</td>
                                <td><span class="badge" style="background-color: #FFCDD2FF; color: #000;">Rejected</span></td>
                                <td>$40,570</td>
                                <td><img src="/images/camera-lens.jpg" alt="Camera Lens" class="img-thumbnail" width="50"></td>
                            </tr>
                            <tr>
                                <td>84564565</td>
                                <td>Laptop</td>
                                <td>300</td>
                                <td><span class="badge" style="background-color: #FFE0B2FF; color: #000;">Pending</span></td>
                                <td>$180,139</td>
                                <td><img src="/images/laptop.jpg" alt="Laptop" class="img-thumbnail" width="50"></td>
                            </tr>
                            <tr>
                                <td>84564566</td>
                                <td>Mobile</td>
                                <td>355</td>
                                <td><span class="badge" style="background-color: #C8E6C9FF; color: #000;">Approved</span></td>
                                <td>$180,139</td>
                                <td><img src="/images/mobile.jpg" alt="Mobile" class="img-thumbnail" width="50"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="graphs-section">
                <div class="graph-container" id="stackedBarChart"></div>
                <div class="graph-container" id="radarChart"></div>
                <div class="graph-container" id="lineChart"></div>
                <div class="graph-container" id="pieChart"></div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Stacked Bar Chart
        const stackedBarOptions = {
            chart: { type: 'bar', height: 350, stacked: true },
            series: [
                { name: 'Product A', data: [60, 70, 80, 90, 100, 110] },
                { name: 'Product B', data: [50, 60, 70, 80, 90, 100] },
                { name: 'Product C', data: [40, 50, 60, 70, 80, 90] }
            ],
            xaxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] }
        };
        new ApexCharts(document.querySelector("#stackedBarChart"), stackedBarOptions).render();

        // Radar Chart
        const radarOptions = {
            chart: { type: 'radar', height: 350 },
            series: [{ name: 'Performance', data: [70, 60, 80, 90, 100, 50] }],
            labels: ['Communication', 'Sales', 'Support', 'Development', 'Marketing', 'Design']
        };
        new ApexCharts(document.querySelector("#radarChart"), radarOptions).render();

        // Line Chart
        const lineChartOptions = {
            chart: { type: 'line', height: 350 },
            series: [{ name: 'Revenue', data: [1000, 2000, 3000, 4000, 5000, 6000] }],
            xaxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] }
        };
        new ApexCharts(document.querySelector("#lineChart"), lineChartOptions).render();

        // Pie Chart
        const pieChartOptions = {
            chart: { type: 'pie', height: 350 },
            series: [12, 30, 25, 18, 15],
            labels: ['France', 'Tunisia', 'Germany', 'USA', 'Others'],
            colors: ['#FFCDD2', '#C8E6C9', '#FFE0B2', '#E1BEE7', '#BBDEFB']
        };
        new ApexCharts(document.querySelector("#pieChart"), pieChartOptions).render();
    });
</script>
{% endblock %}