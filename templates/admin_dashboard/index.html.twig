{% extends 'baseAdmin.html.twig' %}

{% block title %}
    Dashboard
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 50%;
            overflow-y: auto;
        }

        main {
            flex: 1;
            overflow-y: auto;
            padding-bottom: 20px;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.15);
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            text-align: center;
            word-wrap: break-word;
        }

        .card-title i {
            margin-right: 10px;
            font-size: 1.5rem;
        }

        .card-text {
            font-size: 1rem;
            font-weight: 500;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @media (max-width: 768px) {
            .card-title {
                font-size: 1rem;
            }

            .card-text {
                font-size: 0.9rem;
            }
        }

        .card.bg-primary {
            background-color: #FFCDD2FF !important;
            color: #000000;
        }

        .card.bg-success {
            background-color: #C8E6C9FF !important;
            color: #000000;
        }

        .card.bg-warning {
            background-color: #FFE0B2FF !important;
            color: #000000;
        }

        .card.bg-danger {
            background-color: #E1BEE7FF !important;
            color: #000000;
        }

        .card.bg-info {
            background-color: #BBDEFBFF !important;
            color: #000000;
        }

        .cards-container {
            display: flex;
            gap: 20px;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .card-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .cards-background {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 2rem;
        }

        .graphs-section {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: space-between;
            margin-top: 20px;
        }

        .graph-container {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 48%;
            min-height: 350px;
        }

        .calendar-container {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 100%;
            min-height: 350px;
        }

        /* Custom Calendar Styles */
        #calendar {
            background-color: #f9f9f9;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 10px;
        }

        .fc-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .fc-toolbar-title {
            font-size: 1.25rem;
            font-weight: bold;
            color: #333;
        }

        .fc-button {
            background-color: #FFCDD2FF;
            color: #000;
            border: none;
            border-radius: 5px;
            padding: 5px 10px;
            transition: all 0.3s ease;
        }

        .fc-button:hover {
            background-color: #E57373FF;
            color: #fff;
        }

        .fc-daygrid-day {
            border: 1px solid #ddd;
        }

        .fc-daygrid-day-number {
            font-weight: bold;
            color: #333;
        }

        .fc-event {
            background-color: #FFCDD2FF;
            color: #000;
            border: 1px solid #E57373FF;
            border-radius: 5px;
            padding: 2px 5px;
            font-size: 0.9rem;
        }

        /* Couleur permanente pour les cases avec des événements */
        .fc-daygrid-day:has(.fc-daygrid-event) {
            background-color: #FFCDD2;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        }

        /* Pas d'effet hover sur les cases */
        .fc-daygrid-day:hover {
            background-color: inherit;
            box-shadow: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="cards-background">
                <h2 class="mb-3" style="font-size: 1.5rem; font-weight: bold;">Statistiques</h2>
                <div class="cards-container">
                    <div class="card bg-primary">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-user-friends"></i> Clients</h5>
                            <p class="card-text" id="clientCount">{{ totalClients | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-success">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-handshake"></i> Partenaires</h5>
                            <p class="card-text" id="partnerCount">{{ totalPartenaires | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-warning">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-calendar-alt"></i> Evenements</h5>
                            <p class="card-text" id="eventCount">{{ totalEvenements | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-danger">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-life-ring"></i> Demandes d'aide</h5>
                            <p class="card-text" id="helpRequests">{{ totalDemandesAide | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-info">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-donate"></i> Dons</h5>
                            <p class="card-text" id="donationsCount">{{ totalDons | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="graphs-section">
                <div class="calendar-container" id="calendar">
                </div>
                <div class="graph-container" id="stackedBarChart"></div>
                <div class="graph-container" id="radarChart"></div>
                <div class="graph-container" id="lineChart"></div>
                <div class="graph-container" id="pieChart"></div>
            </div>
        </main>
    </div>

    <!-- Modal pour afficher les détails de l'événement -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #FFCDD2FF; color: #000;">
                    <h5 class="modal-title" id="eventModalLabel">Détails de l'événement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Titre :</strong> <span id="eventTitle"></span></p>
                    <p><strong>Date :</strong> <span id="eventDate"></span></p>
                    <p><strong>Lieu :</strong> <span id="eventLocation"></span></p>
                    <p><strong>Description :</strong> <span id="eventDescription"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" style="background-color: #FFCDD2FF; color: #000;" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core/locales/fr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr', // Définir la localisation en français
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                events: {{ events | raw }}, // Charger les événements depuis la variable Twig
                eventClick: function(info) {
                    // Remplir les champs de la modale avec les données de l'événement
                    document.getElementById('eventTitle').textContent = info.event.title;
                    document.getElementById('eventDate').textContent = info.event.start.toISOString().split('T')[0];
                    document.getElementById('eventLocation').textContent = info.event.extendedProps.lieu || 'Non spécifié';
                    document.getElementById('eventDescription').textContent = info.event.extendedProps.description || 'Non spécifiée';

                    // Afficher la modale
                    var eventModal = new bootstrap.Modal(document.getElementById('eventModal'));
                    eventModal.show();
                }
            });
            calendar.render();

            // Stacked Bar Chart
            const stackedBarOptions = {
                chart: { type: 'bar', height: 350, stacked: true },
                series: [
                    { name: 'Product A', data: [60, 70, 80, 90, 100, 110] },
                    { name: 'Product B', data: [50, 60, 70, 80, 90, 100] },
                    { name: 'Product C', data: [40, 50, 60, 70, 80, 90] }
                ],
                xaxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] }
            };
            new ApexCharts(document.querySelector("#stackedBarChart"), stackedBarOptions).render();

            // Radar Chart
            const radarOptions = {
                chart: { type: 'radar', height: 350 },
                series: [{ name: 'Performance', data: [70, 60, 80, 90, 100, 50] }],
                labels: ['Communication', 'Sales', 'Support', 'Development', 'Marketing', 'Design']
            };
            new ApexCharts(document.querySelector("#radarChart"), radarOptions).render();

            // Line Chart
            const lineChartOptions = {
                chart: { type: 'line', height: 350 },
                series: [{ name: 'Revenue', data: [1000, 2000, 3000, 4000, 5000, 6000] }],
                xaxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] }
            };
            new ApexCharts(document.querySelector("#lineChart"), lineChartOptions).render();

            // Pie Chart
            const pieChartOptions = {
                chart: { type: 'pie', height: 350 },
                series: [12, 30, 25, 18, 15],
                labels: ['France', 'Tunisia', 'Germany', 'USA', 'Others'],
                colors: ['#FFCDD2', '#C8E6C9', '#FFE0B2', '#E1BEE7', '#BBDEFB']
            };
            new ApexCharts(document.querySelector("#pieChart"), pieChartOptions).render();
        });
    </script>
{% endblock %}