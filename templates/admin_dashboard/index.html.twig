{% extends 'baseAdmin.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .card-title {
            font-size: 1.5rem;
            font-weight: bold;
            display: flex;
            align-items: center;
        }
        .card-title i {
            margin-right: 10px;
        }
        .table-hover tbody tr:hover {
            background-color: #E8E7DE; /* Hover effect */
        }
        .sidebar {
            height: 100vh;
            position: fixed;
        }
        .card.bg-primary {
            background-color: #81A8C5 !important;
        }
        .card.bg-success {
            background-color: #7D8C6D !important;
        }
        .card.bg-warning {
            background-color: #E8E7DE !important;
            color: #013A71;
        }
        .card.bg-danger {
            background-color: #013A71 !important;
            color: #ffffff;
        }
        .badge.bg-danger {
            background-color: #013A71 !important;
        }
        .badge.bg-warning {
            background-color: #E8E7DE !important;
            color: #013A71;
        }
        .badge.bg-success {
            background-color: #7D8C6D !important;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Dashboard</h1>
            </div>

            <!-- Cards Section -->
            <div class="row">
                <div class="col-md-6 col-lg-3">
                    <div class="card text-white bg-primary mb-3">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-users"></i> Total Users</h5>
                            <p class="card-text">78,250</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card text-white bg-success mb-3">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-dollar-sign"></i> Total Sales</h5>
                            <p class="card-text">$35,078</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card bg-warning mb-3">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-shopping-cart"></i> Total Orders</h5>
                            <p class="card-text">18,800</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card bg-danger mb-3">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-chart-line"></i> Revenue</h5>
                            <p class="card-text">$7,650</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            Stacked Bar Chart
                        </div>
                        <div class="card-body">
                            <div id="stackedBarChart"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            Radar Chart
                        </div>
                        <div class="card-body">
                            <div id="radarChart"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="card mb-4">
                <div class="card-header">
                    Recent Orders
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Tracking No.</th>
                                    <th>Product Name</th>
                                    <th>Total Order</th>
                                    <th>Status</th>
                                    <th>Total Amount</th>
                                    <th>Image</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>84564564</td>
                                    <td>Camera Lens</td>
                                    <td>40</td>
                                    <td><span class="badge bg-danger">Rejected</span></td>
                                    <td>$40,570</td>
                                    <td><img src="/images/camera-lens.jpg" alt="Camera Lens" class="img-thumbnail" width="50"></td>
                                </tr>
                                <tr>
                                    <td>84564565</td>
                                    <td>Laptop</td>
                                    <td>300</td>
                                    <td><span class="badge bg-warning">Pending</span></td>
                                    <td>$180,139</td>
                                    <td><img src="/images/laptop.jpg" alt="Laptop" class="img-thumbnail" width="50"></td>
                                </tr>
                                <tr>
                                    <td>84564566</td>
                                    <td>Mobile</td>
                                    <td>355</td>
                                    <td><span class="badge bg-success">Approved</span></td>
                                    <td>$180,139</td>
                                    <td><img src="/images/mobile.jpg" alt="Mobile" class="img-thumbnail" width="50"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        // Graphique à barres empilées
        var stackedBarOptions = {
            chart: {
                type: 'bar',
                height: 350,
                stacked: true
            },
            series: [
                { name: 'Product A', data: [60, 70, 80, 90, 100, 110] },
                { name: 'Product B', data: [50, 60, 70, 80, 90, 100] },
                { name: 'Product C', data: [40, 50, 60, 70, 80, 90] }
            ],
            xaxis: {
                categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun']
            },
            colors: ['#81A8C5', '#E8E7DE', '#7D8C6D']
        };
        var stackedBarChart = new ApexCharts(document.querySelector("#stackedBarChart"), stackedBarOptions);
        stackedBarChart.render();

        // Graphique en radar avec données statiques
        var radarOptions = {
            chart: {
                type: 'radar',
                height: 350
            },
            series: [{
                name: 'Performance',
                data: [70, 60, 80, 90, 100, 50]
            }],
            labels: ['Communication', 'Sales', 'Support', 'Development', 'Marketing', 'Design']
        };
        var radarChart = new ApexCharts(document.querySelector("#radarChart"), radarOptions);
        radarChart.render();
    </script>
{% endblock %}