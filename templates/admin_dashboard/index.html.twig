{% extends 'baseAdmin.html.twig' %}

{% block title %}
    Dashboard
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
    <link rel="preload" href="/assets/styles/app-o3KscP3.css" as="style" onload="this.rel='stylesheet'">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 50%;
            overflow-y: auto;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        main {
            flex: 1;
            overflow-y: auto;
            padding-bottom: 20px;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.15);
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            text-align: center;
            word-wrap: break-word;
            line-height: 1.5;
        }

        .card-title i {
            margin-right: 10px;
            font-size: 1.75rem;
            vertical-align: middle;
        }

        .card:hover .card-title i {
            transform: scale(1.2);
            transition: transform 0.3s ease;
        }

        .card.bg-primary .card-title i {
            color: #D32F2F;
        }

        .card.bg-success .card-title i {
            color: #388E3C;
        }

        .card.bg-warning .card-title i {
            color: #F57C00;
        }

        .card.bg-danger .card-title i {
            color: #7B1FA2;
        }

        .card.bg-info .card-title i {
            color: #0288D1;
        }

        .card-text {
            font-size: 1rem;
            font-weight: 500;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @media (max-width: 768px) {
            .card-title {
                font-size: 1rem;
            }

            .card-text {
                font-size: 0.9rem;
            }
        }

        .card.bg-primary {
            background-color: #FFCDD2FF !important;
            color: #000000;
        }

        .card.bg-success {
            background-color: #C8E6C9FF !important;
            color: #000000;
        }

        .card.bg-warning {
            background-color: #FFE0B2FF !important;
            color: #000000;
        }

        .card.bg-danger {
            background-color: #E1BEE7FF !important;
            color: #000000;
        }

        .card.bg-info {
            background-color: #BBDEFBFF !important;
            color: #000000;
        }

        .cards-container {
            display: flex;
            gap: 20px;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .card-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .cards-background {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 2rem;
        }

        .graphs-section {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: space-between;
            margin-top: 20px;
        }

        .graph-container {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 48%;
            min-height: 350px;
        }

        .calendar-container {
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 100%;
            min-height: 350px;
        }

        /* Custom Calendar Styles */
        #calendar {
            background-color: #f9f9f9;
            border-radius: 15px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            padding: 10px;
        }

        .fc-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .fc-toolbar-title {
            font-size: 1.25rem;
            font-weight: bold;
            color: #333;
        }

        .fc-button {
            background-color: #FFCDD2FF;
            color: #000;
            border: none;
            border-radius: 5px;
            padding: 5px 10px;
            transition: all 0.3s ease;
        }

        .fc-button:hover {
            background-color: #E57373FF;
            color: #fff;
        }

        .fc-daygrid-day {
            border: 1px solid #ddd;
            overflow: hidden; /* Cache tout débordement */
        }

        .fc-daygrid-day-number {
            font-weight: bold;
            color: #333;
        }

        /* Style pour les événements classiques */
        .fc-event.event-classique {
            background-color: #FFCDD2FF;
            color: #000;
            border: 1px solid #E57373FF;
            border-radius: 5px;
            padding: 2px 5px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            white-space: nowrap; /* Empêche le texte de passer à la ligne */
            overflow: hidden; /* Cache le texte qui dépasse */
            text-overflow: ellipsis; /* Ajoute des points de suspension */
            line-height: 1.2; /* Ajuste la hauteur de ligne */
        }

        /* Style pour les événements de bénévolat */
        .fc-event.event-benevolat {
            background-color: #C8E6C9FF;
            color: #000;
            border: 1px solid #4CAF50FF;
            border-radius: 5px;
            padding: 2px 5px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            white-space: nowrap; /* Empêche le texte de passer à la ligne */
            overflow: hidden; /* Cache le texte qui dépasse */
            text-overflow: ellipsis; /* Ajoute des points de suspension */
            line-height: 1.2; /* Ajuste la hauteur de ligne */
        }

        /* Réduire la taille des icônes pour éviter le débordement */
        .fc-event i {
            font-size: 0.7rem; /* Taille réduite pour les icônes */
            margin-right: 3px;
        }

        /* Ajout d'une icône pour les événements de bénévolat */
        .fc-event.event-benevolat .fc-event-title::before {
            content: '\f4c4'; /* Code Unicode pour l'icône FontAwesome fa-hands-helping */
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            margin-right: 5px;
            color: #4CAF50FF;
            font-size: 0.7rem; /* Taille réduite pour l'icône */
        }

        /* Couleur permanente pour les cases avec des événements classiques */
        .fc-daygrid-day:has(.event-classique) {
            background-color: #FFCDD2;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        }

        /* Couleur permanente pour les cases avec des événements de bénévolat */
        .fc-daygrid-day:has(.event-benevolat) {
            background-color: #C8E6C9;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        }

        /* Style pour les jours avec plusieurs événements */
        .fc-daygrid-day.has-multiple-events {
            border: 2px solid #E57373FF; /* Bordure pour indiquer plusieurs événements */
        }

        /* Pas d'effet hover sur les cases */
        .fc-daygrid-day:hover {
            background-color: inherit;
            box-shadow: none;
        }

        /* Style pour la date actuelle */
        .fc-daygrid-day.fc-day-today {
            background-color: #BBDEFB !important;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        }

        /* Style pour le texte indicatif si pas d'événements */
        .no-event-text {
            color: #333;
            font-size: 0.8rem;
            text-align: center;
            padding: 5px;
        }

        /* Limiter le contenu des événements dans les cases du calendrier */
        .fc-daygrid-day-events {
            overflow: hidden; /* Cache le contenu qui dépasse */
            max-height: 100%; /* S'assure que les événements ne dépassent pas la hauteur de la case */
        }

        /* Style pour l'indicateur de plus d'événements */
        .fc-daygrid-more-link {
            font-size: 0.7rem;
            color: #E57373FF;
            text-decoration: none;
        }

        .fc-daygrid-more-link:hover {
            color: #D32F2F;
            text-decoration: underline;
        }

        /* Style pour les titres des graphiques */
        .graph-title {
            font-size: 1.25rem;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
            text-align: center;
        }

        /* Modal Styles */
        .modal-content {
            background-color: #ffffff;
            color: #333;
        }

        .modal-header {
            background-color: #f8f9fa;
            color: #333;
        }

        .modal-footer .close-btn {
            background-color: #f8f9fa;
            color: #333;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Dark Mode Styles */
        body.dark-mode {
            background-color: #1a202c;
            color: #e2e8f0;
        }

        body.dark-mode .cards-background,
        body.dark-mode .graph-container,
        body.dark-mode .calendar-container {
            background-color: #2d3748;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.3);
        }

        body.dark-mode .card {
            background-color: #2d3748 !important;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.3);
            color: #e2e8f0;
        }

        body.dark-mode .card:hover {
            box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.4);
        }

        body.dark-mode .card-title,
        body.dark-mode .card-text,
        body.dark-mode .graph-title,
        body.dark-mode .fc-toolbar-title,
        body.dark-mode .fc-daygrid-day-number,
        body.dark-mode .no-event-text {
            color: #e2e8f0;
        }

        body.dark-mode #calendar {
            background-color: #2d3748;
        }

        body.dark-mode .fc-button {
            background-color: #4a90e2;
            color: #e2e8f0;
        }

        body.dark-mode .fc-button:hover {
            background-color: #357abd;
            color: #ffffff;
        }

        body.dark-mode .fc-daygrid-day {
            border: 1px solid #4a5568;
            overflow: hidden; /* Cache tout débordement en mode sombre */
        }

        body.dark-mode .fc-event.event-classique {
            background-color: #4a5568;
            color: #e2e8f0;
            border: 1px solid #718096;
            border-radius: 5px;
            padding: 2px 5px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            white-space: nowrap; /* Empêche le texte de passer à la ligne */
            overflow: hidden; /* Cache le texte qui dépasse */
            text-overflow: ellipsis; /* Ajoute des points de suspension */
            line-height: 1.2; /* Ajuste la hauteur de ligne */
        }

        body.dark-mode .fc-event.event-benevolat {
            background-color: #4a5568;
            color: #e2e8f0;
            border: 1px solid #718096;
            border-radius: 5px;
            padding: 2px 5px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            white-space: nowrap; /* Empêche le texte de passer à la ligne */
            overflow: hidden; /* Cache le texte qui dépasse */
            text-overflow: ellipsis; /* Ajoute des points de suspension */
            line-height: 1.2; /* Ajuste la hauteur de ligne */
        }

        body.dark-mode .fc-event i {
            font-size: 0.7rem; /* Taille réduite pour les icônes en mode sombre */
            margin-right: 3px;
        }

        body.dark-mode .fc-event.event-benevolat .fc-event-title::before {
            color: #4a90e2;
            font-size: 0.7rem; /* Taille réduite pour l'icône */
        }

        body.dark-mode .fc-daygrid-day:has(.event-classique) {
            background-color: #4a5568;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.3);
        }

        body.dark-mode .fc-daygrid-day:has(.event-benevolat) {
            background-color: #4a5568;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.3);
        }

        body.dark-mode .fc-daygrid-day.has-multiple-events {
            border: 2px solid #4a90e2; /* Bordure pour indiquer plusieurs événements en mode sombre */
        }

        body.dark-mode .fc-daygrid-day.fc-day-today {
            background-color: #2b6cb0 !important;
        }

        body.dark-mode .fc-daygrid-more-link {
            font-size: 0.7rem;
            color: #4a90e2;
            text-decoration: none;
        }

        body.dark-mode .fc-daygrid-more-link:hover {
            color: #357abd;
            text-decoration: underline;
        }

        body.dark-mode .modal-content {
            background-color: #2d3748;
            color: #e2e8f0;
        }

        body.dark-mode .modal-header {
            background-color: #1a202c;
            color: #e2e8f0;
        }

        body.dark-mode .modal-footer .close-btn {
            background-color: #4a5568;
            color: #e2e8f0;
        }

        body.dark-mode .modal-footer .close-btn:hover {
            background-color: #718096;
        }

        /* ApexCharts Dark Mode Adjustments */
        body.dark-mode .apexcharts-canvas {
            background: #2d3748 !important;
        }

        body.dark-mode .apexcharts-text,
        body.dark-mode .apexcharts-title-text,
        body.dark-mode .apexcharts-xaxis-label,
        body.dark-mode .apexcharts-yaxis-label {
            fill: #e2e8f0 !important;
        }

        body.dark-mode .apexcharts-legend-text {
            color: #e2e8f0 !important;
        }

        body.dark-mode .apexcharts-tooltip {
            background: #1a202c !important;
            color: #e2e8f0 !important;
            border: 1px solid #4a5568 !important;
        }

        /* Ajustements pour petits écrans */
        @media (max-width: 768px) {
            .fc-event {
                font-size: 0.7rem; /* Réduit la taille pour petits écrans */
                padding: 1px 3px;
            }

            .fc-event i {
                font-size: 0.6rem; /* Taille encore plus petite pour les icônes */
            }

            .fc-event.event-benevolat .fc-event-title::before {
                font-size: 0.6rem; /* Taille réduite pour l'icône */
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="cards-background">
                <h2 class="mb-3" style="font-size: 1.5rem; font-weight: bold;">Statistiques</h2>
                <div class="cards-container">
                    <div class="card bg-primary">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-users"></i> Clients</h5>
                            <p class="card-text" id="clientCount">{{ totalClients | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-success">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-network-wired"></i> Partenaires</h5>
                            <p class="card-text" id="partnerCount">{{ totalPartenaires | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-warning">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-calendar-check"></i> Événements</h5>
                            <p class="card-text" id="eventCount">{{ totalEvenements | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-danger">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-hands-helping"></i> Demandes d'aide</h5>
                            <p class="card-text" id="helpRequests">{{ totalDemandesAide | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                    <div class="card bg-info">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-hand-holding-usd"></i> Dons</h5>
                            <p class="card-text" id="donationsCount">{{ totalDons | number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="graphs-section">
                <div class="calendar-container">
                    <h3 class="graph-title">Calendrier des Événements</h3>
                    <div id="calendar"></div>
                </div>
                <div class="graph-container">
                    <h3 class="graph-title">Évolution des Dons par Mois</h3>
                    <div id="donationsLineChart"></div>
                </div>
                <div class="graph-container">
                    <h3 class="graph-title">Répartition des partenaires par secteur</h3>
                    <div id="radarChart"></div>
                </div>
                <div class="graph-container">
                    <h3 class="graph-title">Revenus Mensuels</h3>
                    <div id="lineChart"></div>
                </div>
                <div class="graph-container">
                    <h3 class="graph-title">Répartition des Partenaires par Pays</h3>
                    <div id="pieChart"></div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal pour afficher les détails de l'événement -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="eventModalLabel">Détails de l'événement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Titre :</strong> <span id="eventTitle"></span></p>
                    <p><strong>Date :</strong> <span id="eventDate"></span></p>
                    <p><strong>Lieu :</strong> <span id="eventLocation"></span></p>
                    <p><strong>Description :</strong> <span id="eventDescription"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn close-btn" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

