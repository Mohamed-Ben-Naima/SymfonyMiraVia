{% block stylesheets %}
<link href="{{ asset('style-partner/bootstrap.min.css') }}" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<style>
  
    /* Global Styling */
  body {
    margin: 0;
    padding: 0;
    font-family: 'Roboto', sans-serif;
    background: linear-gradient(to bottom, #87CEEB, #f0f9ff); /* Sky gradient with sunlight effect */
    color: #333;
}
    /* Sky and Floating Clouds */
    .background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1; /* Place behind content */
    }

    /* Dynamic Clouds */
    .background .realistic-cloud {
        position: absolute;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.6)); /* Sunlit cloud gradient */
        filter: blur(15px);
        border-radius: 60% 40% 60% 40%; /* Irregular shape for natural clouds */
        animation: cloud-move 40s linear infinite;
    }

    .background .realistic-cloud:nth-child(1) {
        width: 350px;
        height: 200px;
        top: 5%;
        left: -30%;
        animation-duration: 40s;
    }

    .background .realistic-cloud:nth-child(2) {
        width: 500px;
        height: 250px;
        top: 15%;
        left: 10%;
        animation-duration: 60s;
    }

    .background .realistic-cloud:nth-child(3) {
        width: 400px;
        height: 220px;
        top: 40%;
        left: -40%;
        animation-duration: 50s;
    }

    .background .realistic-cloud:nth-child(4) {
        width: 600px;
        height: 300px;
        top: 60%;
        left: 15%;
        animation-duration: 70s;
    }

    .background .realistic-cloud:nth-child(5) {
        width: 700px;
        height: 400px;
        top: 80%;
        left: 40%;
        animation-duration: 80s;
    }

    /* Cloud Movement */
    @keyframes cloud-move {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(120%);
        }
    }

    /* Trajectories */
    .background .trajectory {
        position: absolute;
        width: 200%;
        height: 400px;
        background: none;
        border-top: 2px dashed rgba(1, 58, 113, 0.4); /* Dashed semi-transparent blue line */
        border-radius: 50%;
        animation: trajectory-animation 8s infinite ease-in-out;
    }

    .background .trajectory:nth-child(6) {
        top: 12%;
        left: -60%;
        animation-duration: 6s;
    }

    .background .trajectory:nth-child(7) {
        top: 35%;
        left: -70%;
        animation-duration: 9s;
    }

    .background .trajectory:nth-child(8) {
        top: 55%;
        left: -80%;
        animation-duration: 7s;
    }

    .background .trajectory:nth-child(9) {
        top: 75%;
        left: -90%;
        animation-duration: 10s;
    }

    /* Airplanes */
    .background .airplane {
        position: absolute;
        width: 30px;
        height: 30px;
        background: url('{{ asset('images-partner/airplane-icon.png') }}') no-repeat center center;
        background-size: contain;
        animation: airplane-fly 12s infinite ease-in-out;
    }

    .background .airplane:nth-child(10) {
        top: 15%;
        left: -10%;
        animation-duration: 8s;
    }

    .background .airplane:nth-child(11) {
        top: 45%;
        left: -20%;
        animation-duration: 10s;
    }

    .background .airplane:nth-child(12) {
        top: 65%;
        left: -30%;
        animation-duration: 9s;
    }

    @keyframes trajectory-animation {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(50%);
        }
    }

    @keyframes airplane-fly {
        0% {
            transform: translateX(0) rotate(0deg);
        }
        50% {
            transform: translateX(25%) rotate(3deg);
        }
        100% {
            transform: translateX(50%) rotate(0deg);
        }
    }


    .form-container {
        display: flex;
        flex-direction: column;
        max-width: 650px;
        width: 95%;
        margin: 2rem auto;
        background: linear-gradient(to bottom, #ffffff, #f0faff);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease-in-out;
    }

    .form-container:hover {
        transform: scale(1.02);
    }

    .form-image {
        height: 200px;
        background-image: url('{{ asset('images-partner/airplane.jpg') }}');
        background-size: cover;
        background-position: center;
    }

    .form-content {
        padding: 2rem;
    }

    .form-content h2 {
        color: #013a71;
        font-weight: bold;
        font-size: 1.8rem;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-content img.logo {
        max-width: 120px;
        margin: 0 auto 20px;
        display: block;
    }

    .form-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-control {
        padding-left: 45px;
        height: 50px;
        border-radius: 10px;
        border: 1px solid #ced4da;
        background: #f9f9f9;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        transition: border-color 0.3s, box-shadow 0.3s;
    }

    .form-control:focus {
        border-color: #013a71;
        box-shadow: 0 0 8px rgba(1, 58, 113, 0.3);
        background: #ffffff;
    }

    .invalid-feedback {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
    }

    .invalid-feedback .fas {
        margin-right: 5px;
    }

   .input-icon {
    position: absolute;
    left: 15px;              /* Distance depuis la gauche */
    top: 12px;               /* Ajustez manuellement pour aligner verticalement */
    transform: translateY(0); /* Supprimez le décalage si nécessaire */
    color: #6c757d;          /* Couleur de l'icône */
    font-size: 1.2rem;       /* Taille de l'icône */
    pointer-events: none;    /* Empêche l'interaction avec l'icône */
}

    .password-toggle {
    position: absolute;
    right: 15px;             /* Position à droite */
    top: 50%;                /* Centre verticalement */
    transform: translateY(-50%); /* Ajuste le centrage */
    cursor: pointer;         /* Curseur cliquable */
    color: #6c757d;          /* Couleur de l'icône */
    font-size: 1.2rem;       /* Taille de l'icône */
}

    .password-toggle:hover {
        color: #013a71;
    }

    .btn-primary {
        background: linear-gradient(90deg, #013a71, #015a91);
        border: none;
        color: white;
        border-radius: 12px;
        font-weight: bold;
        font-size: 1rem;
        padding: 12px;
        transition: transform 0.2s, box-shadow 0.2s, background-color 0.3s;
    }

    .btn-primary:hover {
        background: linear-gradient(90deg, #012a51, #014a71);
        transform: translateY(-2px);
        box-shadow: 0 5px 10px rgba(1, 58, 113, 0.3);
    }

    .captcha {
        text-align: center;
        margin-top: 1rem;
    }

    .captcha img {
        display: inline-block;
        height: 60px;
        width: 160px;
        margin-bottom: 0.5rem;
    }

    .captcha button {
        display: inline-block;
        margin-left: 1rem;
        background-color: #015a91;
        border: none;
        padding: 0.25rem 0.5rem;
        color: white;
        border-radius: 5px;
        font-size: 0.9rem;
    }

    .captcha button:hover {
        background-color: #012a51;
    }
</style>
{% endblock %}

{% block body %}
<div class="background">
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>
    <div class="trajectory"></div>
    <div class="trajectory"></div>
</div>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="form-container shadow-lg">
        <div class="form-image"></div>
        <div class="form-content">
            <img src="{{ asset('images-partner/logo miravia 1 3.png') }}" alt="Logo" class="logo">
            <h2>Bienvenue à bord – Inscrivez-vous !</h2>

            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

           <div class="row">
    <!-- Prénom -->
    <div class="col-md-6 form-group">
        <i class="fas fa-user input-icon"></i>
        {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
        <div class="invalid-feedback">
            <i class="fas fa-exclamation-circle"></i>
            {{ form_errors(form.prenom) }}
        </div>
    </div>

    <!-- Nom -->
    <div class="col-md-6 form-group">
        <i class="fas fa-user input-icon"></i>
        {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom de famille'}}) }}
        <div class="invalid-feedback">
            <i class="fas fa-exclamation-circle"></i>
            {{ form_errors(form.nom) }}
        </div>
    </div>
</div>

   <div class="row">
    <!-- Adresse -->
    <div class="col-md-6 form-group">
        <i class="fas fa-map-marker-alt input-icon"></i>
        {{ form_widget(form.adresse_utilisateur, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Adresse'
            }
        }) }}
        <div class="invalid-feedback">
            <i class="fas fa-exclamation-circle"></i>
            {{ form_errors(form.adresse_utilisateur) }}
        </div>
    </div>

    <!-- Date de naissance -->
    <div class="col-md-6 form-group">
        <i class="fas fa-calendar-alt input-icon"></i>
        {{ form_widget(form.birthday, {
            'attr': {
                'class': 'form-control flatpickr',
                'placeholder': 'Date de naissance',
                'aria-describedby': 'birthdayHelp'
            }
        }) }}
        <small id="birthdayHelp" class="form-text text-muted">
            Entrez votre date de naissance (JJ/MM/AAAA).
        </small>
        <div class="invalid-feedback">
            <i class="fas fa-exclamation-circle"></i>
            {{ form_errors(form.birthday) }}
        </div>
    </div>
</div>

            <!-- Email -->
            <div class="form-group">
                <i class="fas fa-envelope input-icon"></i>
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Adresse email'}}) }}
                <div class="invalid-feedback">
                    <i class="fas fa-exclamation-circle"></i>
                    {{ form_errors(form.email) }}
                </div>
            </div>

            <!-- Téléphone -->
            <div class="form-group">
                <i class="fas fa-phone input-icon"></i>
                {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone'}}) }}
                <div class="invalid-feedback">
                    <i class="fas fa-exclamation-circle"></i>
                    {{ form_errors(form.telephone) }}
                </div>
            </div>

            <!-- Mot de passe -->
            <div class="row">
                <div class="col-md-6 form-group">
                    <i class="fas fa-lock input-icon"></i>
                    {{ form_widget(form.mot_de_passe.first, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                    <i class="far fa-eye-slash password-toggle" onclick="togglePasswordVisibility(this)"></i>
                    <div class="invalid-feedback">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ form_errors(form.mot_de_passe.first) }}
                    </div>
                </div>
                <div class="col-md-6 form-group">
                    <i class="fas fa-lock input-icon"></i>
                    {{ form_widget(form.mot_de_passe.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez le mot de passe'}}) }}
                    <i class="far fa-eye-slash password-toggle" onclick="togglePasswordVisibility(this)"></i>
                    <div class="invalid-feedback">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ form_errors(form.mot_de_passe.second) }}
                    </div>
                </div>
            </div>

            <!-- Type utilisateur -->
            <div class="form-group">
                <i class="fas fa-users input-icon"></i>
                {{ form_widget(form.type_utilisateur, {'attr': {'class': 'form-control', 'placeholder': 'Type utilisateur'}}) }}
                <div class="invalid-feedback">
                    <i class="fas fa-exclamation-circle"></i>
                    {{ form_errors(form.type_utilisateur) }}
                </div>
            </div>

            <!-- CAPTCHA -->
            <div class="captcha">
                <p class="fw-bold">CAPTCHA</p>
                <img src="{{ path('captcha') }}" alt="Captcha" class="captcha-image">
                <button type="button" onclick="refreshCaptcha()">
                    <i class="fas fa-sync-alt"></i> Rafraîchir
                </button>
                <input type="text" name="captcha" class="form-control mt-2" placeholder="Entrez le texte ici" required>
            </div>

            <!-- Conditions générales -->
            <div class="form-check mt-3">
                {{ form_widget(form.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                <label class="form-check-label" for="{{ form.agreeTerms.vars.id }}">
                    J'accepte les <a href="#" class="text-primary">termes et conditions générales</a>.
                </label>
                <div class="invalid-feedback">
                    <i class="fas fa-exclamation-circle"></i>
                    {{ form_errors(form.agreeTerms) }}
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">S'inscrire</button>
            {{ form_end(form) }}
            <!-- Back to Login Link -->
            <p class="text-center mt-3">
                <a href="{{ path('app_login_controller_partner') }}" class="text-primary text-decoration-none">Retour à la page de connexion</a>
            </p>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(iconElement) {
    const input = iconElement.previousElementSibling; // Sélectionne l'input avant l'icône
    if (!input) return;

    if (input.type === 'password') {
        input.type = 'text';
        iconElement.classList.remove('fa-eye-slash');
        iconElement.classList.add('fa-eye');
    } else {
        input.type = 'password';
        iconElement.classList.remove('fa-eye');
        iconElement.classList.add('fa-eye-slash');
    }
}

    function refreshCaptcha() {
        const captchaImage = document.querySelector('.captcha-image');
        if (captchaImage) {
            captchaImage.src = "{{ path('captcha') }}?" + new Date().getTime();
        }
    }
    document.querySelector('form').addEventListener('submit', function(e) {
    const birthdayInput = document.querySelector('.flatpickr');
    if (!birthdayInput.value) {
        e.preventDefault();
        alert('Veuillez fournir une date de naissance valide.');
    }
});flatpickr('.flatpickr', {
        dateFormat: "d/m/Y",
        locale: Flatpickr.l10ns.fr, // Utilise la localisation française
    });
</script>
{% endblock %}