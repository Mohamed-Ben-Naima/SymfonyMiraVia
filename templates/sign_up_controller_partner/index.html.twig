{% block stylesheets %}
<link href="{{ asset('style-partner/bootstrap.min.css') }}" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<style>
    /* Global Styling */
    body {
        margin: 0;
        padding: 0;
        font-family: 'Roboto', sans-serif;
        background: linear-gradient(to bottom, #87CEEB, #E3FDFD);
        color: #333;
        overflow-x: hidden;
    }

    .background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    .background .realistic-cloud {
        position: absolute;
        background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.7) 60%, rgba(255, 255, 255, 0) 100%);
        filter: blur(15px);
        border-radius: 60% 40% 60% 40%;
        animation: cloud-move 40s linear infinite;
    }

    .background .trajectory {
        position: absolute;
        width: 200%;
        height: 400px;
        background: none;
        border-top: 2px dashed rgba(1, 58, 113, 0.4);
        border-radius: 50%;
        animation: trajectory-animation 8s infinite ease-in-out;
    }

    .background .trajectory:nth-child(7) { top: 12%; left: -60%; animation-duration: 6s; }
    .background .trajectory:nth-child(8) { top: 35%; left: -70%; animation-duration: 9s; }
    .background .trajectory:nth-child(9) { top: 55%; left: -80%; animation-duration: 7s; }
    .background .trajectory:nth-child(10) { top: 75%; left: -90%; animation-duration: 10s; }

    @keyframes cloud-move {
        0% { transform: translateX(0); }
        100% { transform: translateX(120%); }
    }

    @keyframes trajectory-animation {
        0% { transform: translateX(0); }
        100% { transform: translateX(50%); }
    }

    .form-container {
        display: flex;
        flex-direction: column;
        max-width: 650px;
        width: 95%;
        margin: 2rem auto;
        background: linear-gradient(to bottom, #ffffff, #f0faff);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease-in-out;
    }

    .form-container:hover {
        transform: scale(1.02);
    }

    .form-image {
        height: 200px;
        background-image: url('{{ asset('images-partner/airplane.jpg') }}');
        background-size: cover;
        background-position: center;
    }

    .form-content {
        padding: 2rem;
    }

    .form-content h2 {
        color: #013a71;
        font-weight: bold;
        font-size: 1.8rem;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-content img.logo {
        max-width: 100px;
        margin: 0 auto 20px;
        display: block;
    }

    .form-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-control {
        padding-right: 40px;
        padding-left: 40px;
        height: 50px;
        border-radius: 10px;
        border: 1px solid #ced4da;
        transition: border-color 0.3s, box-shadow 0.3s;
        background: #f9f9f9;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .form-control:focus {
        border-color: #013a71;
        box-shadow: 0 0 8px rgba(1, 58, 113, 0.3);
        background: #ffffff;
    }

    .is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 5px rgba(220, 53, 69, 0.5) !important;
    }

    .invalid-feedback {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        z-index: 5;
        font-size: 0.9rem;
        margin-left: 8px;
    }

    .password-toggle {
        position: absolute;
        right: 15px;
        top: 50%;
        margin-right: 10px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #6c757d;
        z-index: 5;
        font-size: 0.9rem;
    }

    .password-toggle:hover {
        color: #013a71;
    }

    .btn {
        border-radius: 12px;
        font-weight: bold;
        font-size: 1rem;
        padding: 12px;
        transition: transform 0.2s, box-shadow 0.2s, background-color 0.3s;
    }

    .btn-primary {
        background: linear-gradient(90deg, #013a71, #015a91);
        border: none;
        color: white;
    }

    .btn-primary:hover {
        background: linear-gradient(90deg, #012a51, #014a71);
        transform: translateY(-2px);
        box-shadow: 0 5px 10px rgba(1, 58, 113, 0.3);
    }

    .form-footer {
        text-align: center;
        margin-top: 1.5rem;
    }

    .form-footer a {
        color:rgb(9, 89, 164);
        font-weight: 500;
        text-decoration: none;
    }

    .form-footer a:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .form-container {
            margin: 1rem auto;
        }

        .form-content {
            padding: 1.5rem;
        }

        .form-content h2 {
            font-size: 1.5rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="background">
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>
    <div class="realistic-cloud"></div>

    <div class="trajectory"></div>
    <div class="trajectory"></div>
    <div class="trajectory"></div>
    <div class="trajectory"></div>
</div>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="form-container shadow-lg">
        <div class="form-image"></div>
        <div class="form-content">
            <img src="{{ asset('images-partner/logo miravia 1 3.png') }}" alt="Logo" class="logo">
            <h2>Bienvenue à bord – Inscrivez-vous !</h2>

            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            
            <div class="row">
                <div class="col-md-6 form-group">
                    <i class="fas fa-user input-icon"></i>
                    {{ form_widget(form.first_name, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                    {{ form_errors(form.first_name) }}
                </div>
                <div class="col-md-6 form-group">
                    <i class="fas fa-user input-icon"></i>
                    {{ form_widget(form.last_name, {'attr': {'class': 'form-control', 'placeholder': 'Nom de famille'}}) }}
                    {{ form_errors(form.last_name) }}
                </div>
            </div>

            <div class="form-group">
                <i class="fas fa-map-marker-alt input-icon"></i>
                {{ form_widget(form.address, {'attr': {'class': 'form-control', 'placeholder': 'Adresse'}}) }}
                {{ form_errors(form.address) }}
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <i class="fas fa-envelope input-icon"></i>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Adresse email'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="col-md-6 form-group">
                    <i class="fas fa-phone input-icon"></i>
                    {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'Numéro de téléphone'}}) }}
                    {{ form_errors(form.phone) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <i class="fas fa-lock input-icon"></i>
                    {{ form_widget(form.password.first, {
                        attr: {
                            class: 'form-control password-field',
                            placeholder: 'Mot de passe'
                        }
                    }) }}
                    <i class="far fa-eye-slash password-toggle" onclick="togglePasswordVisibility(this)" aria-label="Afficher/Masquer le mot de passe"></i>
                    {{ form_errors(form.password.first) }}
                </div>
                <div class="col-md-6 form-group">
                    <i class="fas fa-lock input-icon"></i>
                    {{ form_widget(form.password.second, {
                        attr: {
                            class: 'form-control password-field',
                            placeholder: 'Confirmer le mot de passe'
                        }
                    }) }}
                    <i class="far fa-eye-slash password-toggle" onclick="togglePasswordVisibility(this)" aria-label="Afficher/Masquer le mot de passe"></i>
                    {{ form_errors(form.password.second) }}
                </div>
            </div>

            <div class="form-group text-center">
                <p class="fw-bold">CAPTCHA</p>
                <img src="{{ path('captcha') }}" alt="Captcha" class="mb-2" style="height: 60px; width: 160px;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="refreshCaptcha()">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <input type="text" name="captcha" class="form-control mt-2" placeholder="Entrez le texte ici" required>
            </div>

            <div class="form-check">
                {{ form_widget(form.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                <label class="form-check-label" for="{{ form.agreeTerms.vars.id }}">
                    J'accepte les termes et conditions
                </label>
                {{ form_errors(form.agreeTerms) }}
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">S'inscrire</button>
            {{ form_end(form) }}

              <p class="text-center">
                <a href="{{ path('app_login_controller_partner') }}" class="text-primary text-decoration-none">Retour à la connexion</a>
            </p>
        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(iconElement) {
    const input = iconElement.parentElement.querySelector('.password-field');
    if (!input) return;

    if (input.type === 'password') {
        input.type = 'text';
        iconElement.classList.remove('fa-eye-slash');
        iconElement.classList.add('fa-eye');
    } else {
        input.type = 'password';
        iconElement.classList.remove('fa-eye');
        iconElement.classList.add('fa-eye-slash');
    }
}

function refreshCaptcha() {
    document.querySelector('img[alt="Captcha"]').src = "{{ path('captcha') }}?" + Date.now();
}
</script>

{% endblock %}