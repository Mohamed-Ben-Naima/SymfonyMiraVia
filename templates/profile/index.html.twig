{% extends 'base.client.html.twig' %}

{% block title %}Profil Utilisateur{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="profile-card p-4 shadow-sm">
                <!-- Profile Header -->
                <div class="text-center mb-5">
                    <div class="avatar-wrapper mb-3 position-relative">
                        <img src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : 'https://i.pravatar.cc/120' }}" 
                             class="rounded-circle object-fit-cover shadow-sm border border-3 border-primary" 
                             alt="Avatar utilisateur" 
                             style="width: 120px; height: 120px">
                    </div>
                    <h2 class="mb-2 fw-bold text-primary">{{ user.prenom }} {{ user.nom }}</h2>
                    <p class="text-muted mb-0">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        {{ user.adresseUtilisateur ?? 'Non renseignée' }}
                    </p>
                </div>

                <!-- Profile Form -->
                {{ form_start(form, {'attr': {'class': 'row g-4', 'novalidate': 'novalidate'}}) }}
                    <!-- Personal Info -->
                    <div class="col-md-6">
                        <h4 class="h5 text-primary mb-4">Informations Personnelles</h4>

                        <div class="mb-4">
                            {{ form_row(form.prenom, {
                                'label': 'Prénom',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.nom, {
                                'label': 'Nom',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.birthday, {
                                'label': 'Date de naissance',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.telephone, {
                                'label': 'Téléphone',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <!-- Security Section -->
                    <div class="col-md-6">
                        <h4 class="h5 text-primary mb-4">Sécurité</h4>

                        <div class="mb-4">
                            {{ form_row(form.email, {
                                'label': 'Adresse email',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.plainPassword, {
                                'label': 'Nouveau mot de passe',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.avatar, {
                                'label': 'Avatar',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.adresse_utilisateur, {
                                'label': 'Adresse',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="col-12 text-end mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Mettre à jour
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}