{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste des demandes partenaires{% endblock %}

{% block body %}
<style>
html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #fdfdfd;
    overflow: hidden;
    transition: background-color 0.3s ease, color 0.3s ease;
}

body.dark-mode {
    background-color: #1a202c;
    color: #e2e8f0;
}

.no-scroll {
    overflow: hidden;
}

.example-wrapper {
    margin: 0 auto;
    padding: 20px;
    margin-left: 15%;
    max-height: calc(100vh - 40px);
    overflow: visible;
}

.example-wrapper h1 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 40px;
    color: rgb(0, 0, 0);
}

body.dark-mode .example-wrapper h1 {
    color: #e2e8f0;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.search-box {
    position: relative;
    width: 87%;
}

.search-box input {
    width: 100%;
    padding: 8px 30px 8px 12px;
    border: 1px solid #7D8C6D;
    border-radius: 6px;
    font-size: 14px;
    background-color: #fff;
    color: #000;
}

body.dark-mode .search-box input {
    background-color: #2d3748;
    border-color: #4a5568;
    color: #e2e8f0;
}

#statusFilter {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #7D8C6D;
    font-size: 14px;
    margin-left: -1%;
    background-color: #fff;
    color: #000;
}

body.dark-mode #statusFilter {
    background-color: #2d3748;
    border-color: #4a5568;
    color: #e2e8f0;
}

.header button {
    padding: 8px 31px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.header button:hover {
    background-color: #5c7352;
}

body.dark-mode .header button {
    background-color: #4a90e2;
}

body.dark-mode .header button:hover {
    background-color: #357abd;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background-color: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.05);
    table-layout: fixed;
}

body.dark-mode table {
    background-color: #2d3748;
    box-shadow: 0 0 8px rgba(0,0,0,0.3);
}

th, td {
    padding: 10px;
    text-align: left;
    word-wrap: break-word;
}

th {
    background-color: rgb(176, 203, 223);
    color: black;
}

body.dark-mode th {
    background-color: #4a5568;
    color: #e2e8f0;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

body.dark-mode tr:nth-child(even) {
    background-color: #2d3748;
}

tr:hover {
    background-color: #81A8C5;
    color: white;
}

body.dark-mode tr:hover {
    background-color: #4a90e2;
    color: #e2e8f0;
}

.actions {
    display: flex;
    gap: 8px;
}

.actions button {
    background-color: #ccc;
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
}

body.dark-mode .actions button {
    background-color: #4a5568;
    color: #e2e8f0;
}

.actions button:hover {
    background-color: #999;
    color: white;
}

body.dark-mode .actions button:hover {
    background-color: #718096;
}

@media (max-width: 992px) {
    .example-wrapper {
        margin-left: 5%;
        margin-right: 5%;
        padding: 10px;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box,
    #statusFilter,
    .header button {
        width: 100%;
        margin: 5px 0;
    }

    #statusFilter {
        margin-left: 0;
    }

    table {
        font-size: 12px;
    }

    th, td {
        padding: 6px;
    }

    .actions {
        flex-direction: column;
        align-items: flex-start;
    }

    .actions button {
        width: 100%;
        margin-bottom: 4px;
    }
}

@media (max-width: 768px) {
    table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }
}

.actions button.consulter-btn {
    background-color: #7D8C6D;
    color: white;
    font-size: 14px;
}

body.dark-mode .actions button.consulter-btn {
    background-color: #4a90e2;
}

.actions button.consulter-btn:hover {
    background-color: #5c7352;
}

body.dark-mode .actions button.consulter-btn:hover {
    background-color: #357abd;
}

.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #fff;
    margin: 0 auto;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 40%;
    height: auto;
    box-shadow: 0 10px 20px rgba(87, 104, 202, 0.5);
    max-width: 600px;
    max-height: 80vh;
    overflow-y: auto;
    text-align: left;
}

body.dark-mode .modal-content {
    background-color: #2d3748;
    border-color: #4a5568;
    color: #e2e8f0;
}

.modal-header {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

body.dark-mode .modal-header {
    color: #e2e8f0;
}

.modal-header .close-btn {
    background: none;
    border: none;
    font-size: 20px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    outline: none;
    transition: color 0.3s ease;
}

body.dark-mode .modal-header .close-btn {
    color: #e2e8f0;
}

.modal-header .close-btn:hover {
    color: #ff0000;
}

.modal-body {
    margin-bottom: 20px;
    font-size: 14px;
}

body.dark-mode .modal-body {
    color: #e2e8f0;
}

.modal-body p {
    margin: 10px 0;
    line-height: 1.6;
}

.modal-footer {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.modal-footer button {
    padding: 10px 20px;
    font-size: 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.modal-footer .download-btn {
    background-color: #013A71;
    color: white;
}

body.dark-mode .modal-footer .download-btn {
    background-color: #4a90e2;
}

.modal-footer .download-btn:hover {
    background-color: rgb(24, 95, 162);
}

body.dark-mode .modal-footer .download-btn:hover {
    background-color: #357abd;
}

.modal-footer .cancel-btn {
    background-color: #7D8C6D;
    color: white;
}

body.dark-mode .modal-footer .cancel-btn {
    background-color: #4a90e2;
}

.modal-footer .cancel-btn:hover {
    background-color: #5c7352;
}

body.dark-mode .modal-footer .cancel-btn:hover {
    background-color: #357abd;
}

@media (max-width: 768px) {
    .modal-content {
        width: 90%;
        margin: 2% auto;
    }
}

.toggle-dark-mode {
    padding: 8px 16px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.toggle-dark-mode:hover {
    background-color: #5c7352;
}

body.dark-mode .toggle-dark-mode {
    background-color: #4a90e2;
}

body.dark-mode .toggle-dark-mode:hover {
    background-color: #357abd;
}
.accept-btn {
    background-color: #7D8C6D;
    color: white;
    border: none;
    padding: 10px 15px;
    cursor: pointer;
    margin-right: 10px;
}

.refuse-btn {
    background-color:rgb(201, 59, 49);
    color: white;
    border: none;
    padding: 10px 15px;
    cursor: pointer;
    margin-right: 10px;
}

.accept-btn:hover, .refuse-btn:hover {
    opacity: 0.8;
}
</style>

<div class="example-wrapper">
    <h1>Liste des demandes partenaires</h1>

    <div class="header">
        <div class="search-box">
            <input type="text" id="search" placeholder="Rechercher ...">
        </div>
        <select id="statusFilter">
            <option value="">Tous les états</option>
            <option value="Refusée">Refusée</option>
            <option value="Acceptée">Acceptée</option>
            <option value="En attente">En attente</option>
        </select>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nom de demandeur</th>
                <th>Téléphone</th>
                <th>Email</th>
                <th>Adresse</th>
                <th>Date de demande</th>
                <th>Type d'activité</th>
                <th>Etat</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="userTable">
            {% for demande in demandes %}
            <tr>
                <td>{{ demande.id }}</td>
                <td>{{ demande.demandeur }}</td>
                <td>{{ demande.telephone }}</td>
                <td>{{ demande.email }}</td>
                <td>{{ demande.adresse }}</td>
                <td>{{ demande.dateDemande ? demande.dateDemande|date('Y-m-d') : '' }}</td>
                <td>{{ demande.typeActivite }}</td>
                <td>{{ demande.etat }}</td>
                <td class="actions">
                    <button 
                        class="consulter-btn" 
                        data-id="{{ demande.id }}"
                        data-demandeur="{{ demande.demandeur }}"
                        data-telephone="{{ demande.telephone }}"
                        data-email="{{ demande.email }}"
                        data-adresse="{{ demande.adresse }}"
                        data-date-demande="{{ demande.dateDemande ? demande.dateDemande|date('Y-m-d') : '' }}"
                        data-type-activite="{{ demande.typeActivite }}"
                        data-etat="{{ demande.etat }}"
                        data-description="{{ demande.description|default('Aucune description disponible') }}"
                        data-preuve="{{ demande.preuve|default('') }}"
                        onclick="viewDetails(this)"
                    >
                        Consulter
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Modal for displaying details -->
<div id="detailsModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span>Détail de la demande</span>
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body" id="modalBody">
            <!-- Les détails seront remplis dynamiquement -->
        </div>
<div class="modal-footer">
    <button class="accept-btn" onclick="updateStatus('Acceptée')">Accepter</button>
    <button class="refuse-btn" onclick="updateStatus('Refusée')">Refuser</button>
    <button class="download-btn" id="downloadButton" style="display: none;">Télécharger la preuve</button>
</div>
    </div>
</div>

<script>
function toggleDarkMode() {
    document.body.classList.toggle('dark-mode');
    localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
}

document.addEventListener('DOMContentLoaded', function () {
    // Apply dark mode if previously selected
    if (localStorage.getItem('darkMode') === 'true') {
        document.body.classList.add('dark-mode');
    }

    // Toggle dark mode
    window.toggleDarkMode = function () {
        document.body.classList.toggle('dark-mode');
        localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
    };

    // Update the status of a request
    window.updateStatus = function (newStatus) {
        const modal = document.getElementById('detailsModal');
        const demandeId = modal.getAttribute('data-id');

        if (!demandeId) return;

        fetch(`/admin/demande/partner/update-status`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ id: demandeId, etat: newStatus }),
        })
            .then((response) => {
                if (response.ok) {
                    alert(
                        `La demande a été ${
                            newStatus === 'Acceptée' ? 'acceptée' : 'refusée'
                        } avec succès.`
                    );
                    closeModal();
                    location.reload(); // Reload the page to reflect changes
                } else {
                    alert(
                        'Une erreur est survenue lors de la mise à jour du statut.'
                    );
                }
            })
            .catch((error) => {
                console.error('Erreur:', error);
                alert('Une erreur est survenue.');
            });
    };

    // View details of the request
    window.viewDetails = function (button) {
        const demandeur = button.getAttribute('data-demandeur');
        const telephone = button.getAttribute('data-telephone');
        const email = button.getAttribute('data-email');
        const adresse = button.getAttribute('data-adresse');
        const dateDemande = button.getAttribute('data-date-demande');
        const typeActivite = button.getAttribute('data-type-activite');
        const etat = button.getAttribute('data-etat');
        const description = button.getAttribute('data-description');
        const preuve = button.getAttribute('data-preuve');

        const modalBody = document.getElementById('modalBody');
        modalBody.innerHTML = `
            <p><strong>Nom de demandeur :</strong> ${demandeur}</p>
            <p><strong>Téléphone :</strong> ${telephone}</p>
            <p><strong>Email :</strong> ${email}</p>
            <p><strong>Adresse :</strong> ${adresse}</p>
            <p><strong>Date de demande :</strong> ${dateDemande}</p>
            <p><strong>Type d'activité :</strong> ${typeActivite}</p>
            <p><strong>État :</strong> ${etat}</p>
            <p><strong>Description :</strong> ${description}</p>
            <p><strong>Preuve :</strong> ${
                preuve
                    ? `<a href="${preuve}" target="_blank">Voir la preuve</a>`
                    : 'Aucune preuve disponible'
            }</p>
        `;

        const downloadButton = document.getElementById('downloadButton');
        if (preuve) {
            downloadButton.style.display = 'inline-block';
            downloadButton.onclick = () => window.open(preuve, '_blank');
        } else {
            downloadButton.style.display = 'none';
        }

        const modal = document.getElementById('detailsModal');
        modal.style.display = 'block';
        modal.setAttribute('data-id', button.getAttribute('data-id')); // Store demande ID
        document.body.classList.add('no-scroll');
    };

    // Close the modal
    window.closeModal = function () {
        const modal = document.getElementById('detailsModal');
        modal.style.display = 'none';
        document.body.classList.remove('no-scroll');
    };

    // Filter table rows
    function filterTable() {
        const searchFilter = document.getElementById('search').value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value;
        const rows = document.querySelectorAll('#userTable tr');

        rows.forEach((row) => {
            const cells = row.querySelectorAll('td');
            const textMatch = Array.from(cells)
                .slice(0, 8)
                .some((cell) =>
                    cell.textContent.toLowerCase().includes(searchFilter)
                );

            const etat = cells[7]?.textContent?.trim() || '';
            const etatMatch = statusFilter === '' || etat === statusFilter;

            row.style.display = textMatch && etatMatch ? '' : 'none';
        });
    }

    // Add event listeners for search and filter
    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);
});
</script>
{% endblock %}