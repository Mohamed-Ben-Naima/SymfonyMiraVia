{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste des demandes partenaires{% endblock %}

{% block body %}
<style>
html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #fdfdfd;
    overflow: hidden; /* Supprime le défilement général */
}
.no-scroll {
    overflow: hidden;
}

.example-wrapper {
    margin: 0 auto;
    padding: 20px;
    margin-left: 15%;
    max-height: calc(100vh - 40px); /* Ajuste la hauteur */
    overflow: visible; /* Supprime le défilement interne */
}

.example-wrapper h1 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 40px;
    color: rgb(0, 0, 0);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.search-box {
    position: relative;
    width: 87%;
}

.search-box input {
    width: 100%;
    padding: 8px 30px 8px 12px;
    border: 1px solid #7D8C6D;
    border-radius: 6px;
    font-size: 14px;
}

#statusFilter {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #7D8C6D;
    font-size: 14px;
    margin-left: -1%;
}

.header button {
    padding: 8px 31px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.header button:hover {
    background-color: #5c7352;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background-color: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.05);
    table-layout: fixed; /* Fixe la largeur des colonnes */
}

th, td {
    padding: 10px;
    text-align: left;
    word-wrap: break-word; /* Permet le retour à la ligne dans les cellules */
}

th {
    background-color: rgb(176, 203, 223);
    color: black;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

tr:hover {
    background-color: #81A8C5;
    color: white;
}

.actions {
    display: flex;
    gap: 8px;
}

.actions button {
    background-color: #ccc;
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
}

.actions button:hover {
    background-color: #999;
    color: white;
}

@media (max-width: 992px) {
    .example-wrapper {
        margin-left: 5%;
        margin-right: 5%;
        padding: 10px;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box,
    #statusFilter,
    .header button {
        width: 100%;
        margin: 5px 0;
    }

    #statusFilter {
        margin-left: 0;
    }

    table {
        font-size: 12px;
    }

    th, td {
        padding: 6px;
    }

    .actions {
        flex-direction: column;
        align-items: flex-start;
    }

    .actions button {
        width: 100%;
        margin-bottom: 4px;
    }
}

@media (max-width: 768px) {
    table {
        display: block;
        overflow-x: auto; /* Permet le défilement horizontal uniquement si nécessaire */
        white-space: nowrap;
    }
}

.actions button.consulter-btn {
    background-color: #7D8C6D;
    color: white;
            font-size: 14px;

}

.actions button.consulter-btn:hover {
    background-color: #5c7352;
}

.modal {
    display: none; /* Par défaut, caché */
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto; /* Défilement interne uniquement */
    background-color: rgba(0, 0, 0, 0.5); /* Fond semi-transparent */
}

.modal-content {
    position: fixed; /* Permet de positionner l'élément par rapport à la fenêtre */
    top: 50%; /* Centre verticalement */
    left: 50%; /* Centre horizontalement */
    transform: translate(-50%, -50%); /* Ajuste pour centrer parfaitement */
    background-color: #fff;
    margin: 0 auto;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 40%;
    height: auto; /* Ajuste automatiquement la hauteur au contenu */
    box-shadow: 0 10px 20px rgba(87, 104, 202, 0.5);
    max-width: 600px;
    max-height: 80vh;
    overflow-y: auto; /* Ajoute un défilement interne si nécessaire */
    text-align: left;
}

.modal-header {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header .close-btn {
    background: none;
    border: none;
    font-size: 20px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    outline: none;
    transition: color 0.3s ease;
}

.modal-header .close-btn:hover {
    color: #ff0000;
}

.modal-body {
    margin-bottom: 20px;
    font-size: 14px;
}

.modal-body p {
    margin: 10px 0;
    line-height: 1.6;
}

.modal-footer {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.modal-footer button {
    padding: 10px 20px;
    font-size: 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.modal-footer .download-btn {
    background-color: #013A71;
    color: white;
}

.modal-footer .download-btn:hover {
    background-color: rgb(24, 95, 162);
}

.modal-footer .cancel-btn {
    background-color: #7D8C6D;
    color: white;
}

.modal-footer .cancel-btn:hover {
    background-color: #5c7352;
}

body.no-scroll {
    overflow: hidden; /* Désactive le défilement global */
}

@media (max-width: 768px) {
    .modal-content {
        width: 90%;
        margin: 2% auto;
    }
}
</style>

<div class="example-wrapper">
    <h1>Liste des demandes partenaires</h1>

    <div class="header">
        <div class="search-box">
            <input type="text" id="search" placeholder="Rechercher ...">
        </div>

  <select id="statusFilter">
    <option value="">Tous les états</option>
    <option value="Refusée">Refusée</option>
    <option value="Acceptée">Acceptée</option>
    <option value="En attente">En attente</option>
</select>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nom de demandeur</th>
                <th>Téléphone</th>
                <th>Email</th>
                <th>Adresse</th>
                <th>Date de demande</th>
                <th>Type d'activité</th>
                <th>Etat</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="userTable">
            {% for demande in demandes %}
            <tr>
                <td>{{ demande.id }}</td>
                <td>{{ demande.demandeur }}</td>
                <td>{{ demande.telephone }}</td>
                <td>{{ demande.email }}</td>
                <td>{{ demande.adresse }}</td>
                <td>{{ demande.dateDemande ? demande.dateDemande|date('Y-m-d') : '' }}</td>
                <td>{{ demande.typeActivite }}</td>
                <td>{{ demande.etat }}</td>
                <td class="actions">
                    <!-- Ajout des données dans des attributs `data-*` -->
                    <button 
                        class="consulter-btn" 
                        data-id="{{ demande.id }}"
                        data-demandeur="{{ demande.demandeur }}"
                        data-telephone="{{ demande.telephone }}"
                        data-email="{{ demande.email }}"
                        data-adresse="{{ demande.adresse }}"
                        data-date-demande="{{ demande.dateDemande ? demande.dateDemande|date('Y-m-d') : '' }}"
                        data-type-activite="{{ demande.typeActivite }}"
                        data-etat="{{ demande.etat }}"
                        data-description="{{ demande.description|default('Aucune description disponible') }}"
                        data-preuve="{{ demande.preuve|default('') }}"
                        onclick="viewDetails(this)"
                    >
                        Consulter
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Modal for displaying details -->
<div id="detailsModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span>Détail de la demande</span>
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body" id="modalBody">
            <!-- Les détails seront remplis dynamiquement -->
        </div>
        <div class="modal-footer">
            <button class="download-btn" id="downloadButton" style="display: none;">Télécharger la preuve</button>
            <button class="cancel-btn" onclick="closeModal()">Fermer</button>
        </div>
    </div>
</div>

<script>
    // Fonction pour afficher les détails dans le modal
function viewDetails(button) {
    // Récupérer les données depuis les attributs `data-*`
    const demandeur = button.getAttribute('data-demandeur');
    const telephone = button.getAttribute('data-telephone');
    const email = button.getAttribute('data-email');
    const adresse = button.getAttribute('data-adresse');
    const dateDemande = button.getAttribute('data-date-demande');
    const typeActivite = button.getAttribute('data-type-activite');
    const etat = button.getAttribute('data-etat');
    const description = button.getAttribute('data-description');
    const preuve = button.getAttribute('data-preuve');

    // Mettre à jour le contenu du modal
    const modalBody = document.getElementById('modalBody');
    modalBody.innerHTML = `
        <p><strong>Nom de demandeur :</strong> ${demandeur}</p>
        <p><strong>Téléphone :</strong> ${telephone}</p>
        <p><strong>Email :</strong> ${email}</p>
        <p><strong>Adresse :</strong> ${adresse}</p>
        <p><strong>Date de demande :</strong> ${dateDemande}</p>
        <p><strong>Type d'activité :</strong> ${typeActivite}</p>
        <p><strong>État :</strong> ${etat}</p>
        <p><strong>Description :</strong> ${description}</p>
        <p><strong>Preuve :</strong> ${
            preuve 
            ? `<a href="${preuve}" target="_blank">${preuve}</a>`
            : 'Aucune preuve disponible'
        }</p>
    `;

    // Afficher ou masquer le bouton de téléchargement
    const downloadButton = document.getElementById('downloadButton');
    if (preuve) {
        downloadButton.style.display = 'inline-block';
        downloadButton.onclick = () => window.location.href = preuve; // Redirect to the file URL
    } else {
        downloadButton.style.display = 'none';
    }

    // Afficher le modal
    const modal = document.getElementById('detailsModal');
    modal.style.display = 'block';
    document.body.classList.add('no-scroll');
}

    // Fonction pour fermer le modal
    function closeModal() {
        const modal = document.getElementById('detailsModal');
        modal.style.display = 'none';
        document.body.classList.remove('no-scroll');
    }

    // Ajouter les filtres de recherche et état
    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

function filterTable() {
    console.log('Filtrage du tableau...'); // Log pour débogage
    const searchFilter = document.getElementById('search').value.toLowerCase(); // Texte de recherche
    const statusFilter = document.getElementById('statusFilter').value; // Valeur sélectionnée dans le filtre d'état
    const rows = document.querySelectorAll('#userTable tr'); // Récupère toutes les lignes du tableau

    rows.forEach(row => {
        const cells = row.querySelectorAll('td'); // Récupère toutes les cellules de la ligne
        const textMatch = Array.from(cells).slice(0, 9) // Vérifie la correspondance avec le texte de recherche
            .some(cell => cell.textContent.toLowerCase().includes(searchFilter));

        const etat = cells[7]?.textContent?.trim() || ''; // Récupère la valeur de la colonne "Etat"
        console.log('Etat extrait:', etat, 'Filtre sélectionné:', statusFilter); // Log pour voir les valeurs d'état

        // Vérifie si l'état correspond ou si aucun filtre n'est appliqué
        const etatMatch = statusFilter === "" || etat === statusFilter;

        // Affiche la ligne si elle correspond au texte et au filtre, sinon la masque
        row.style.display = (textMatch && etatMatch) ? '' : 'none';
    });
}
</script>
{% endblock %}
