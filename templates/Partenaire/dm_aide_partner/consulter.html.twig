
<style>
  .btn-download {
      background-color: #86b7fe; /* Couleur de fond par défaut */
      color: #013a71; /* Couleur du texte */
      border: none; /* Pas de bordure */
      padding: 10px 20px; /* Espacement interne */
      font-size: 16px; /* Taille de la police */
      border-radius: 5px; /* Coins arrondis */
      transition: all 0.3s ease-in-out; /* Transition fluide */
  }

  .btn-download:hover {
      background-color: #0056b3; /* Couleur de fond au survol */
      color: #ffffff; /* Couleur du texte au survol */
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Ombre au survol */
      transform: scale(1.05); /* Zoom léger au survol */
  }
</style>
<!-- Fenêtre modale pour afficher les détails -->
<div class="modal fade" id="viewDemandeModal{{ loop.index }}" tabindex="-1" aria-labelledby="viewDemandeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="viewDemandeModalLabel">Détails de la demande</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><strong>Client :</strong> {{ aide.client_nom }}</p>
        <p><strong>Type d'aide :</strong> {{ aide.type_aide }}</p>
        <p><strong>Description :</strong> {{ aide.description }}</p>
        <p><strong>Montant :</strong> {{ aide.montant_demande }} €</p>
        <p><strong>Date de demande :</strong> {{ aide.date_demande|date('d M Y') }}</p>
        <p><strong>Status :</strong> 
          {% if aide.status == 'en_attente' %}
            En attente
          {% elseif aide.status == 'acceptee' %}
            Acceptée
          {% elseif aide.status == 'refusee' %}
            Refusée
          {% elseif aide.status == 'en_traitement' %}
            En traitement
          {% endif %}
        </p>
        <p><strong>Preuves :</strong> 
          {% if aide.preuves %}
            <img 
              src="{{ asset('uploads/preuves/' ~ aide.preuves) }}" 
              alt="Preuve" 
              style="max-width: 100%; height: auto;"
            >
          {% else %}
            <span class="text-muted">Aucune preuve</span>
          {% endif %}
        </p>
      </div>
      <div class="modal-footer justify-content-center">
        <button class="btn btn-download" onclick="generatePDF({{ loop.index }})">Télécharger</button>
      </div>
    </div>
  </div>
</div>