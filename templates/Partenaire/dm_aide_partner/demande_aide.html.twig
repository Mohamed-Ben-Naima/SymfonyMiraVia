{% extends 'Partenaire/basePartner.html.twig' %}

{% block title %}Demandes d'aide{% endblock %}

{% block body %}
<div class="content">
  <h1 class="mb-4" style="color: #013a71; font-size: 30px;">Liste des demandes d'aide</h1>
  <div class="table-responsive">
    <!-- Bouton pour afficher le formulaire dans une modale -->
    <button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addDemandeModal">Ajouter une demande</button>

    <table class="table table-bordered table-striped">
      <thead class="thead-light">
        <tr>
          <th>Nom de client</th>
          <th>Type d'aide</th>
          <th>Description</th>
          <th>Montant</th>
          <th>Date de demande</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for aide in demandes_aide %}
        <tr>
          <td>{{ aide.client_nom }} {{ aide.client_prenom }}</td>
          <td>{{ aide.type_aide }}</td>
          <td>{{ aide.description }}</td>
          <td>{{ aide.montant_demande }} €</td>
          <td>{{ aide.date_demande|date('Y-m-d') }}</td>
          <td>{{ aide.status }}</td>
          <td>
            <button class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#detailsModal" onclick="populateModal(this)">Consulter</button>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<!-- Modal pour ajouter une demande -->
<div class="modal fade" id="addDemandeModal" tabindex="-1" aria-labelledby="addDemandeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addDemandeModalLabel">Ajouter une demande</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="{{ path('add_demande') }}" method="post" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label for="id_client" class="form-label">ID Client</label>
            <input type="number" class="form-control" id="id_client" name="id_client" required>
          </div>
          <div class="mb-3">
            <label for="type_aide" class="form-label">Type d'aide</label>
            <select class="form-select" id="type_aide" name="type_aide" required>
              <option value="financiere">Financière</option>
              <option value="non_financiere">Non Financière</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="3" required></textarea>
          </div>
          <div class="mb-3">
            <label for="montant_demande" class="form-label">Montant</label>
            <input type="number" class="form-control" id="montant_demande" name="montant_demande" required>
          </div>
          <div class="mb-3">
            <label for="date_demande" class="form-label">Date</label>
            <input type="date" class="form-control" id="date_demande" name="date_demande" required>
          </div>
          <div class="mb-3">
            <label for="preuve" class="form-label">Preuve</label>
            <input type="file" class="form-control" id="preuve" name="preuve">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Ajouter</button>
        </div>
      </form>
    </div>
  </div>
</div>