
<!-- Modale de confirmation de suppression -->
<div class="modal fade" id="deleteBenevolatModal" tabindex="-1" aria-labelledby="deleteBenevolatModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteBenevolatModalLabel">Confirmer la Suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer le bénévolat suivant ?</p>
                <ul>
                    <li><strong>Titre :</strong> <span id="modalBenevolatTitle"></span></li>
                    <li><strong>Date :</strong> <span id="modalBenevolatDate"></span></li>
                    <li><strong>Lieu :</strong> <span id="modalBenevolatLocation"></span></li>
                </ul>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-annuler" data-bs-dismiss="modal">
                <i class="bi bi-x-circle me-1"></i>Annuler</button>
                <form id="deleteBenevolatForm" action="{{ path('delete_benevolat', {'id': 0}) }}" method="post" style="display: inline;">
                <input type="hidden" name="benevolatId" id="modalBenevolatId">
                <button type="submit" class="btn btn-cancel">
                    <i class="bi bi-trash"></i>Supprimer
                </button>
            </form>
            </div>
        </div>
    </div>
</div>
