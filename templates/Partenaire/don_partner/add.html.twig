<div class="modal fade" id="addDonModal" tabindex="-1" aria-labelledby="addDonModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addDonModalLabel">Ajouter un Don</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="{{ path('add_don') }}">
        <div class="modal-body">
          <div class="mb-3">
            <label for="clientName" class="form-label">Nom du Client</label>
            <input type="text" class="form-control" id="clientName" name="clientName" required>
          </div>
          <div class="mb-3">
            <label for="montant" class="form-label">Montant</label>
            <input type="number" step="0.01" class="form-control" id="montant" name="montant" required>
          </div>
          <div class="mb-3">
            <label for="dateDon" class="form-label">Date du Don</label>
            <input type="datetime-local" class="form-control" id="dateDon" name="dateDon" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Ajouter</button>
        </div>
      </form>
    </div>
  </div>
</div>