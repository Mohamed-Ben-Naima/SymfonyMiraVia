{% extends 'Partenaire/basePartner.html.twig' %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="content">
    <div class="container">
        <div class="row">
            <!-- Partie gauche -->
            <div class="col-6">
                <div class="card user-profile">
                    <!-- ✅ FORMULAIRE AVATAR -->
                    <form method="POST" action="{{ path('app_update_avatar') }}" enctype="multipart/form-data">
                        <div class="user-avatar">
                            <img src="{{ asset(avatarUrl) }}" alt="Avatar" class="avatar">
                            <label class="avatar-edit">
                                <input type="file" name="avatar" accept="image/*" hidden onchange="this.form.submit()">
                                <i class="fas fa-plus-circle"></i>
                            </label>
                        </div>
                    </form>

                    <!-- ✅ FORMULAIRE LOGO -->
                    <form method="POST" action="{{ path('app_update_logo') }}" enctype="multipart/form-data">
                        <div class="company-info">
                            <div class="company-logo-wrapper">
                                <img src="{{ asset(logoUrl) }}" alt="Logo de l'entreprise" class="logo">
                                <label class="logo-edit">
                                    <input type="file" name="logo" accept="image/*" hidden onchange="this.form.submit()">
                                    <i class="fas fa-edit"></i>
                                </label>
                            </div>
                            <div class="company-text">
                                <strong>{{ partenaire.nomEntreprise }}</strong>
                                <div class="company-url">{{ partenaire.siteWeb }}</div>
                            </div>
                        </div>
                    </form>

                    <!-- ✅ FORMULAIRE MOT DE PASSE -->
                    <form method="POST" action="{{ path('app_update_password') }}">
                        <div class="about">
                            <div class="form-group mb-3">
                                <label for="email">Email</label>
                                <input type="email" id="email" class="form-control-profil" value="{{ user.email }}" readonly>
                            </div>
                            <div class="form-group mb-3">
                                <label for="oldPassword">Ancien mot de passe</label>
                                <input type="password" id="oldPassword" name="oldPassword" class="form-control-profil" placeholder="••••••••">
                            </div>
                            <div class="form-group mb-3">
                                <label for="newPassword">Nouveau mot de passe</label>
                                <input type="password" id="newPassword" name="newPassword" class="form-control-profil" placeholder="••••••••">
                            </div>
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Partie droite : ✅ INFORMATIONS GÉNÉRALES -->
            <div class="col-6">
                <form method="POST" action="{{ path('app_update_profil') }}">
                    <div class="card">
                        <h6 class="text-primary">Informations personnelles</h6>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="nom">Nom</label>
                                <input type="text" class="form-control-profil" id="nom" name="nom" value="{{ user.nom }}">
                            </div>
                            <div class="form-group">
                                <label for="prenom">Prénom</label>
                                <input type="text" class="form-control-profil" id="prenom" name="prenom" value="{{ user.prenom }}">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="telephone">Téléphone</label>
                                <input type="text" class="form-control-profil" id="telephone" name="telephone" value="{{ user.telephone }}">
                            </div>
                            <div class="form-group">
                                <label for="adresse">Adresse</label>
                                <input type="text" class="form-control-profil" id="adresse" name="adresse" value="{{ user.adresseUtilisateur }}">
                            </div>
                        </div>

                        <h6 class="text-primary">Informations professionnelles</h6>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="entreprise">Nom de l'entreprise</label>
                                <input type="text" class="form-control-profil" id="entreprise" name="entreprise" value="{{ partenaire.nomEntreprise }}">
                            </div>
                            <div class="form-group">
                                <label for="activite">Type d’activité</label>
                                <input type="text" class="form-control-profil" id="activite" name="activite" value="{{ partenaire.typeActivite }}">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="siteweb">Site Web</label>
                                <input type="url" class="form-control-profil" id="siteweb" name="siteweb" value="{{ partenaire.siteWeb }}">
                            </div>
                            <div class="form-group">
                                <label for="adresseEntreprise">Adresse de l'entreprise</label>
                                <input type="text" class="form-control-profil" id="adresseEntreprise" name="adresseEntreprise" value="{{ partenaire.adresse }}">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="tel_entreprise">Téléphone entreprise</label>
                            <input type="text" class="form-control-profil" id="tel_entreprise" name="tel_entreprise" value="{{ partenaire.telephone }}">
                        </div>

                        <div class="text-right">
                            <button type="button" class="btn btn-secondary" onclick="window.location.reload();">Annuler</button>
                            <button type="submit" class="btn btn-primary">Mettre à jour</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Notifications SweetAlert -->
{% for message in app.flashes('success') %}
<script>
    Swal.fire({
        icon: 'success',
        title: '{{ message|e('js') }}',
        showConfirmButton: false,
        timer: 2500
    });
</script>
{% endfor %}

{% for message in app.flashes('error') %}
<script>
    Swal.fire({
        icon: 'error',
        title: '{{ message|e('js') }}',
        showConfirmButton: false,
        timer: 3000
    });
</script>
{% endfor %}

<script src="{{ asset('js/partner/profil.js') }}"></script>
<link href="{{ asset('style-partner/profil.css') }}" rel="stylesheet">
{% endblock %}
