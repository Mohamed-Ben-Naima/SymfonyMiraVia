{% extends 'Partenaire/basePartner.html.twig' %}

{% block title %}À propos de nous{% endblock %}


{% block body %}
 <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
  <link href="{{ asset('style-partner/aboutstyle.css') }}" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <div class="content">

    <!-- Loader -->
    <div id="loader">
      <div class="spinner"></div>
    </div>

    <!-- Bannière -->
<div class="banner">
  <div class="banner-content">
    <h1>Ensemble, construisons un monde solidaire</h1>
    <p>Avec Miravia, chaque action compte</p>
    <a href="#about" class="btn">Découvrir notre mission</a>
  </div>
</div>


    <!-- À propos -->
    <section id="about" class="about-content" data-aos="fade-up">
     <img src="{{ asset('images-partner/3planet1-960x640 - Ryan Zhuo.jpg') }}" alt="Présentation Miravia">
      <div class="about-text">
        <p><strong>Miravia</strong> est une plateforme sociale innovante qui connecte bénévoles, donateurs et organisateurs d’événements...</p>
      </div>
    </section>

    <!-- Notre histoire -->
    <section data-aos="fade-up">
      <h2>Notre Histoire</h2>
      <div class="timeline">
        <div class="timeline-item">
          <h4>2021 – Naissance de l'idée</h4>
          <p>Face à la crise sanitaire, l'idée de rapprocher le digital et la solidarité est née.</p>
        </div>
        <div class="timeline-item">
          <h4>2022 – Création de Miravia</h4>
          <p>Lancement officiel de la plateforme avec une équipe passionnée.</p>
        </div>
        <div class="timeline-item">
          <h4>2023 – +1000 actions solidaires</h4>
          <p>Des milliers de citoyens engagés ont rejoint la communauté Miravia.</p>
        </div>
      </div>
    </section>

    <!-- Nos Valeurs -->
    <section data-aos="fade-up">
      <h2>Nos Valeurs</h2>
      <div class="values">
        <div class="value-box"><i class="fas fa-hand-holding-heart"></i><h4>Solidarité</h4><p>Agir ensemble pour ceux qui en ont besoin.</p></div>
        <div class="value-box"><i class="fas fa-lightbulb"></i><h4>Innovation</h4><p>Des outils numériques au service du social.</p></div>
        <div class="value-box"><i class="fas fa-balance-scale"></i><h4>Transparence</h4><p>Clarté dans chaque action menée.</p></div>
        <div class="value-box"><i class="fas fa-users"></i><h4>Inclusion</h4><p>Ouvert à toutes et à tous.</p></div>
      </div>
    </section>

    <!-- Chiffres clés -->
    <section data-aos="fade-up">
      <h2>Nos Chiffres Clés</h2>
      <div class="stats-grid">
        <div class="stat-box"><i class="fas fa-hands-helping"></i><h3>+12K</h3><p>Bénévoles actifs</p></div>
        <div class="stat-box"><i class="fas fa-coins"></i><h3>500K€</h3><p>Dons collectés</p></div>
        <div class="stat-box"><i class="fas fa-calendar-check"></i><h3>1350</h3><p>Événements créés</p></div>
        <div class="stat-box"><i class="fas fa-globe"></i><h3>5 pays</h3><p>Où nous sommes présents</p></div>
      </div>
    </section>

    <!-- Témoignages -->
    <section data-aos="fade-up">
      <h2>Ils parlent de nous</h2>
      <div class="testimonials-grid">
        <div class="testimonial">
          <p>"Grâce à Miravia, j'ai pu organiser ma première collecte solidaire en moins d'une semaine."</p>
          <strong>— Leila, organisatrice</strong>
        </div>
        <div class="testimonial">
          <p>"Une plateforme simple et humaine. Je recommande à tous ceux qui veulent aider."</p>
          <strong>— Yassine, bénévole</strong>
        </div>
        <div class="testimonial">
          <p>"Transparente et efficace, Miravia donne confiance pour chaque don."</p>
          <strong>— Samir, donateur</strong>
        </div>
      </div>
    </section>

    <!-- Footer local -->
    <footer>
      <a class="btn" href="{{ path('app_dashboard_partenaire') }}">Retour au tableau de bord</a>
    </footer>

  </div> <!-- Fin de div.content -->
  <script>
  // Initialisation de AOS (Animation On Scroll)
AOS.init({
  offset: 120, // Décalage de l'animation
  delay: 0, // Pas de délai
  duration: 1000, // Durée de l'animation
  once: true, // Animer une seule fois
});

// Loader disparition après chargement
window.addEventListener("load", () => {
  document.getElementById("loader").style.display = "none";
});

// Animation lors du défilement pour la barre de navigation
window.onscroll = function() {
  const navbar = document.querySelector('.navbar');
  if (window.scrollY > 50) {
    navbar.classList.add('scrolled');
  } else {
    navbar.classList.remove('scrolled');
  }
}
document.querySelector('.btn').addEventListener('click', function (e) {
    e.preventDefault();  // Empêche le comportement par défaut
    document.querySelector('#about').scrollIntoView({ behavior: 'smooth' });
});

  </script>
{% endblock %}

