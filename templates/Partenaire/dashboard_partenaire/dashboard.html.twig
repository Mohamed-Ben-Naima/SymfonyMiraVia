<!-- Modal Chatbot -->
<div class="modal fade" id="chatbotModal" tabindex="-1" aria-labelledby="chatbotModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header" style="background-color: #013a71; color: white;">
        <h5 class="modal-title" id="chatbotModalLabel">Chatbot</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">
        <div class="chat-container">
          <div class="messages" id="messages"></div>
          <div class="typing-indicator" id="typing-indicator">Chatbot is typing...</div>
          <form id="chat-form" style="display: flex; gap: 10px;">
              <input type="text" id="message-input" placeholder="Tapez votre message..." required 
                     style="flex-grow: 1; padding: 10px; border-radius: 20px; border: 1px solid #ddd; font-size: 14px;">
              <button type="submit" 
                      style="background-color: #3498db; color: white; border: none; border-radius: 20px; padding: 10px 15px; cursor: pointer;">
                      Envoyer
              </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $('#chat-form').on('submit', function (e) {
      e.preventDefault();

      const userMessage = $('#message-input').val();
      if (userMessage.trim()) {
          $('#messages').append('<div class="message user"><p>' + userMessage + '</p></div>');
          $('#message-input').val('');

          $('#typing-indicator').show();

          $.ajax({
              url: '/chatbot/api',
              type: 'POST',
              data: { message: userMessage },
              success: function (data) {
                  $('#typing-indicator').hide();
                  if (data.response) {
                      $('#messages').append('<div class="message bot"><p>' + data.response + '</p></div>');
                  } else {
                      $('#messages').append('<div class="message bot"><p>Erreur du chatbot, veuillez réessayer.</p></div>');
                  }
                  $('#messages').scrollTop($('#messages')[0].scrollHeight);
              },
              error: function () {
                  $('#typing-indicator').hide();
                  $('#messages').append('<div class="message bot"><p>Erreur du chatbot, veuillez réessayer plus tard.</p></div>');
                  $('#messages').scrollTop($('#messages')[0].scrollHeight);
              }
          });
      }
    });
  });
</script>

