{% extends 'Partenaire/basePartner.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}

<script src="{{ asset('assets/js/partner/dashboard.js') }}"></script>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <script>
            Swal.fire({
                icon: '{{ label == "success" ? "success" : "error" }}',
                title: '{{ message|e("js") }}',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        </script>
    {% endfor %}
{% endfor %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <script>
            Swal.fire({
                icon: '{{ label == "success" ? "success" : "error" }}',
                title: '{{ message|e("js") }}',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        </script>
    {% endfor %}
{% endfor %}

<div class="content">
  <div class="dashboard-header">
    <h3 style="color: #013a71;">Statistiques</h3>
    <div class="time" id="currentTime"></div>
  </div>

  <!-- Stats and Clock on the same line -->
  <div class="stats-and-clock">
    <!-- Stats Container -->
    <div class="stats-container">
      <!-- Carte Dons -->
      <div id="stat-clients" class="stat-item">
        <div class="value" id="h4-clients">
          <i class="bi bi-currency-exchange" style="font-size: 24px;"></i>
          <span class="stat-number" id="donations-count">{{ dons }}</span>
        </div>
        <h4>Nombre de dons</h4>
      </div>
      <!-- Carte Événements -->
      <div id="stat-events" class="stat-item">
        <div class="value" id="h4-events">
          <i class="bi bi-calendar-check-fill icon-events"></i>
          <span class="stat-number" id="events-count">{{ events }}</span>
        </div>
        <h4>Nombre d'événements</h4>
      </div>
      <!-- Carte Demandes d'aide -->
      <div id="stat-requests" class="stat-item">
        <div class="value" id="h4-requests">
          <i class="bi bi-question-circle icon-requests"></i>
          <span class="stat-number" id="requests-count">{{ demandes }}</span>
        </div>
        <h4>Demandes d'aide</h4>
      </div>
      <!-- Carte Bénévoles -->
      <div id="stat-volunteers" class="stat-item">
        <div class="value" id="h4-volunteers">
          <i class="bi bi-valentine icon-volunteers"></i>
          <span class="stat-number" id="volunteers-count">{{ benevolats }}</span>
        </div>
        <h4>Nombre des Bénévolats</h4>
      </div>
    </div>

    <!-- Clock Card -->
    <div class="clock-card">
      <div class="clock__container grid">
        <div class="clock__content grid">
          <div class="clock__circle">
            <span class="clock__twelve"></span>
            <span class="clock__three"></span>
            <span class="clock__six"></span>
            <span class="clock__nine"></span>

            <div class="clock__rounder"></div>
            <div class="clock__hour" id="clock-hour"></div>
            <div class="clock__minutes" id="clock-minutes"></div>
            <div class="clock__seconds" id="clock-seconds"></div>
          </div>

          <div>
            <div class="clock__text">
              <div class="clock__text-hour" id="text-hour"></div>
              <div class="clock__text-minutes" id="text-minutes"></div>
            </div>

            <div class="clock__date">
              <span id="date-day"></span>
              <span id="date-month"></span>
              <span id="date-year"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart and Accepted Donations Combined -->
    <div class="chart-donations-card">
      <!-- Left Section: Chart -->
      <div class="chart-section">
        <div class="chart-header">
          <h4>Nombre de dons par mois</h4>
        </div>
        <canvas id="donationsChart"></canvas>
      </div>

      <div class="donations-section">
    <!-- Sélecteur d'années -->
    <div class="year-dropdown">
        <select id="year-selector" class="styled-select">
            {% for year in availableYears %}
                <option value="{{ year }}" {% if year == "now"|date("Y") %}selected{% endif %}>
                    {{ year }}
                </option>
            {% endfor %}
        </select>
    </div>

    <!-- Cercle avec les montants des dons -->
    <div class="donations-growth-circle">
        <div class="growth-circle">
            <canvas id="donationPieChart"></canvas>
        </div>
    </div>

    <!-- Résumé -->
    <p class="growth-summary" id="growth-summary">
        Nombre de dons pour {{ "now"|date("Y") }} :
    </p>

    <!-- Détails des dons -->
    <div class="donations-breakdown" id="donations-breakdown">
        <div class="donation-item">
            <span class="icon" style="color: #3498db;"><i class="bi bi-check-circle-fill"></i></span>
            <span class="year">Accepté :</span>
            <span class="amount" id="accepted-donations">{{ donationsAccepted|number_format(2, ',', ' ') }} €</span>
        </div>
        <div class="donation-item">
            <span class="icon" style="color: #d6336c;"><i class="bi bi-clock-fill"></i></span>
            <span class="year">En Attente :</span>
            <span class="amount" id="pending-donations">{{ pendingDonations|number_format(2, ',', ' ') }} €</span>
        </div>
    </div>
</div>
</div>

  <!-- Events Table -->
  <div class="table-container">
    <div class="table-header">
      <h3>Liste des Événements (En cours)</h3>
    </div>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th scope="col">Image</th>
            <th scope="col">Titre</th>
            <th scope="col">Date</th>
            <th scope="col">Lieu</th>
            <th scope="col">Description</th>
            <th scope="col">Statut</th>
          </tr>
        </thead>
        <tbody>
          {% set hasEnCours = false %}
          {% for event in evenements %}
            {% if event.status == 'En cours' %}
              {% set hasEnCours = true %}
              <tr>
                <td>
                  <img src="{{ asset('uploads/event_images/' ~ event.imageName) }}" alt="{{ event.titre }}"
                       class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;">
                </td>
                <td>{{ event.titre }}</td>
                <td>{{ event.dateEvenement|date('d/m/Y') }}</td>
                <td>{{ event.lieu }}</td>
                <td>{{ event.description|length > 50 ? event.description|slice(0, 50) ~ '...' : event.description }}</td>
                <td>
                  <button
                      class="btn btn-sm
                      {{ event.status == 'En cours' ? 'btn-en-cours' : (event.status == 'Annuler' ? 'btn-annuler' : 'btn-termine') }}">
                    <i
                        class="{{ event.status == 'En cours' ? 'bi bi-clock' : (event.status == 'Annuler' ? 'bi bi-x' : 'bi bi-check') }}"
                        style="margin-right: 5px;">
                    </i>
                    {{ event.status }}
                  </button>
                </td>
              </tr>
            {% endif %}
          {% endfor %}
          {% if not hasEnCours %}
            <tr>
              <td colspan="6" class="text-center text-muted">Aucun événement en cours trouvé</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Bouton flottant -->
<a href="#" data-bs-toggle="modal" data-bs-target="#chatbotModal" class="chatbot-link">
    <img src="{{ asset('images-partner/chatbot.png') }}" alt="Chatbot" class="chatbot-image">
</a>
<!-- Modal Chatbot -->
<div class="modal fade" id="chatbotModal" tabindex="-1" aria-labelledby="chatbotModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header" style="background-color: #013a71; color: white;">
        <h5 class="modal-title" id="chatbotModalLabel">MiraBot</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">
        <div class="chat-container">
          <div class="messages" id="messages"></div>
          <div class="typing-indicator" id="typing-indicator">Chatbot is typing...</div>
          <form id="chat-form" style="display: flex; gap: 10px;">
              <input type="text" id="message-input" placeholder="Tapez votre message..." required 
                     style="flex-grow: 1; padding: 10px; border-radius: 20px; border: 1px solid #ddd; font-size: 14px;">
              <button type="submit" 
                      style="background-color: #3498db; color: white; border: none; border-radius: 20px; padding: 10px 15px; cursor: pointer;">
                      Envoyer
              </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Bouton flottant -->
<a href="#" data-bs-toggle="modal" data-bs-target="#chatbotModal" class="chatbot-link">
    <img src="{{ asset('images-partner/chatbot.png') }}" alt="Chatbot" class="chatbot-image">
</a>

<script src="{{ asset('js/partner/dashboard.js') }}"></script>

<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
 
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<link href="{{ asset('style-partner/dashboard.css') }}" rel="stylesheet">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const donationsData = {{ donationsByMonth|default([])|json_encode|raw }};
  
  // Gestion du header flottant
  window.addEventListener('scroll', function() {
    const header = document.querySelector('.floating-header');
    if (window.scrollY > 50) {
        
        header.style.backgroundColor = '#f5f5f9';
    } else {
        
        header.style.backgroundColor = '#f5f5f9';
    }
  });
  </script>
{% endblock %}

 