<!-- Floating Header -->
<div class="floating-header">
    <!-- Search Card -->
    <div class="search-card">
        <!-- Search Bar -->
        <div class="search-bar-wrapper">
            <input type="text" class="form-control" placeholder="Rechercher..." id="mainSearchBar">
        </div>

        <!-- Icons Section -->
        <div class="search-icons">
            <i class="bi bi-globe2 global-icon"></i> <!-- Global Icon -->
            <!-- Sun and Moon Icons for Light/Dark Mode -->
            <i class="bi bi-sun sun-icon" id="toggleTheme"></i>
            <i class="bi bi-moon moon-icon" id="toggleTheme" style="display: none;"></i>
            <i class="bi bi-grid-fill dashboard-icon"></i> <!-- Dashboard Icon -->
            
            <!-- Notification Icon -->
            <div class="notification-wrapper">
                <i class="bi bi-bell-fill notification-icon" id="toggleNotifications"></i>
                <span class="notification-badge" id="notificationCount"></span>
            </div>

            <!-- Notification Popup -->
            <div class="notification-popup" id="notificationPopup">
                <div class="notification-title" id="notificationTitle">Notifications</div>
                <div class="notification-items" id="notificationItems"></div>
                <div class="notification-actions">
                    <button class="btn-mark-read" onclick="markAllAsRead()">Marquer tout comme lu</button>
                    <button class="btn-clear-all" onclick="clearAllNotifications()">Tout supprimer</button>
                </div>
            </div>
        </div>

        <!-- Profile Section -->
        <div class="profile-wrapper">
            {% if app.user.avatar %}
                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Profile" class="profile-icon"
                    onerror="this.src='{{ asset('images-partner/user.png') }}'">
            {% else %}
                <img src="{{ asset('images-partner/user.png') }}" alt="Profile" class="profile-icon">
            {% endif %}
            <span class="status-indicator"></span>

            <!-- Dropdown Menu -->
            <div class="dropdown-menu" id="profileDropdown">
                <a href="{{ path('app_profil_partner') }}" class="dropdown-item"><i class="bi bi-person-fill"></i>Profil</a>
                <a href="{{ path('app_logout_partner') }}" class="dropdown-item"><i class="bi bi-box-arrow-left"></i>Déconnexion</a>
            </div>
        </div>
    </div>
</div>

<link href="{{ asset('style-partner/navbar.css') }}" rel="stylesheet">
<script src="{{ asset('js/partner/navbar.js') }}"></script>


