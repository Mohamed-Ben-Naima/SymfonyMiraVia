{% extends 'Partenaire/basePartner.html.twig' %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="content">
  <div class="container py-5">
    <div class="row">
      <div class="col-md-12">
        <div class="card" id="chat3" style="border-radius: 15px; border: none;">
          <div class="card-body">
            <div class="row">
              <!-- Liste des contacts (Desktop) -->
              <div class="col-md-6 col-lg-5 col-xl-4 mb-4 mb-md-0 d-none d-md-block">
                <div class="p-3">
                  <div class="input-group rounded mb-3">
                    <input type="search" class="form-control rounded" placeholder="Rechercher un contact..." aria-label="Search" aria-describedby="search-addon" />
                    <span class="input-group-text border-0" id="search-addon">
                      <i class="fas fa-search"></i>
                    </span>
                  </div>

                  <div class="contacts-list" style="position: relative; height: 400px; overflow-y: auto;">
                    <ul class="list-unstyled mb-0">
                      {% for contact in contacts %}
                      <li class="p-2 border-bottom hoverable">
                        <a href="{{ path('app_messagerie_partner', {'receiver_id': contact.idUtilisateur}) }}">
                          <div class="d-flex flex-row">
                            <div class="me-3 position-relative">
                              <img src="{{ contact.avatar }}" alt="avatar" class="rounded-circle" width="60">
                              <span class="position-absolute bottom-0 end-0 translate-middle p-1 bg-success border border-light rounded-circle badge-dot"></span>
                            </div>
                            <div class="pt-1">
                              <p class="fw-bold mb-0">{{ contact.name }}</p>
                              <p class="small text-muted mb-0">{{ contact.lastMessage }}</p>
                            </div>
                          </div>
                          <div class="pt-1 text-end">
                            <p class="small text-muted mb-1">Just now</p>
                            <span class="badge bg-danger rounded-pill">3</span>
                          </div>
                        </a>
                      </li>
                      {% else %}
                      <li class="p-2 text-muted">Aucun contact disponible.</li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Fenêtre de messagerie -->
              <div class="col-md-6 col-lg-7 col-xl-8">
                <div class="pt-3 pe-3" style="position: relative; height: 400px; overflow-y: auto;">
                  <div class="message-container" id="messageContainer">
                    <input type="hidden" id="senderId" value="{{ app.user.idUtilisateur }}">
                    <input type="hidden" id="receiverId" value="{{ receiverId }}">

                    {% for message in messages %}
                    <div class="d-flex flex-row justify-content-{{ message.expediteur == app.user ? 'end' : 'start' }} mb-3">
                      {% if message.expediteur != app.user %}
                      <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava6-bg.webp" alt="avatar" class="rounded-circle me-2" style="width: 45px; height: 45px;">
                      {% endif %}
                      <div>
                        <div class="p-2 rounded-3 {{ message.expediteur == app.user ? 'bg-primary text-white' : 'bg-light' }}">
                          {{ message.message }}
                        </div>
                        <p class="small text-muted mt-1 text-end">{{ message.dateEnvoi|date('d/m/Y H:i') }}</p>
                      </div>
                      {% if message.expediteur == app.user %}
                      <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava1-bg.webp" alt="avatar" class="rounded-circle ms-2" style="width: 45px; height: 45px;">
                      {% endif %}
                    </div>
                    {% else %}
                    <p class="text-muted">Aucun message pour le moment.</p>
                    {% endfor %}
                  </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3">
                  <input type="text" class="form-control form-control-lg me-2" placeholder="Écrire un message..." id="messageInput">
                  <button id="sendButton" class="btn btn-primary btn-send">
                    <i class="fas fa-paper-plane"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div> <!-- col-md-12 -->
    </div> <!-- row -->
  </div> <!-- container -->
</div> <!-- content -->

<!-- Liste des contacts (Mobile) -->
<div class="d-md-none mt-3">
  <div class="contacts-list px-3">
    <ul class="list-unstyled mb-0">
      {% for contact in contacts %}
      <li class="p-2 border-bottom hoverable">
        <a href="{{ path('app_messagerie_partner', {'receiver_id': contact.idUtilisateur}) }}" class="d-flex align-items-center text-decoration-none text-dark">
          <img src="{{ contact.avatar }}" alt="avatar" class="rounded-circle me-3" width="50">
          <div>
            <p class="fw-bold mb-0">{{ contact.name }}</p>
            <p class="small text-muted mb-0">{{ contact.lastMessage }}</p>
          </div>
        </a>
      </li>
      {% else %}
      <li class="p-2 text-muted">Aucun contact disponible.</li>
      {% endfor %}
    </ul>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sendButton = document.getElementById('sendButton');
    const messageInput = document.getElementById('messageInput');
    const messageContainer = document.getElementById('messageContainer');
    const receiverId = document.getElementById('receiverId').value;
    const senderId = document.getElementById('senderId').value;

    sendButton.addEventListener('click', function () {
        const messageText = messageInput.value.trim();

        // Vérification si le message est vide
        if (messageText === "") {
            alert("Le message ne peut pas être vide.");
            return;
        }

        fetch('/dashboard/partenaire/messagerie/send-message', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
            },
            body: JSON.stringify({
                message: messageText,
                receiverId: receiverId,
                senderId: senderId
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                messageInput.value = ''; // Réinitialiser le champ de saisie
                fetchMessages(); // Rafraîchir les messages après l'envoi
            } else {
                Swal.fire('Erreur', data.error || 'Une erreur inconnue est survenue lors de l\'envoi du message', 'error');
            }
        })
        .catch(error => {
            console.error('Erreur AJAX:', error);
            Swal.fire('Erreur', 'Une erreur s’est produite lors de l’envoi du message.', 'error');
        });
    });

    function fetchMessages() {
        fetch('/dashboard/partenaire/messagerie/messages?receiver_id=' + receiverId)
            .then(response => response.json())
            .then(data => {
                if (data.messages) {
                    messageContainer.innerHTML = ''; // Vider le contenu existant
                    data.messages.forEach(message => {
                        const messageElement = document.createElement('div');
                        messageElement.classList.add('d-flex', 'flex-row', message.expediteur == senderId ? 'justify-content-end' : 'justify-content-start', 'mb-3');
                        
                        messageElement.innerHTML = `
                            ${message.expediteur != senderId ? 
                                `<img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava6-bg.webp" alt="avatar" class="rounded-circle me-2" style="width: 45px; height: 45px;">` : ''}
                            <div>
                                <div class="p-2 rounded-3 ${message.expediteur == senderId ? 'bg-primary text-white' : 'bg-light'}">
                                    ${message.message}
                                </div>
                                <p class="small text-muted mt-1 text-end">${new Date(message.dateEnvoi).toLocaleString()}</p>
                            </div>
                            ${message.expediteur == senderId ? 
                                `<img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava1-bg.webp" alt="avatar" class="rounded-circle ms-2" style="width: 45px; height: 45px;">` : ''}
                        `;
                        messageContainer.appendChild(messageElement);
                    });
                    messageContainer.scrollTop = messageContainer.scrollHeight; // Défilement vers le bas
                } else {
                    console.error('Aucun message trouvé dans la réponse');
                }
            })
            .catch(error => {
                console.error('Erreur lors du chargement des messages:', error);
            });
    }

    // Rafraîchir les messages toutes les 5 secondes
    setInterval(fetchMessages, 5000);
});
</script>

{% endblock %}
