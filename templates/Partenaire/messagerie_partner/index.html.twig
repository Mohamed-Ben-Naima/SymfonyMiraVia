{% extends 'Partenaire/basePartner.html.twig' %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="content">
  <div class="container py-5">
    <div class="row">
      <div class="col-md-12">

        <div class="card" id="chat3" style="border-radius: 15px; border: none;">
          <div class="card-body">

            <div class="row">
              <!-- Liste des contacts pour les grands écrans -->
              <div class="col-md-6 col-lg-5 col-xl-4 mb-4 mb-md-0 d-none d-md-block">
                <div class="p-3">
                  <div class="input-group rounded mb-3">
                    <input type="search" class="form-control rounded" placeholder="Search" aria-label="Search"
                      aria-describedby="search-addon" />
                    <span class="input-group-text border-0" id="search-addon">
                      <i class="fas fa-search"></i>
                    </span>
                  </div>

                  <div class="contacts-list">
                    <ul class="list-unstyled mb-0">
                      {% for contact in contacts %}
                      <li class="p-2 border-bottom hoverable">
                        <a href="{{ path('app_messagerie_partner', {'receiver_id': contact.id}) }}" class="d-flex justify-content-between">
                          <div class="d-flex flex-row">
                            <div>
                              <img src="{{ contact.avatar }}" alt="avatar" class="d-flex align-self-center me-3 rounded-circle" width="60">
                              <span class="badge bg-success badge-dot"></span>
                            </div>
                            <div class="pt-1">
                              <p class="fw-bold mb-0">{{ contact.name }}</p>
                              <p class="small text-muted">{{ contact.lastMessage }}</p>
                            </div>
                          </div>
                          <div class="pt-1">
                            <p class="small text-muted mb-1">Just now</p>
                            <span class="badge bg-danger rounded-pill float-end">3</span>
                          </div>
                        </a>
                      </li>
                      {% endfor %}
                    </ul>
                  </div>

                </div>
              </div>

              <!-- Fenêtre de messagerie -->
              <div class="col-md-6 col-lg-7 col-xl-8">
                <div class="pt-3 pe-3 message-container">

                  <div class="message-container">
                    {% for message in messages %}
                    <div class="d-flex flex-row justify-content-{{ message.sender == 'me' ? 'end' : 'start' }}">
                      <img src="{{ message.sender == 'me' ? 'https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava1-bg.webp' : 'https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava6-bg.webp' }}"
                        alt="avatar" class="rounded-circle" style="width: 45px; height: 45px;">
                      <div class="message-box">
                        <p class="small p-2 {{ message.sender == 'me' ? 'bg-primary text-white' : 'bg-body-tertiary' }} rounded-3">
                          {{ message.text }}
                        </p>
                        <p class="small text-muted float-end">{{ message.time }}</p>
                      </div>
                    </div>
                    {% endfor %}
                  </div>

                </div>

                <div class="d-flex justify-content-between align-items-center pt-3">
                  <input type="text" class="form-control form-control-lg" placeholder="Type a message" id="messageInput">
                  <div class="message-actions">
                    <button class="btn btn-primary btn-send"><i class="fas fa-paper-plane"></i></button>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<!-- Mobile view - Liste des contacts -->
<div class="d-md-none">
  <div class="contacts-list p-3" style="height: auto; overflow-y: auto;">
    <ul class="list-unstyled mb-0">
      {% for contact in contacts %}
      <li class="p-2 border-bottom hoverable">
        <a href="{{ path('app_messagerie_partner', {'receiver_id': contact.id}) }}" class="d-flex justify-content-between">
          <div class="d-flex flex-row">
            <div>
              <img src="{{ contact.avatar }}" alt="avatar" class="d-flex align-self-center me-3 rounded-circle" width="50">
              <span class="badge bg-success badge-dot"></span>
            </div>
            <div class="pt-1">
              <p class="fw-bold mb-0">{{ contact.name }}</p>
              <p class="small text-muted">{{ contact.lastMessage }}</p>
            </div>
          </div>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% endblock %}
