{% extends 'Partenaire/basePartner.html.twig' %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="{{ asset('style-partner/messenger.css') }}">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="content">
  <div class="container py-5">
    <div class="row">
      <div class="col-md-12">
        <div class="card" id="chat3" style="border-radius: 15px; border: none;">
          <div class="card-body">
            <div class="row">
              <!-- Liste des contacts (Desktop) -->
              <div class="col-md-6 col-lg-5 col-xl-4 mb-4 mb-md-0 d-none d-md-block">
                <div class="p-3">
                  <div class="input-group rounded mb-3">
                    <input type="search" class="form-control rounded" placeholder="Rechercher un contact..." 
                          aria-label="Search" aria-describedby="search-addon" id="search-input" />
                    <span class="input-group-text border-0" id="search-addon">
                        <i class="fas fa-search"></i>
                    </span>
                  </div>

                  <div class="contacts-list" style="position: relative; height: 400px; overflow-y: auto;">
                    <ul class="list-unstyled mb-0" id="contacts-list">
                    {% if contacts is defined and contacts is not empty %}
                      {% for contact in contacts %}
                      <li class="p-2 border-bottom hoverable position-relative {% if contact.idUtilisateur == receiverId %}selected{% endif %}" data-contact-name="{{ contact.name }}">
                        <a href="{{ path('app_messagerie_partner', {'receiver_id': contact.idUtilisateur}) }}">
                          <div class="d-flex flex-row">
                            <div class="me-3 position-relative">
                              {% set avatarPath = 'uploads/avatars/' ~ contact.avatar %}
                              <img src="{{ asset(avatarPath) }}" alt="avatar" class="rounded-circle" width="60" 
                                  onerror="this.onerror=null;this.src='{{ asset('images-partner/user.png') }}';">
                              <span class="position-absolute bottom-0 end-0 translate-middle p-1 bg-success border border-light rounded-circle badge-dot"></span>
                            </div>
                            <div class="pt-1">
                              <p class="fw-bold mb-0">{{ contact.name }}</p>
                              <p class="small text-muted mb-0">{{ contact.lastMessage }}</p>
                            </div>
                          </div>
                          <div class="pt-1 text-end">
                            <p class="small text-muted mb-1">{{ contact.lastMessageTime }}</p>
                            {% if contact.unreadCount > 0 %}
                              <span class="badge bg-danger rounded-pill">{{ contact.unreadCount }}</span>
                            {% endif %}
                          </div>
                        </a>
                      </li>
                      {% endfor %}
                    {% else %}
                      <li class="p-2 text-muted">Aucun contact disponible.</li>
                    {% endif %}
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Fenêtre de messagerie -->
              <div class="col-md-6 col-lg-7 col-xl-8">
                <div class="pt-3 pe-3" style="position: relative; height: 400px; overflow-y: auto;">
                  <div class="message-container" id="messageContainer">
                    <input type="hidden" id="senderId" value="{{ app.user.idUtilisateur }}">
                    <input type="hidden" id="receiverId" value="{{ receiverId }}">

                    {% if messages is empty %}
                      <p class="text-muted">Aucun message pour le moment.</p>
                    {% else %}
                      {% for message in messages %}
                      <div class="d-flex flex-row justify-content-{{ message.idExpediteur == senderId ? 'end' : 'start' }} mb-3">
                        {% if message.idExpediteur != senderId %}
                          <img src="{{ asset('uploads/avatars/' ~ message.expediteur.avatar) }}" 
                               alt="avatar" class="rounded-circle me-2" 
                               style="width: 45px; height: 45px;"
                               onerror="this.onerror=null;this.src='{{ asset('images-partner/user.png') }}';">
                        {% endif %}

                        <div>
                          <div class="p-2 rounded-3 {{ message.idExpediteur == senderId ? 'bg-primary text-white' : 'bg-light' }}">
                            {{ message.message }}
                          </div>
                          <p class="small text-muted mb-1">{{ message.dateEnvoi|date('Y-m-d H:i:s') }}</p>
                        </div>

                        {% if message.idExpediteur == senderId %}
                          <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" 
                               alt="avatar" class="rounded-circle ms-2" 
                               style="width: 45px; height: 45px;"
                               onerror="this.onerror=null;this.src='{{ asset('images-partner/user.png') }}';">
                        {% endif %}
                      </div>
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>

                <!-- Input Message and Send Button -->
                <div class="d-flex justify-content-between align-items-center pt-3">
                  <input type="text" class="form-control form-control-lg me-2" placeholder="Écrire un message..." id="messageInput">
                  <button id="sendButton" class="btn btn-primary btn-send">
                    <i class="fas fa-paper-plane"></i>
                  </button>
                </div>
              </div>
            </div> <!-- row -->
          </div> <!-- card-body -->
        </div> <!-- card -->
      </div> <!-- col-md-12 -->
    </div> <!-- row -->
  </div> <!-- container -->
</div> <!-- content -->

<script>
document.addEventListener('DOMContentLoaded', function () {
  const sendButton = document.getElementById('sendButton');
  const messageInput = document.getElementById('messageInput');
  const messageContainer = document.getElementById('messageContainer');
  const receiverId = document.getElementById('receiverId').value;
  const senderId = document.getElementById('senderId').value;
  const searchInput = document.getElementById('search-input');
  const contactsList = document.getElementById('contacts-list');

  // Fonction pour récupérer et afficher les messages
  function fetchMessages() {
    fetch('/dashboard/partenaire/messagerie/messages?receiver_id=' + receiverId)
      .then(response => response.json())
      .then(data => {
        if (data.messages) {
          messageContainer.innerHTML = '';
          data.messages.forEach(message => {
            const isSender = message.senderId == senderId;
            const avatarSrc = message.senderAvatar && message.senderAvatar.trim() !== ''
              ? `/uploads/avatars/${message.senderAvatar}`
              : '/uploads/avatars/default-avatar.png';
            const avatarImg = `<img src="${avatarSrc}" alt="avatar" class="rounded-circle ${isSender ? 'ms-2' : 'me-2'}" style="width: 45px; height: 45px;">`;
            const messageElement = document.createElement('div');
            messageElement.classList.add('d-flex', 'flex-row', isSender ? 'justify-content-end' : 'justify-content-start', 'mb-3');
            messageElement.innerHTML = `
              ${!isSender ? avatarImg : ''}
              <div data-message-id="${message.id}">
                <div class="p-2 rounded-3 ${isSender ? 'bg-primary text-white' : 'bg-light'}">
                  ${message.message}
                </div>
                <p class="small text-muted mt-1 text-end">${new Date(message.dateEnvoi).toLocaleString()}</p>
              </div>
              ${isSender ? avatarImg : ''}
            `;
            messageElement.addEventListener('click', function() {
              markMessageAsRead(message.id);  // Marquer le message comme lu
            });
            messageContainer.appendChild(messageElement);
          });
          messageContainer.scrollTop = messageContainer.scrollHeight;
        }
      })
      .catch(error => console.error('Erreur chargement messages:', error));
  }

  // Fonction pour marquer un message comme lu
  function markMessageAsRead(messageId) {
    fetch('{{ path('mark_message_as_read') }}', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: new URLSearchParams({
        messageId: messageId
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        console.log('Message marqué comme lu');
        const messageElement = document.querySelector(`[data-message-id="${messageId}"]`);
        messageElement.classList.add('read');
      } else {
        console.error('Erreur lors du marquage du message comme lu');
      }
    })
    .catch(error => console.error('Erreur:', error));
  }

  // Fonction pour envoyer un message
  sendButton.addEventListener('click', function () {
    const messageText = messageInput.value.trim();
    if (messageText === '') {
      alert("Le message ne peut pas être vide.");
      return;
    }
    fetch('/dashboard/partenaire/messagerie/send-message', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      },
      body: JSON.stringify({ message: messageText, receiverId, senderId })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        messageInput.value = '';
        fetchMessages();  // Rafraîchit la liste des messages après l'envoi
      } else {
        Swal.fire('Erreur', data.error || 'Erreur inconnue lors de l\'envoi.', 'error');
      }
    })
    .catch(error => {
      console.error('Erreur AJAX:', error);
      Swal.fire('Erreur', 'Erreur lors de l\'envoi du message.', 'error');
    });
  });

  // Fonction de recherche
  searchInput.addEventListener('input', function() {
    const searchTerm = searchInput.value.toLowerCase();
    const contacts = contactsList.querySelectorAll('li');
    contacts.forEach(function(contact) {
      const contactName = contact.getAttribute('data-contact-name').toLowerCase();
      if (contactName.includes(searchTerm)) {
        contact.style.display = '';  // Affiche le contact
      } else {
        contact.style.display = 'none';  // Cache le contact
      }
    });
  });

  // Rafraîchir les messages toutes les 5 secondes
  setInterval(fetchMessages, 5000);
});
</script>

{% endblock %}
