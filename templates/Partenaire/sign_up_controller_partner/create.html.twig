{% block stylesheets %}
    <link href="{{ asset('style-partner/bootstrap.min.css') }}" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <style>
    /* Styles pour afficher le logo en cercle et le centrer */
    .form-content img.logo {
        max-width: 120px;
        width: 120px;
        height: 120px;
        border-radius: 50%; /* Transforme l'image en cercle */
        margin: 0 auto 20px;
        display: block;
        object-fit: cover; /* Assure que l'image couvre le cercle sans déformation */
    }

    .form-content .logo-container {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background-color: #f0faff;
        margin: 0 auto 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
        border: 2px solid #ccc;
    }

    .form-content .logo-container .edit-icon {
        position: absolute;
        bottom: 5px;
        right: 5px;
        font-size: 1.2rem;
        background-color: rgba(0, 0, 0, 0.5);
        color: white;
        padding: 5px;
        border-radius: 50%;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .form-content .logo-container .edit-icon:hover {
        background-color: rgba(0, 0, 0, 0.7);
    }

    .form-content input[type="file"] {
        display: none; /* Cacher l'input de fichier */
    }
    
    /* Autres styles pour la mise en forme */
    /* Ajoutez les autres styles déjà existants */
    </style>
{% endblock %}

{% block body %}
    <div class="background">
        <div class="realistic-cloud"></div>
        <div class="realistic-cloud"></div>
        <div class="realistic-cloud"></div>
        <div class="realistic-cloud"></div>
        <div class="trajectory"></div>
        <div class="trajectory"></div>
    </div>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="form-container shadow-lg">
            <div class="form-image"></div>
            <div class="form-content">
                <h2>Bienvenue cher partenaire</h2>
                <p class="text-center">Veuillez remplir ce formulaire</p>

                {{ form_start(form) }}
                
                <!-- Logo Section with Edit Icon -->
                <div class="form-group">
                    <label for="logo">Logo</label>
                    <div class="logo-container">
                        <img id="logoPreview" class="logo" src="{{ asset('images-partner/user.png') }}" alt="Logo">
                        <label for="logoUpload" class="edit-icon">
                            <i class="fas fa-pencil-alt"></i>
                        </label>
                        <input type="file" name="partenaire[logo]" id="logoUpload" accept="image/*">
                    </div>
                    <div class="invalid-feedback">
                        {{ form_errors(form.logo) }}
                    </div>
                </div>

                <!-- Other form fields -->
                <div class="row">
                    <div class="col-md-6 form-group">
                        <i class="fas fa-building input-icon"></i>
                        {{ form_widget(form.nomEntreprise, {'attr': {'class': 'form-control', 'placeholder': 'Nom de l\'entreprise'}}) }}
                        <div class="invalid-feedback">
                            <i class="fas fa-exclamation-circle"></i>
                            {{ form_errors(form.nomEntreprise) }}
                        </div>
                    </div>

                    <div class="col-md-6 form-group">
                        <i class="fas fa-briefcase input-icon"></i>
                        {{ form_widget(form.typeActivite, {'attr': {'class': 'form-control', 'placeholder': 'Type d\'activité'}}) }}
                        <div class="invalid-feedback">
                            <i class="fas fa-exclamation-circle"></i>
                            {{ form_errors(form.typeActivite) }}
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <i class="fas fa-link input-icon"></i>
                    {{ form_widget(form.siteWeb, {'attr': {'class': 'form-control', 'placeholder': 'Site web'}}) }}
                    <div class="invalid-feedback">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ form_errors(form.siteWeb) }}
                    </div>
                </div>

                <div class="form-group">
                    <i class="fas fa-map-marker-alt input-icon"></i>
                    {{ form_widget(form.adresse, {'attr': {'class': 'form-control', 'placeholder': 'Adresse'}}) }}
                    <div class="invalid-feedback">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ form_errors(form.adresse) }}
                    </div>
                </div>

                <div class="form-group">
                    <i class="fas fa-phone input-icon"></i>
                    {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone'}}) }}
                    <div class="invalid-feedback">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ form_errors(form.telephone) }}
                    </div>
                </div>

                <div class="form-group">
                    <label for="autres_documents">Autres documents</label>
                    <input type="file" name="partenaire[autres_documents][]" multiple class="form-control-file">
                </div>

                <button type="submit" class="btn btn-primary">Enregistrer</button>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <script>
        // JavaScript for logo preview
        document.getElementById('logoUpload').addEventListener('change', function(event) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('logoPreview').src = e.target.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        });
    </script>
{% endblock %}
