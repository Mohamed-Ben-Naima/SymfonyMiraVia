        </div>
      </div>

      <!-- Chart Container -->
      <div class="chart-container">
        <div class="chart-header">
          <h2>Nombre de dons par mois</h2>
          <div>Dons financiers</div>
        </div>
        <canvas id="donationsChart"></canvas>
      </div>
    </div>

    <!-- Table Container -->
