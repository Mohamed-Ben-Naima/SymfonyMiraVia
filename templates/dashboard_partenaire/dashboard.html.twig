<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MiraVia - Tableau de bord</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
 <link href="{{ asset('style-partner/dashboard.css') }}" rel="stylesheet">
</head>
<body>
 <!-- Inclure la barre latérale -->
  {% include 'partialsPartner/sidebarPartner.html.twig' %}
  
  <!-- Search Card -->
  <div class="search-card">
    <input type="text" class="form-control" placeholder="Rechercher..." id="mainSearchBar">
  </div>

  <div class="content">
    <div class="dashboard-header">
      <h3>Statistiques</h3>
      <div class="time" id="currentTime">19:18:47</div>
    </div>

    <!-- Conteneur principal pour Statistiques et Chart -->
    <div class="stats-and-chart">
  <!-- Stats Container -->
 <div class="stats-container">
  <!-- Carte Clients -->
  <div id="stat-clients" class="stat-item">
    <div class="value" id="h4-clients" >
      <i class="bi bi-person icon-clients"></i>1,248
    </div>
    <h4>Nombre de clients</h4>
  </div>
  <!-- Carte Événements -->
  <div id="stat-events" class="stat-item">
    <div class="value" id="h4-events">
      <i class="bi bi-calendar-check-fill icon-events"></i> 42
    </div>
    <h4>Nombre d'événements</h4>
  </div>
  <!-- Carte Demandes d'aide -->
  <div id="stat-requests" class="stat-item">
    <div class="value" id="h4-requests">
      <i class="bi bi-question-circle icon-requests"></i> 189
    </div>
    <h4>Demandes d'aide</h4>
  </div>
  <!-- Carte Bénévoles -->
  <div id="stat-volunteers" class="stat-item">
    <div class="value" id="h4-volunteers">
      <i class="bi bi-valentine icon-volunteers"></i> 76
    </div>
    <h4>Bénévoles</h4>
  </div>
</div>

  <!-- Chart Container -->
  <div class="chart-container">
    <div class="chart-header">
      <h2>Nombre de dons par mois</h2>
      <div>Dons financiers</div>
    </div>
    <canvas id="donationsChart"></canvas>
  </div>
</div>

    <!-- Table Container -->
    <div class="table-container">
      <div class="table-header">
        <h3>Liste des utilisateurs</h3>
      </div>
      <div class="table-controls">
        <div style="display: flex; align-items: center; gap: 10px;">
          <select class="form-select" aria-label="Rows per page" style="width: 100px;">
            <option value="10" selected>10</option>
            <option value="25">25</option>
            <option value="50">50</option>
          </select>
          <input type="text" class="form-control" placeholder="Rechercher un utilisateur" style="width: 200px;" />
        </div>
        <div style="display: flex; gap: 10px;">
          <button class="btn btn-outline-secondary">Exporter</button>
          <button class="btn btn-primary">+ Ajouter un utilisateur</button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th scope="col"><input type="checkbox" /></th>
              <th scope="col">Utilisateur</th>
              <th scope="col">Rôle</th>
              <th scope="col">Plan</th>
              <th scope="col">Facturation</th>
              <th scope="col">Statut</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><input type="checkbox" /></td>
              <td>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div>
                    <strong>Zsazsa McCleverty</strong><br />
                    <small>zmcclevertye@soundcloud.com</small>
                  </div>
                </div>
              </td>
              <td><span style="display: flex; align-items: center; gap: 5px;"><i class="bi bi-person-circle"></i> Maintainer</span></td>
              <td>Enterprise</td>
              <td>Auto Debit</td>
              <td><span class="badge bg-success">Actif</span></td>
              <td>
                <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
            <tr>
              <td><input type="checkbox" /></td>
              <td>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div>
                    <strong>Yoko Pottie</strong><br />
                    <small>ypottiec@privacy.gov.au</small>
                  </div>
                </div>
              </td>
              <td><span style="display: flex; align-items: center; gap: 5px;"><i class="bi bi-gem"></i> Subscriber</span></td>
              <td>Basic</td>
              <td>Auto Debit</td>
              <td><span class="badge bg-secondary">Inactif</span></td>
              <td>
                <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
            <tr>
              <td><input type="checkbox" /></td>
              <td>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <img src="https://via.placeholder.com/40" alt="User Avatar" class="rounded-circle" width="40" height="40" />
                  <div>
                    <strong>Wesley Burland</strong><br />
                    <small>wburland@uiuc.edu</small>
                  </div>
                </div>
              </td>
              <td><span style="display: flex; align-items: center; gap: 5px;"><i class="bi bi-clock-history"></i> Editor</span></td>
              <td>Team</td>
              <td>Auto Debit</td>
              <td><span class="badge bg-secondary">Inactif</span></td>
              <td>
                <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // Update current time
    function updateTime() {
      const now = new Date();
      const timeString = now.toLocaleTimeString('fr-FR', {hour: '2-digit', minute:'2-digit', second:'2-digit'});
      document.getElementById('currentTime').textContent = timeString;
    }
    
    setInterval(updateTime, 1000);
    updateTime();
    
    // Chart initialization
    const ctx = document.getElementById('donationsChart').getContext('2d');
    const donationsChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'],
        datasets: [{
          label: 'Dons financiers',
          data: [1200, 1900, 1500, 2000, 2200, 2500, 2800, 2600, 3000, 3200, 3500, 4000],
          borderColor: '#013a71',
          backgroundColor: 'rgba(1, 58, 113, 0.1)',
          tension: 0.4,
          fill: true
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
          }
        },
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
  </script>
</body>
</html>