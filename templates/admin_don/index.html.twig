{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste des dons{% endblock %}

{% block body %}
<style>
html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #fdfdfd;
    overflow: hidden; /* Remove global scroll */
}

.example-wrapper {
    margin: 0 auto;
    padding: 20px;
    margin-left: 15%;
    max-height: calc(100vh - 40px); /* Dynamically adapt height */
    overflow: visible; /* No internal scroll */
}

.example-wrapper h1 {
    text-align: center;
    font-size: 30px;
    margin-bottom: 40px;
    color: rgb(0, 0, 0);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.search-box {
    position: relative;
    width: 87%;
}

.search-box input {
    width: 100%;
    padding: 8px 30px 8px 12px;
    border: 1px solid #7D8C6D;
    border-radius: 6px;
    font-size: 14px;
}

#statusFilter {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #7D8C6D;
    font-size: 14px;
    margin-left: -1%;
}

.header button {
    padding: 8px 31px;
    font-size: 14px;
    background-color: #7D8C6D;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.header button:hover {
    background-color: #5c7352;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background-color: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.05);
    table-layout: fixed; /* Prevent column overflow */
}

th, td {
    padding: 10px;
    text-align: left;
    word-wrap: break-word; /* Ensure text wraps within cells */
}

th {
    background-color: rgb(176, 203, 223);
    color: black;
}

tr:nth-child(even) {
    background-color: #f5f5f5;
}

tr:hover {
    background-color: #81A8C5;
    color: white;
}

.actions {
    display: flex;
    gap: 8px;
}

.actions button {
    background-color: #ccc;
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
}

.actions button:hover {
    background-color: #999;
    color: white;
}

@media (max-width: 992px) {
    .example-wrapper {
        margin-left: 5%;
        margin-right: 5%;
        padding: 10px;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box,
    #statusFilter,
    .header button {
        width: 100%;
        margin: 5px 0;
    }

    #statusFilter {
        margin-left: 0;
    }

    table {
        font-size: 12px;
    }

    th, td {
        padding: 6px;
    }

    .actions {
        flex-direction: column;
        align-items: flex-start;
    }

    .actions button {
        width: 100%;
        margin-bottom: 4px;
    }
}

@media (max-width: 768px) {
    table {
        display: block;
        overflow-x: auto; /* Allow horizontal scroll for small screens */
        white-space: nowrap;
    }
}

.actions button.consulter-btn {
    background-color: #7D8C6D;
    color: white;
            font-size: 14px;

}

.actions button.consulter-btn:hover {
    background-color: #5c7352;
}

.modal {
    display: none; /* Par défaut, caché */
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto; /* Défilement interne uniquement */
    background-color: rgba(0, 0, 0, 0.5); /* Fond semi-transparent */
}

.modal-content {
    position: fixed; /* Permet de positionner l'élément par rapport à la fenêtre */
    top: 50%; /* Centre verticalement */
    left: 50%; /* Centre horizontalement */
    transform: translate(-50%, -50%); /* Ajuste pour centrer parfaitement */
    background-color: #fff;
    margin: 0 auto;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 40%;
    height: auto; /* Ajuste automatiquement la hauteur au contenu */
    box-shadow: 0 10px 20px rgba(87, 104, 202, 0.5);
    max-width: 600px;
    max-height: 80vh;
    overflow-y: auto; /* Ajoute un défilement interne si nécessaire */
    text-align: left;
}

.modal-header {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header .close-btn {
    background: none;
    border: none;
    font-size: 20px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    outline: none;
    transition: color 0.3s ease;
}

.modal-header .close-btn:hover {
    color: #ff0000;
}

.modal-body {
    margin-bottom: 20px;
    font-size: 14px;
}

.modal-body p {
    margin: 10px 0;
    line-height: 1.6;
}

.modal-footer {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.modal-footer button {
    padding: 10px 20px;
    font-size: 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.modal-footer .download-btn {
    background-color: #013A71;
    color: white;
}

.modal-footer .download-btn:hover {
    background-color: rgb(24, 95, 162);
}

.modal-footer .cancel-btn {
    background-color: #7D8C6D;
    color: white;
}

.modal-footer .cancel-btn:hover {
    background-color: #5c7352;
}

body.no-scroll {
    overflow: hidden; /* Désactive le défilement global */
}

@media (max-width: 768px) {
    .modal-content {
        width: 90%;
        margin: 2% auto;
    }
}
</style>

<div class="example-wrapper">
    <h1>Liste des dons</h1>

    <div class="header">
        <div class="search-box">
            <input type="text" id="search" placeholder="Rechercher ...">
        </div>

        <select id="statusFilter">
            <option value="">Tous les statuts</option>
            <option value="En attente">En attente</option>
            <option value="Accepté">Accepté</option>
            <option value="Refusé">Refusé</option>
        </select>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nom du client</th>
                <th>Nom du partenaire</th>
                <th>Montant</th>
                <th>Date de don</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
<tbody id="userTable">
    {% for don in dons %}
    <tr>
        <td>{{ don.idDon }}</td>
        <td>{{ don.nomClient }} {{ don.prenomClient }}</td>
        <td>{{ don.nomPartenaire }} {{ don.prenomPartenaire }}</td>
        <td>{{ don.montant }}</td>
        <td>{{ don.dateDon ? don.dateDon|date('Y-m-d H:i:s') : 'N/A' }}</td>
        <td>{{ don.status }}</td>
        <td class="actions">
<!-- Updated button with data-* attributes -->
<button 
    class="consulter-btn" 
    data-id="{{ don.idDon }}"
    data-client-nom="{{ don.nomClient }}"
    data-client-prenom="{{ don.prenomClient }}"
    data-partenaire-nom="{{ don.nomPartenaire }}"
    data-partenaire-prenom="{{ don.prenomPartenaire }}"
    data-montant="{{ don.montant }}"
    data-date-don="{{ don.dateDon ? don.dateDon|date('Y-m-d H:i:s') : 'N/A' }}"
    data-status="{{ don.status }}"
    onclick="viewDetails(this)"
>
    Consulter
</button>        </td>
    </tr>
    {% endfor %}
</tbody>
    </table>
</div>

<div id="detailsModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span>Détail du don</span>
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body" id="modalBody">
            <!-- Les détails seront chargés dynamiquement ici -->
        </div>
        <div class="modal-footer">
            <button class="cancel-btn" onclick="closeModal()">Fermer</button>
        </div>
    </div>
</div>

<script>
function viewDetails(button) {
    const modalBody = document.getElementById('modalBody');

    // Extract data from the button's dataset
    const id = button.dataset.id;
    const clientNom = button.dataset.clientNom;
    const clientPrenom = button.dataset.clientPrenom;
    const partenaireNom = button.dataset.partenaireNom;
    const partenairePrenom = button.dataset.partenairePrenom;
    const montant = button.dataset.montant;
    const dateDon = button.dataset.dateDon;
    const status = button.dataset.status;

    // Populate the modal with the data
    modalBody.innerHTML = `
        <p><strong>ID Don :</strong> ${id}</p>
        <p><strong>Nom du client :</strong> ${clientNom} ${clientPrenom}</p>
        <p><strong>Nom du partenaire :</strong> ${partenaireNom} ${partenairePrenom}</p>
        <p><strong>Montant :</strong> ${montant} DT</p>
        <p><strong>Date de don :</strong> ${dateDon}</p>
        <p><strong>Status :</strong> ${status}</p>
    `;

    // Show the modal
    document.body.style.overflow = 'hidden'; // Disable scrolling
    document.getElementById('detailsModal').style.display = 'block';
}

    function closeModal() {
        document.body.style.overflow = ''; // Réactiver le défilement
        document.getElementById('detailsModal').style.display = 'none';
    }


    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

  function filterTable() {
    const searchFilter = document.getElementById('search').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value.toLowerCase(); // Convertir en minuscules pour la comparaison
    const rows = document.querySelectorAll('#userTable tr');

    rows.forEach(row => {
        const cells = row.querySelectorAll('td');
        const textMatch = Array.from(cells).slice(0, 6) // Parcourir uniquement les colonnes pertinentes
            .some(cell => cell.textContent.toLowerCase().includes(searchFilter));

        const status = cells[5].textContent.trim().toLowerCase(); // Statut dans la 6e colonne (0-indexé)
        const statusMatch = statusFilter === "" || status === statusFilter;

        // Afficher la ligne si elle correspond au filtre texte et au filtre statut
        row.style.display = (textMatch && statusMatch) ? '' : 'none';
    });
}
</script>
{% endblock %}
