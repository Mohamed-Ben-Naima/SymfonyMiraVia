{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/security/register.css') }}">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
{% endblock %}

{% block title %}Inscription | MiraVia
{% endblock %}

{% block body %}
	<div class="registration-container">
		<div class="registration-card">
			<div class="registration-header text-center mb-5">
				<img src="{{ asset('images/logo.png') }}" alt="MiraVia Logo" class="registration-logo mb-3" width="120">
				<h1 class="registration-title">Créer votre compte</h1>
				<p class="registration-subtitle">Rejoignez notre communauté dès aujourd'hui</p>
			</div>

			{{ form_start(registrationForm, {'attr': {'class': 'registration-form needs-validation', 'novalidate': 'novalidate'}}) }}
			<div class="mb-4">
				{{ form_label(registrationForm.prenom) }}
				{{ form_widget(registrationForm.prenom, {'attr': {'class': form_errors(registrationForm.prenom) ? 'form-control is-invalid' : 'form-control'}}) }}
				<div class="invalid-feedback">
					{{ form_errors(registrationForm.prenom) }}
				</div>
			</div>

			<div class="mb-4">
				{{ form_label(registrationForm.nom) }}
				{{ form_widget(registrationForm.nom, {'attr': {'class': form_errors(registrationForm.nom) ? 'form-control is-invalid' : 'form-control'}}) }}
				<div class="invalid-feedback">
					{{ form_errors(registrationForm.nom) }}
				</div>
			</div>

			<div class="mb-4">
				{{ form_label(registrationForm.email) }}
				<div class="input-group">
					<span class="input-group-text">
						<i class="bi bi-envelope"></i>
					</span>
                    {# TODO: fix the email feedback #}
					{{ form_widget(registrationForm.email, {'attr': {'class': form_errors(registrationForm.email) ? 'form-control is-invalid' : 'form-control'}}) }}
				</div>
				<div class="invalid-feedback">
					{{ form_errors(registrationForm.email) }}
				</div>
			</div>

			<div class="mb-4">
				{{ form_label(registrationForm.plainPassword) }}
				<div class="input-group">
                    {# TODO: fix the password feedback #}
				</div>
					{{ form_widget(registrationForm.plainPassword, {'attr': {'class': form_errors(registrationForm.plainPassword) ? 'form-control password-input is-invalid' : 'form-control password-input'}}) }}
				<div class="password-requirements mt-2">
					<small class="text-muted">
						<i class="bi bi-info-circle"></i>
						Le mot de passe doit contenir:
						<ul class="list-unstyled ms-3 mt-1">
							<li class="req-upper">
								<i class="bi bi-x-circle-fill text-danger"></i>
								1 majuscule</li>
							<li class="req-lower">
								<i class="bi bi-x-circle-fill text-danger"></i>
								1 minuscule</li>
							<li class="req-number">
								<i class="bi bi-x-circle-fill text-danger"></i>
								1 chiffre</li>
							<li class="req-special">
								<i class="bi bi-x-circle-fill text-danger"></i>
								1 caractère spécial</li>
							<li class="req-length">
								<i class="bi bi-x-circle-fill text-danger"></i>
								8 caractères minimum</li>
						</ul>
					</small>
				</div>
				<div class="invalid-feedback">
					{{ form_errors(registrationForm.plainPassword) }}
				</div>
			</div>

			<div class="mb-4 form-check">
				{{ form_widget(registrationForm.agreeTerms, {'attr': {'class': form_errors(registrationForm.agreeTerms) ? 'form-check-input is-invalid' : 'form-check-input'}}) }}
				{{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}}) }}
				<div class="invalid-feedback">
					{{ form_errors(registrationForm.agreeTerms) }}
				</div>
			</div>

			<button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
				<i class="bi bi-person-plus me-2"></i>
				S'inscrire
			</button>

			<div class="text-center mt-4">
				<p class="text-muted">Vous avez déjà un compte?
					<a href="{{ path('app_login') }}" class="text-link fw-bold">Connectez-vous</a>
				</p>
				<div class="separator my-4">ou</div>
				<button type="button" class="btn btn-outline-primary btn-sm me-2">
					<i class="bi bi-google"></i>
					Google
				</button>
				<button type="button" class="btn btn-outline-primary btn-sm">
					<i class="bi bi-facebook"></i>
					Facebook
				</button>
			</div>
			{{ form_end(registrationForm) }}
		</div>
	</div>

	<!-- Terms Modal -->
	<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="termsModalLabel">Conditions d'utilisation</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div
					class="modal-body">{# {% include 'security/_terms_content.html.twig' %} #}
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/security/register.js') }}"></script>
{% endblock %}
